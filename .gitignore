# ==============================================================================
# NEAL'S ULTIMATE GITIGNORE (Parrot OS + Astro + AI Agents + Security)
# ==============================================================================

# --- [ SYSTEM & OS ] ---
.DS_Store
Thumbs.db
*.log
*.tmp
# Parrot/Debian/Linux artifacts
.swp
*~
.nfs*
.fuse_hidden*
.directory
.Trash-*

# --- [ VIRTUAL ENVIRONMENTS ] ---
# Crucial for venv, virtualenv, and pipenv
.venv/
venv/
ENV/
env/
python-local/
.python-version
# Poetry & Pipenv lock files (optional: keep if you want strict parity)
# pnpm-debug.log*

# --- [ PYTHON & AI ARTIFACTS ] ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
# NULL Framework / Agent outputs
agents_data/
recordings/
traces/

# --- [ AI MODELS & WEIGHTS ] ---
# Never push local LLM weights (Ollama/Hermes/GGML)
models/
weights/
.ollama/
*.gguf
*.bin
*.onnx
*.pt
*.pth
*.ckpt

# --- [ DEPENDENCIES & RUNTIMES ] ---
node_modules/
.pnpm-store/
# Specifically excluding Next.js just in case a dependency pulls it
.next/
out/

# --- [ ASTRO & VITE ] ---
dist/
.astro/
# Vite cache
.vite/

# --- [ ENV & SECRETS (STRICT) ] ---
# Cybersecurity Priority: Leak prevention
.env
.env.*
!.env.example
.vault
# Private keys, certificates, and Web3 secrets
*.pem
*.key
*.pub
.secret
secrets.json
*.p12
*.pfx
authorized_keys

# --- [ LOCAL DEV TOOLS & AGENTS ] ---
# Zoth Dashboard logs
.zoth/
logs/
*.agent.log
# Agent-specific traces
.hermes/
.openclaw/
.aider*
.fabric/
.continue/

# --- [ IDE & EDITORS ] ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.project
.settings/
*.sublime-project
*.sublime-workspace

# --- [ CLOUD & DEPLOYMENT ] ---
# Netlify specific
.netlify/
# Infrastructure as Code
.terraform/
*.tfstate
*.tfstate.backup
.serverless/

{
  "layout": "apex",
  "target_domain": "nullai.tech",
  "target_path": "public_html",
  "rsync": {
    "source": "public/",
    "destination": "USER@HOSTINGER_HOST:public_html/",
    "flags": "-avz --delete",
    "excludes": [
      ".git",
      ".gitignore",
      ".DS_Store",
      "Thumbs.db",
      "*.tmp",
      "*.swp",
      "*.swo",
      "node_modules",
      "tools",
      "runtime",
      "vault-daemon",
      "agent-comms",
      "byok.json",
      "conversations.json",
      "*.env",
      "*.token",
      "*.secret",
      "*.pem",
      "*.key",
      "assets/*.py",
      "assets/models/dataset/*"
    ]
  },
  "hostinger": {
    "document_root": "/home/username/domains/nullai.tech/public_html",
    "php": false,
    "ssl": "lets_encrypt",
    "expected_user": "username",
    "expected_group": "username"
  },
  "post_sync": [
    "chmod 755 public_html",
    "find public_html -type d -exec chmod 755 {} +",
    "find public_html -type f -exec chmod 644 {} +"
  ],
  "audit_findings": {
    "p0_excluded_paths": [
      "assets/*.py",
      "assets/models/dataset/*"
    ],
    "p1_requires_code_fix_before_deploy": true,
    "p1_summary": "12 public fetch/probe calls and JSON-LD links still point to 127.0.0.1:8484/8787/8765; see agent-comms/handoffs/hermes-sensitive-tree-audit.md for exact files/lines."
  }
}

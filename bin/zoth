CORE_APP_DIR = BASE_DIR
PUBLIC_DIR = CORE_APP_DIR / "public"
ORCHESTRATOR_PY = CORE_APP_DIR / "tools" / "null ai agent tools" / "local_null_ai_orchestrator" / "orchestrator.py"


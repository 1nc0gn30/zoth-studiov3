def get_pet_sprite_frame(pet_id: str, tick: int) -> list[str]:
    """Retrieve the current animation frame for a spirit sprite."""
    frames = ANIMATED_PET_SPRITES.get(pet_id.lower())
    if not frames:
        return [
            r"    /\___/\    ",
            r"   (  o.o  )   ",
            r"    >  ^  <    ",
            f"   [{pet_id.upper()[:8]}]   "
        ]
    idx = (tick // 2) % len(frames)
    return frames[idx]


try:
    import psutil
    HAS_PSUTIL = True
except ImportError:
    HAS_PSUTIL = False

REGISTRY_CACHE_PATH = ORCHESTRATOR_PY.parent / "registry.local.json"

def get_system_telemetry() -> tuple[float, float, str, str]:
    """Return (cpu_percent, ram_percent, ram_used_str, ram_total_str)."""
    if HAS_PSUTIL:
        try:
            cpu = psutil.cpu_percent(interval=None)
            mem = psutil.virtual_memory()
            used_gb = mem.used / (1024 ** 3)
            total_gb = mem.total / (1024 ** 3)
            return cpu, mem.percent, f"{used_gb:.1f}G", f"{total_gb:.1f}G"
        except Exception:
            pass

    # Fallback to /proc if psutil is unavailable or errors
    cpu = 0.0
    ram_pct = 0.0
    used_str = "?"
    total_str = "?"
    try:
        if Path("/proc/meminfo").exists():
            meminfo = {}
            for line in Path("/proc/meminfo").read_text().splitlines():
                parts = line.split(":")
                if len(parts) == 2:
                    meminfo[parts[0].strip()] = parts[1].strip()
            total_kb = float(meminfo.get("MemTotal", "0 kB").split()[0])
            avail_kb = float(meminfo.get("MemAvailable", "0 kB").split()[0])
            if total_kb > 0:
                used_kb = total_kb - avail_kb
                ram_pct = (used_kb / total_kb) * 100.0
                used_str = f"{used_kb / (1024*1024):.1f}G"
                total_str = f"{total_kb / (1024*1024):.1f}G"
        if Path("/proc/loadavg").exists():
            load1 = float(Path("/proc/loadavg").read_text().split()[0])
            cpu_count = os.cpu_count() or 1
            cpu = min(100.0, (load1 / cpu_count) * 100.0)
    except Exception:
        pass
    return cpu, ram_pct, used_str, total_str

def make_meter_bar(pct: float, width: int = 10) -> str:
    """Render a colored/proportional ASCII bar like [████░░░░░░]."""
    pct = max(0.0, min(100.0, pct))
    filled = int(round((pct / 100.0) * width))
    bar = "█" * filled + "░" * (width - filled)
def load_all_tools(filter_studio_tools_only: bool = True) -> list[dict[str, Any]]:
    """Load tools from local registry cache, prioritizing genuine Zoth Studio tools & utilities."""
    if REGISTRY_CACHE_PATH.exists():
        try:
            data = json.loads(REGISTRY_CACHE_PATH.read_text(encoding="utf-8"))
            all_entries = data.get("tools", [])
            if all_entries:
                if not filter_studio_tools_only:
                    return all_entries
                
                # Filter specifically for sovereign studio utility tools & engines
                STUDIO_TOOL_CATS = {
                    "Security Operations & OSINT", "Python Tools", "Automation & Tools",
                    "AI Agents & LLM", "Crypto & Web3", "Rust Projects", "DevOps & Automation"
                }
                
                studio_tools = []
                for t in all_entries:
                    cat = t.get("category", "")
                    t_id = t.get("id", "").lower()
                    t_name = t.get("name", "").lower()
                    if (cat in STUDIO_TOOL_CATS or 
                        t_id.startswith("local_null_ai_") or 
                        any(kw in t_name for kw in ["tool", "scanner", "recon", "generator", "orchestrator", "converter", "cipher", "fuzzer", "validator", "vault", "bridge", "omnipost", "subsweep"])):
                        studio_tools.append(t)
                
                if studio_tools:
                    return studio_tools
                return all_entries
        except Exception:
            pass
    # Fallback default tools if registry not yet generated
    return [
        {"id": "local_null_ai_omnipost", "name": "OmniPost 2.0", "description": "Social Repurposer & Multi-Platform Distribution", "category": "Social Automation", "runtimes": ["python", "node"], "entrypoints": ["app.py", "cli.py"]},
        {"id": "local_null_ai_subsweep", "name": "SubSweep", "description": "OSINT & Surface Vulnerability Recon", "category": "Security Operations", "runtimes": ["python"], "entrypoints": ["subsweep.py"]},
        {"id": "local_null_ai_site_foundry", "name": "Site Foundry", "description": "Rapid Multi-Framework Website Generator", "category": "Website Generation", "runtimes": ["node", "astro"], "entrypoints": ["index.html"]},
        {"id": "local_null_ai_nexus3d", "name": "Nexus 3D", "description": "Volumetric CAD & Shaders Studio", "category": "Design Intelligence", "runtimes": ["node", "threejs"], "entrypoints": ["main.tsx"]},
        {"id": "local_null_ai_consensus_arena", "name": "Consensus Arena", "description": "3-Agent AST Quorum Synthesizer", "category": "AI Agents & LLM", "runtimes": ["python"], "entrypoints": ["arena.py"]},
        {"id": "local_null_ai_argon2id_vault", "name": "Argon2id Vault", "description": "Memory-Hard Cryptographic Isolation (:8484)", "category": "Security Operations", "runtimes": ["rust", "python"], "entrypoints": ["vault.rs"]},
        {"id": "local_null_ai_signal_bridge", "name": "Signal Bridge", "description": "Encrypted Swarm Mobile Dispatcher", "category": "Automation & Tools", "runtimes": ["node"], "entrypoints": ["server.ts"]},
    ]

# Theme definitions
THEMES = {
    "Cyber Gold": {
        "primary": curses.COLOR_YELLOW,
        "accent": curses.COLOR_CYAN,
        "success": curses.COLOR_GREEN,
        "warn": curses.COLOR_MAGENTA,
        "error": curses.COLOR_RED,
        "text": curses.COLOR_WHITE,
    },
    "Matrix Green": {
        "primary": curses.COLOR_GREEN,
        "accent": curses.COLOR_CYAN,
        "success": curses.COLOR_GREEN,
        "warn": curses.COLOR_YELLOW,
        "error": curses.COLOR_RED,
        "text": curses.COLOR_WHITE,
    },
    "Cyberpunk Neon": {
        "primary": curses.COLOR_MAGENTA,
        "accent": curses.COLOR_CYAN,
        "success": curses.COLOR_GREEN,
        "warn": curses.COLOR_YELLOW,
        "error": curses.COLOR_RED,
        "text": curses.COLOR_WHITE,
    },
    "Monochrome Stealth": {
        "primary": curses.COLOR_WHITE,
        "accent": curses.COLOR_WHITE,
        "success": curses.COLOR_WHITE,
        "warn": curses.COLOR_WHITE,
        "error": curses.COLOR_WHITE,
        "text": curses.COLOR_WHITE,
    }
}

def apply_theme(theme_name: str):
    palette = THEMES.get(theme_name, THEMES["Cyber Gold"])
    curses.init_pair(1, palette["accent"], -1)   # Accent / borders
    curses.init_pair(2, palette["primary"], -1)  # Primary / Headers / Highlights
    curses.init_pair(3, palette["success"], -1)  # Online / Success
    curses.init_pair(4, palette["warn"], -1)     # Warning / Swarm
    curses.init_pair(5, palette["error"], -1)    # Error / Offline
    curses.init_pair(6, palette["text"], -1)     # Body Text

def safe_addstr(win, y: int, x: int, text: str, attr: int = 0):
    """Safely write string to curses window without throwing out-of-bounds curses.error."""
    try:
        h, w = win.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            max_len = w - x - 1
            if max_len > 0:
                win.addstr(y, x, text[:max_len], attr)
    except curses.error:
        pass

def run_tui(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(800)

    # Init colors & terminal auto-detection
    has_color = curses.has_colors()
    if has_color:
        curses.start_color()
        curses.use_default_colors()

    theme_keys = list(THEMES.keys())
    # Auto-detect terminal support: default to Cyber Gold if >= 8 colors, else Monochrome
    current_theme_idx = 0 if (has_color and curses.COLORS >= 8) else 3
    if has_color:
        apply_theme(theme_keys[current_theme_idx])

    selected_menu = 0
    menu_items = [
        "Dashboard & Status",
        "🐾 Mascot Spirits & Pet Dex",
        "Sovereign Tools",
        "Website Templates",
        "Live Bus Events",
        "Restart Servers",
        "Toggle Theme",
        "Quit (q)"
    ]

    # Load tool and template catalogs
    tools_list = load_all_tools(filter_studio_tools_only=True)
    all_raw = load_all_tools(filter_studio_tools_only=False)
    templates_list = [t for t in all_raw if t not in tools_list]
    
    pet_cursor = 0
    pet_scroll_offset = 0
    pet_view_mode = "list" # "list" or "inspect"
    inspect_pet_data = None
    pet_status_msg = ""

    tool_cursor = 0
    tool_scroll_offset = 0
    template_cursor = 0
    template_scroll_offset = 0
    tool_filter = ""
    tool_view_mode = "list" # "list" or "inspect"
    inspect_tool_data = None
    runner_status_msg = ""
    focus_pane = "menu" # "menu" or "content"
    tick_counter = 0

    # Live telemetry initial read
    if HAS_PSUTIL:
        psutil.cpu_percent(interval=None)

    while True:
        try:
            stdscr.erase()
            h, w = stdscr.getmaxyx()

            if h < 12 or w < 50:
                safe_addstr(stdscr, 1, 2, "Window too small for Zoth TUI", curses.A_BOLD)
                safe_addstr(stdscr, 2, 2, f"Size: {w}x{h} (Min: 50x12)", curses.A_DIM)
                stdscr.refresh()
                time.sleep(0.2)
                ch = stdscr.getch()
                if ch in [ord('q'), ord('Q'), 27]:
                    break
                continue

            theme_name = theme_keys[current_theme_idx]

            # ── 1. Top Header & Telemetry Bar ──────────────────────────────
            title = " ⚡ ZOTH STUDIO SOVEREIGN TERMINAL COMMAND DECK (TUI v1.2) ⚡ "
            safe_addstr(stdscr, 0, max(0, (w - len(title)) // 2), title, curses.color_pair(2) | curses.A_BOLD)

            # Live CPU & RAM Telemetry Header
            cpu_pct, ram_pct, ram_used, ram_total = get_system_telemetry()
            cpu_bar = make_meter_bar(cpu_pct, width=8)
            ram_bar = make_meter_bar(ram_pct, width=8)
            telem_line = f" CPU: {cpu_bar}  │  RAM: {ram_bar} ({ram_used}/{ram_total})  │  Theme: [{theme_name}]"
            safe_addstr(stdscr, 1, max(0, (w - len(telem_line)) // 2), telem_line, curses.color_pair(1))

            # Horizontal divider below telemetry
            safe_addstr(stdscr, 2, 2, "─" * max(1, w - 4), curses.color_pair(1) | curses.A_DIM)

            # ── 2. Left Column: Navigation Menu ────────────────────────────
            safe_addstr(stdscr, 4, 3, "COMMANDS", curses.color_pair(6) | curses.A_BOLD)

            menu_focused = (focus_pane == "menu")
            safe_addstr(stdscr, 4, 3, "COMMANDS" if menu_focused else "COMMANDS [TAB]", (curses.color_pair(2) if menu_focused else curses.color_pair(6)) | curses.A_BOLD)

            for i, item in enumerate(menu_items):
                y_pos = 6 + (i * 2)
                if y_pos < h - 3:
                    if i == selected_menu:
                        if menu_focused:
                            safe_addstr(stdscr, y_pos, 3, f" ▶ {item} ", curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                        else:
                            safe_addstr(stdscr, y_pos, 3, f" ▷ {item} ", curses.color_pair(1) | curses.A_BOLD)
                    else:
                        safe_addstr(stdscr, y_pos, 3, f"   {item}", curses.color_pair(6) | (0 if menu_focused else curses.A_DIM))

            # Vertical Divider
            for y in range(3, h - 2):
                safe_addstr(stdscr, y, 26, "│", curses.color_pair(1) | curses.A_DIM)

            # ── 3. Right Column: Dynamic Content Pane ──────────────────────
            content_x = 29
            content_w = max(10, w - content_x - 2)

            if selected_menu == 0:
                # Dashboard & Status
                safe_addstr(stdscr, 4, content_x, "SYSTEM TELEMETRY & ACTIVE PORTS", curses.color_pair(1) | curses.A_BOLD)

                statuses = get_server_status()
                y_offset = 6
                for s_key, info in statuses.items():
                    if y_offset >= h - 7:
                        break
                    is_up = info["up"]
                    status_color = curses.color_pair(3) if is_up else curses.color_pair(5)
                    status_str = " [ONLINE] " if is_up else " [OFFLINE]"
                    
                    safe_addstr(stdscr, y_offset, content_x, status_str, status_color | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset, content_x + 12, f"{info['name']} (Port {info['port']})", curses.color_pair(6) | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset + 1, content_x + 12, f"URL: {info['url']}", curses.color_pair(6) | curses.A_DIM)
                    y_offset += 3

                if y_offset < h - 4:
                    active_spirit = get_active_spirit()
                    mem_bound, mem_str = get_vector_memory_status()
                    safe_addstr(stdscr, y_offset, content_x, "─" * content_w, curses.color_pair(1) | curses.A_DIM)
                    safe_addstr(stdscr, y_offset + 1, content_x, f"Active Companion: {active_spirit['emoji']} {active_spirit['name']} ({active_spirit['archetype']})", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset + 2, content_x, f"Vector Memory Engine: {mem_str} · {len(SOVEREIGN_SPIRITS)} Figurine Spirits Ready", curses.color_pair(4) | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset + 3, content_x, "Local Loopback Latency: < 0.45ms | Cloud Egress: 0 B/s (Zero-Leakage)", curses.color_pair(6) | curses.A_DIM)
                    
                    # Render live animated ASCII sprite on Dashboard
                    sprite_lines = get_pet_sprite_frame(active_spirit['id'], tick_counter)
                    sprite_x = max(content_x, content_x + content_w - 20)
                    for s_i, s_line in enumerate(sprite_lines):
                        if 4 + s_i < h - 2:
                            safe_addstr(stdscr, 4 + s_i, sprite_x, s_line, curses.color_pair(2) | curses.A_BOLD)

            elif selected_menu == 1:
                # 🐾 Mascot Spirits & Pet Dex
                mem_bound, mem_str = get_vector_memory_status()
                active_id = get_active_pet_id()

                if pet_view_mode == "inspect" and inspect_pet_data:
                    p = inspect_pet_data
                    p_name = p.get("name", "?")
                    p_emoji = p.get("emoji", "🐾")
                    p_archetype = p.get("archetype", "")
                    p_elem = p.get("element", "")
                    p_aspect = p.get("aspect", "")
                    p_domain = p.get("domain", "")
                    p_res = p.get("resonance", "")
                    p_harness = p.get("harness", "")
                    p_lore = p.get("lore", "")
                    p_quote = p.get("quote", "")
                    is_active = (p["id"] == active_id)

                    safe_addstr(stdscr, 4, content_x, f"🐾 SOUL & LORE SANCTUARY: {p_emoji} {p_name.upper()} ({p_archetype[:content_w-35]})", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, "─" * content_w, curses.color_pair(1) | curses.A_DIM)

                    y_row = 6
                    active_badge = "★ [ACTIVE COMPANION]" if is_active else "○ [AVAILABLE SPIRIT]"
                    badge_color = curses.color_pair(3) if is_active else curses.color_pair(6)
                    safe_addstr(stdscr, y_row, content_x, f"Spirit Status:  {active_badge}", badge_color | curses.A_BOLD)
                    safe_addstr(stdscr, y_row + 1, content_x, f"Archetype:      {p_archetype}", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, y_row + 2, content_x, f"Element:        {p_elem}", curses.color_pair(1))
                    safe_addstr(stdscr, y_row + 3, content_x, f"Aspect:         {p_aspect}", curses.color_pair(6))
                    safe_addstr(stdscr, y_row + 4, content_x, f"Domain:         {p_domain}  (Resonance: {p_res})", curses.color_pair(4))
                    safe_addstr(stdscr, y_row + 5, content_x, f"Agent Harness:  {p_harness}", curses.color_pair(6) | curses.A_DIM)
                    
                    mem_badge = f"{GREEN}{mem_str}{RESET}" if mem_bound else f"{RED}{mem_str}{RESET}"
                    safe_addstr(stdscr, y_row + 6, content_x, f"Vector Memory:  {mem_str} (:8788)", curses.color_pair(3) if mem_bound else curses.color_pair(5))

                    y_row += 8
                    safe_addstr(stdscr, y_row, content_x, "Soul Lore & Mission:", curses.color_pair(2) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x + 2, f"\"{p_lore[:content_w-6]}\"", curses.color_pair(6))
                    
                    y_row += 2
                    safe_addstr(stdscr, y_row, content_x, "Invocational Spoken Dialogue:", curses.color_pair(4) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row + 0, content_x + 2, f"⚡ \"{p_quote[:content_w-6]}\"", curses.color_pair(1) | curses.A_BOLD)

                    # Render live physical animated character sprite
                    p_sprite = get_pet_sprite_frame(p['id'], tick_counter)
                    sprite_x = max(content_x, content_x + content_w - 22)
                    for s_i, s_line in enumerate(p_sprite):
                        if 6 + s_i < h - 4:
                            safe_addstr(stdscr, 6 + s_i, sprite_x, s_line, curses.color_pair(2) | curses.A_BOLD)

                    y_row += 3
                    safe_addstr(stdscr, y_row, content_x, "ACTIONS / QUICK BINDINGS:", curses.color_pair(2) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, " [s] Summon & Set Active Companion   |  [ESC/b] Return to Pet Dex List", curses.color_pair(1) | curses.A_BOLD)

                    if pet_status_msg and y_row + 2 < h - 2:
                        safe_addstr(stdscr, y_row + 2, content_x, f"Status: {pet_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)

                else:
                    # Pet Dex List Mode
                    safe_addstr(stdscr, 4, content_x, f"🐾 24 SOVEREIGN FIGURINE SPIRITS · PET DEX ({len(SOVEREIGN_SPIRITS)} total)", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, " [▲/▼] Scroll  |  [s] Summon Active Companion  |  [ENTER/i] Inspect Soul & Lore", curses.color_pair(6) | curses.A_DIM)

                    visible_rows = max(1, h - 9)
                    if pet_cursor < pet_scroll_offset:
                        pet_scroll_offset = pet_cursor
                    elif pet_cursor >= pet_scroll_offset + visible_rows:
                        pet_scroll_offset = pet_cursor - visible_rows + 1

                    for idx in range(visible_rows):
                        s_idx = pet_scroll_offset + idx
                        if s_idx >= len(SOVEREIGN_SPIRITS):
                            break
                        spirit = SOVEREIGN_SPIRITS[s_idx]
                        s_name = spirit.get("name", "?")
                        s_emoji = spirit.get("emoji", "🐾")
                        s_arch = spirit.get("archetype", "")
                        s_elem = spirit.get("element", "")
                        s_domain = spirit.get("domain", "")
                        is_active = (spirit["id"] == active_id)
                        is_cur = (s_idx == pet_cursor)
                        y_pos = 7 + idx

                        prefix = " ▶" if is_cur else "  "
                        active_tag = " ★ [ACTIVE]" if is_active else ""
                        mem_tag = "[MEM:8788]" if mem_bound else "[MEM:OFF]"

                        line_name = f"{prefix} {s_emoji} {s_name:12s}{active_tag:11s}"
                        line_meta = f"[{s_domain:10s}] {s_arch[:28]:28s} │ {s_elem[:20]:20s} │ {mem_tag}"

                        if is_cur:
                            safe_addstr(stdscr, y_pos, content_x, line_name, curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                            safe_addstr(stdscr, y_pos, content_x + len(line_name) + 1, line_meta[:content_w - len(line_name) - 2], curses.color_pair(6) | curses.A_BOLD)
                        else:
                            name_color = curses.color_pair(2) if is_active else curses.color_pair(6)
                            safe_addstr(stdscr, y_pos, content_x, line_name, name_color | (curses.A_BOLD if is_active else 0))
                            safe_addstr(stdscr, y_pos, content_x + len(line_name) + 1, line_meta[:content_w - len(line_name) - 2], curses.color_pair(6) | curses.A_DIM)

                    if pet_status_msg:
                        safe_addstr(stdscr, h - 3, content_x, f"Status: {pet_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)

            elif selected_menu == 2:
                # Registered Tools / Tool Runner Mode
                if tool_view_mode == "inspect" and inspect_tool_data:
                    # Tool Details / Runner Mode
                    t = inspect_tool_data
                    tid = t.get("id", "?")
                    tname = t.get("name", tid)
                    tcat = t.get("category", "General")
                    tdesc = t.get("description", "No description provided.")
                    truns = ", ".join(t.get("runtimes", [])) or "universal"
                    tpath = t.get("path", t.get("relative_path", "?"))
                    tentry = ", ".join(t.get("entrypoints", [])) or "none"
                    tscripts = t.get("package_scripts", {})

                    safe_addstr(stdscr, 4, content_x, f"⚡ TOOL INSPECTION & RUNNER: {tname[:content_w-30]}", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, "─" * content_w, curses.color_pair(1) | curses.A_DIM)

                    y_row = 6
                    safe_addstr(stdscr, y_row, content_x, f"ID:          {tid}", curses.color_pair(6) | curses.A_BOLD)
                    safe_addstr(stdscr, y_row + 1, content_x, f"Category:    {tcat}", curses.color_pair(1))
                    safe_addstr(stdscr, y_row + 2, content_x, f"Runtimes:    {truns}", curses.color_pair(3))
                    safe_addstr(stdscr, y_row + 3, content_x, f"Path:        {tpath[:content_w-15]}", curses.color_pair(6) | curses.A_DIM)
                    safe_addstr(stdscr, y_row + 4, content_x, f"Entrypoints: {tentry[:content_w-15]}", curses.color_pair(6))
                    safe_addstr(stdscr, y_row + 5, content_x, f"Description: {tdesc[:content_w-15]}", curses.color_pair(6))

                    y_row += 7
                    safe_addstr(stdscr, y_row, content_x, "ACTIONS / QUICK RUNNERS:", curses.color_pair(2) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, " [d] Run Tool Diagnostics (Doctor)   |  [r] Run Default Entrypoint", curses.color_pair(1) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, " [s] Show CLI Info                  |  [ESC/b] Back to Tool List", curses.color_pair(6))

                    if tscripts and y_row + 2 < h - 4:
                        y_row += 2
                        safe_addstr(stdscr, y_row, content_x, "Package Scripts:", curses.color_pair(2))
                        for s_name, s_cmd in list(tscripts.items())[:3]:
                            y_row += 1
                            if y_row < h - 3:
                                safe_addstr(stdscr, y_row, content_x + 2, f"• {s_name}: {s_cmd[:content_w-15]}", curses.color_pair(6) | curses.A_DIM)

                    if runner_status_msg and y_row + 2 < h - 2:
                        safe_addstr(stdscr, y_row + 2, content_x, f"Status: {runner_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)

                else:
                    # Tool List Mode with Interactive Scroll & Selector
                    safe_addstr(stdscr, 4, content_x, f"REGISTERED SOVEREIGN TOOLS ({len(tools_list)} total)", curses.color_pair(1) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, " [▲/▼] Scroll Tool  |  [ENTER/i] Inspect / Run Tool  |  [d] Run Doctor", curses.color_pair(6) | curses.A_DIM)

                    visible_rows = max(1, h - 9)
                    if tool_cursor < tool_scroll_offset:
                        tool_scroll_offset = tool_cursor
                    elif tool_cursor >= tool_scroll_offset + visible_rows:
                        tool_scroll_offset = tool_cursor - visible_rows + 1

                    for idx in range(visible_rows):
                        t_idx = tool_scroll_offset + idx
                        if t_idx >= len(tools_list):
                            break
                        tool = tools_list[t_idx]
                        t_name = tool.get("name", tool.get("id", "?"))
                        t_cat = tool.get("category", "General")
                        t_desc = tool.get("description", "")
                        y_pos = 7 + idx

                        is_cur = (t_idx == tool_cursor)
                        if is_cur:
                            safe_addstr(stdscr, y_pos, content_x, f" ▶ ⚡ {t_name:22s}", curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                            cat_badge = f"[{t_cat[:16]}]"
                            safe_addstr(stdscr, y_pos, content_x + 28, f"{cat_badge:18s} {t_desc[:content_w-50]}", curses.color_pair(6) | curses.A_BOLD)
                        else:
                            safe_addstr(stdscr, y_pos, content_x, f"   ⚡ {t_name:22s}", curses.color_pair(2))
                            cat_badge = f"[{t_cat[:16]}]"
                            safe_addstr(stdscr, y_pos, content_x + 28, f"{cat_badge:18s} {t_desc[:content_w-50]}", curses.color_pair(6) | curses.A_DIM)

                    if runner_status_msg:
                        safe_addstr(stdscr, h - 3, content_x, f"Status: {runner_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)

            elif selected_menu == 3:
                # Website Templates (In-House Apps & Blueprints)
                if tool_view_mode == "inspect" and inspect_tool_data:
                    # Template details view
                    t = inspect_tool_data
                    tname = t.get("name", t.get("id", "?"))
                    tcat = t.get("category", "General")
                    tdesc = t.get("description", "In-house website application template.")
                    truns = ", ".join(t.get("runtimes", [])) or "web, vite, react"
                    tpath = t.get("path", t.get("relative_path", "?"))
                    tentry = ", ".join(t.get("entrypoints", [])) or "index.html"

                    safe_addstr(stdscr, 4, content_x, f"🎨 TEMPLATE BLUEPRINT: {tname[:content_w-30]}", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, "─" * content_w, curses.color_pair(1) | curses.A_DIM)

                    y_row = 6
                    safe_addstr(stdscr, y_row, content_x, f"Template ID:    {t.get('id')}", curses.color_pair(6) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, f"Category:       {tcat}", curses.color_pair(4))
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, f"Tech Stack:     {truns}", curses.color_pair(1))
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, f"Filesystem:     {tpath}", curses.color_pair(6) | curses.A_DIM)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, f"Entrypoints:    {tentry}", curses.color_pair(6))
                    y_row += 2
                    safe_addstr(stdscr, y_row, content_x, "Description:", curses.color_pair(2) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, f"  {tdesc[:content_w-4]}", curses.color_pair(6))
                    y_row += 2
                    safe_addstr(stdscr, y_row, content_x, " [o] Open in Web Generator Foundry  |  [p] Open Preview in Browser", curses.color_pair(1) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, " [ESC/b] Back to Templates List", curses.color_pair(6))

                    if runner_status_msg and y_row + 2 < h - 2:
                        safe_addstr(stdscr, y_row + 2, content_x, f"Status: {runner_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)
                else:
                    # Template List View
                    safe_addstr(stdscr, 4, content_x, f"IN-HOUSE WEBSITE TEMPLATES & BLUEPRINTS ({len(templates_list)} total)", curses.color_pair(1) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, " [▲/▼] Scroll Template  |  [ENTER/i] Inspect Blueprint  |  [o] Foundry Rebrand", curses.color_pair(6) | curses.A_DIM)

                    visible_rows = max(1, h - 9)
                    if template_cursor < template_scroll_offset:
                        template_scroll_offset = template_cursor
                    elif template_cursor >= template_scroll_offset + visible_rows:
                        template_scroll_offset = template_cursor - visible_rows + 1

                    for idx in range(visible_rows):
                        t_idx = template_scroll_offset + idx
                        if t_idx >= len(templates_list):
                            break
                        tpl = templates_list[t_idx]
                        t_name = tpl.get("name", tpl.get("id", "?"))
                        t_cat = tpl.get("category", "Templates")
                        t_desc = tpl.get("description", "")
                        y_pos = 7 + idx

                        is_cur = (t_idx == template_cursor)
                        if is_cur:
                            safe_addstr(stdscr, y_pos, content_x, f" ▶ 🎨 {t_name:22s}", curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                            cat_badge = f"[{t_cat[:16]}]"
                            safe_addstr(stdscr, y_pos, content_x + 28, f"{cat_badge:18s} {t_desc[:content_w-50]}", curses.color_pair(6) | curses.A_BOLD)
                        else:
                            safe_addstr(stdscr, y_pos, content_x, f"   🎨 {t_name:22s}", curses.color_pair(2))
                            cat_badge = f"[{t_cat[:16]}]"
                            safe_addstr(stdscr, y_pos, content_x + 28, f"{cat_badge:18s} {t_desc[:content_w-50]}", curses.color_pair(6) | curses.A_DIM)

                    if runner_status_msg:
                        safe_addstr(stdscr, h - 3, content_x, f"Status: {runner_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)

            elif selected_menu == 4:
                # Live Bus Events
                safe_addstr(stdscr, 4, content_x, "LIVE SWARM BUS STREAM (IPC / LOCALHOST:8484)", curses.color_pair(1) | curses.A_BOLD)

                sample_logs = [
                    ("[00:00:01]", "AST Validation Node", "Shannon entropy passed for /index.html"),
                    ("[00:00:02]", "Master Azoth", "Operator instruction broadcasted to 24 figurine spirits"),
                    ("[00:00:03]", "OmniPost Engine", "Sentence-aware thread chunks serialized for Telegram"),
                    ("[00:00:04]", "SubSweep Recon", "Scanned news.zoth.nullai.tech (100% verified)"),
                    ("[00:00:05]", "Security Auditor", "Argon2id container health check: PASSED"),
                    ("[00:00:06]", "Nexus 3D Engine", "GLSL shaders compiled for volumetric preview (:8787)"),
                    ("[00:00:07]", "Vector Memory Node", "Port 8788 persistent embeddings indexed"),
                ]
                for idx, (t_time, t_src, t_msg) in enumerate(sample_logs):
                    y_pos = 6 + (idx * 2)
                    if y_pos + 1 < h - 3:
                        safe_addstr(stdscr, y_pos, content_x, f"{t_time}", curses.color_pair(2))
                        safe_addstr(stdscr, y_pos, content_x + 12, f"[{t_src}]", curses.color_pair(4) | curses.A_BOLD)
                        safe_addstr(stdscr, y_pos + 1, content_x + 14, f"↳ {t_msg}", curses.color_pair(6) | curses.A_DIM)

            elif selected_menu == 5:
                # Restart Servers
                safe_addstr(stdscr, 4, content_x, "SERVER CLUSTER RESTART CONTROL", curses.color_pair(1) | curses.A_BOLD)
                safe_addstr(stdscr, 6, content_x, "Press [ENTER] or [SPACE] to execute server restart cycle.", curses.color_pair(2) | curses.A_BOLD)
                safe_addstr(stdscr, 8, content_x, "This will cleanly terminate existing instances and reload :8484, :8088, :8787, and :8788.", curses.color_pair(6) | curses.A_DIM)
                if runner_status_msg:
                    safe_addstr(stdscr, 10, content_x, runner_status_msg, curses.color_pair(3) | curses.A_BOLD)

            elif selected_menu == 6:
                # Toggle Theme
                safe_addstr(stdscr, 4, content_x, "COLOR THEME & DISPLAY PREFERENCES", curses.color_pair(1) | curses.A_BOLD)
                safe_addstr(stdscr, 6, content_x, f"Active Theme: {theme_name}", curses.color_pair(2) | curses.A_BOLD)
                safe_addstr(stdscr, 8, content_x, "Press [ENTER] or [t] to cycle through visual themes:", curses.color_pair(6))
                for i_t, t_name in enumerate(theme_keys):
                    bullet = " ● " if i_t == current_theme_idx else " ○ "
                    attr = (curses.color_pair(2) | curses.A_BOLD) if i_t == current_theme_idx else curses.color_pair(6)
                    safe_addstr(stdscr, 10 + i_t, content_x + 2, f"{bullet} {t_name}", attr)

            elif selected_menu == 7:
                break

            # ── 4. Footer ──────────────────────────────────────────────────
            footer_text = " [▲/▼] Navigate  |  [ENTER] Select/Inspect  |  [s] Summon Pet  |  [t] Theme  |  [q] Exit TUI "
            safe_addstr(stdscr, h - 1, max(0, (w - len(footer_text)) // 2), footer_text, curses.color_pair(1) | curses.A_REVERSE)

            stdscr.refresh()

            # ── 5. Input Handling & Resize Resiliency ──────────────────────
            tick_counter += 1
            ch = stdscr.getch()
            if ch == curses.KEY_RESIZE or ch == -1:
                # Resize event or timeout: loop back and re-render cleanly with animation tick
                continue

            if ch in [ord('q'), ord('Q')]:
                if pet_view_mode == "inspect":
                    pet_view_mode = "list"
                    pet_status_msg = ""
                elif tool_view_mode == "inspect":
                    tool_view_mode = "list"
                    runner_status_msg = ""
                elif focus_pane == "content":
                    focus_pane = "menu"
                else:
                    break

            elif ch == 27: # ESC key
                if pet_view_mode == "inspect":
                    pet_view_mode = "list"
                    pet_status_msg = ""
                elif tool_view_mode == "inspect":
                    tool_view_mode = "list"
                    runner_status_msg = ""
                elif focus_pane == "content":
                    focus_pane = "menu"

            elif ch in [ord('\t')]: # TAB to switch between Menu and Content pane
                if selected_menu in [1, 2, 3]:
                    focus_pane = "content" if focus_pane == "menu" else "menu"

            elif ch in [ord('t'), ord('T')]:
                # Cycle theme
                if has_color:
                    current_theme_idx = (current_theme_idx + 1) % len(theme_keys)
                    apply_theme(theme_keys[current_theme_idx])

            # Left key / 'h' always shifts focus to main menu
            elif ch in [curses.KEY_LEFT, ord('h'), ord('H')]:
                focus_pane = "menu"
                if pet_view_mode == "inspect":
                    pet_view_mode = "list"
                if tool_view_mode == "inspect":
                    tool_view_mode = "list"

            # Right key / 'l' shifts focus to content pane
            elif ch in [curses.KEY_RIGHT, ord('l'), ord('L')]:
                if selected_menu in [1, 2, 3]:
                    focus_pane = "content"

            # When focus is in the LEFT menu column
            elif focus_pane == "menu":
                if ch in [curses.KEY_UP, ord('k'), ord('K')]:
                    # Circular wrap: UP from 0 wraps cleanly to last item
                    selected_menu = (selected_menu - 1) % len(menu_items)
                    tool_view_mode = "list"
                    pet_view_mode = "list"
                    runner_status_msg = ""
                    pet_status_msg = ""
                elif ch in [curses.KEY_DOWN, ord('j'), ord('J')]:
                    # Circular wrap: DOWN from last item wraps to 0
                    selected_menu = (selected_menu + 1) % len(menu_items)
                    tool_view_mode = "list"
                    pet_view_mode = "list"
                    runner_status_msg = ""
                    pet_status_msg = ""
                elif ch in [10, 13, ord(' ')]: # Enter / Space
                    if selected_menu in [1, 2, 3]:
                        focus_pane = "content"
                    elif selected_menu == 5: # Restart
                        safe_addstr(stdscr, 10, content_x, "Restarting servers...", curses.color_pair(2) | curses.A_BOLD)
                        stdscr.refresh()
                        cmd_stop(None)
                        cmd_start(None)
                        runner_status_msg = "Servers restarted successfully on :8484, :8088, :8787, :8788."
                        time.sleep(1)
                    elif selected_menu == 6: # Toggle theme
                        if has_color:
                            current_theme_idx = (current_theme_idx + 1) % len(theme_keys)
                            apply_theme(theme_keys[current_theme_idx])
                    elif selected_menu == 7: # Quit
                        break

            # When focus is in the RIGHT content pane
            elif focus_pane == "content":
                if selected_menu == 1:
                    # Pet Dex controls
                    if pet_view_mode == "list":
                        if ch in [curses.KEY_UP, ord('k'), ord('K')]:
                            pet_cursor = (pet_cursor - 1) % len(SOVEREIGN_SPIRITS)
                        elif ch in [curses.KEY_DOWN, ord('j'), ord('J')]:
                            pet_cursor = (pet_cursor + 1) % len(SOVEREIGN_SPIRITS)
                        elif ch in [10, 13, ord(' '), ord('i'), ord('I')]: # Enter / Space / i -> Inspect
                            inspect_pet_data = SOVEREIGN_SPIRITS[pet_cursor]
                            pet_view_mode = "inspect"
                            pet_status_msg = ""
                        elif ch in [ord('s'), ord('S')]: # Quick summon
                            sel = SOVEREIGN_SPIRITS[pet_cursor]
                            set_active_pet(sel["id"])
                            pet_status_msg = f"★ Summoned '{sel['name']}' ({sel['emoji']}) as active companion guardian!"
                    elif pet_view_mode == "inspect":
                        if ch in [ord('b'), ord('B'), 27]:
                            pet_view_mode = "list"
                            pet_status_msg = ""
                        elif ch in [ord('s'), ord('S')]:
                            if inspect_pet_data:
                                set_active_pet(inspect_pet_data["id"])
                                pet_status_msg = f"★ Summoned '{inspect_pet_data['name']}' ({inspect_pet_data['emoji']}) as active companion guardian!"

                elif selected_menu == 2:
                    # Tool Runner mode controls
                    if tool_view_mode == "list":
                        if ch in [curses.KEY_UP, ord('k'), ord('K')]:
                            tool_cursor = (tool_cursor - 1) % max(1, len(tools_list))
                        elif ch in [curses.KEY_DOWN, ord('j'), ord('J')]:
                            tool_cursor = (tool_cursor + 1) % max(1, len(tools_list))
                        elif ch in [10, 13, ord(' '), ord('i'), ord('I')]: # Enter / Space / i
                            if tools_list:
                                inspect_tool_data = tools_list[tool_cursor]
                                tool_view_mode = "inspect"
                                runner_status_msg = ""
                        elif ch in [ord('d'), ord('D')]: # Quick run doctor for selected tool
                            if tools_list:
                                sel = tools_list[tool_cursor]
                                curses.endwin()
                                print(f"\n{BOLD}Running diagnostics for tool: {sel.get('name', sel.get('id'))}...{RESET}\n")
                                if ORCHESTRATOR_PY.exists():
                                    subprocess.run([sys.executable, str(ORCHESTRATOR_PY), "show", sel.get("id", "")])
                                input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                                stdscr.clear()
                                stdscr.refresh()
                    elif tool_view_mode == "inspect":
                        if ch in [ord('b'), ord('B'), 27]:
                            tool_view_mode = "list"
                            runner_status_msg = ""
                        elif ch in [ord('d'), ord('D')]:
                            curses.endwin()
                            print(f"\n{BOLD}Running diagnostics for {inspect_tool_data.get('name')}...{RESET}\n")
                            if ORCHESTRATOR_PY.exists():
                                subprocess.run([sys.executable, str(ORCHESTRATOR_PY), "show", inspect_tool_data.get("id", "")])
                            input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                            stdscr.clear()
                            stdscr.refresh()
                            runner_status_msg = f"Diagnostics executed for {inspect_tool_data.get('id')}"
                        elif ch in [ord('r'), ord('R')]:
                            t_path = Path(inspect_tool_data.get("path", ""))
                            t_entries = inspect_tool_data.get("entrypoints", [])
                            curses.endwin()
                            print(f"\n{BOLD}Executing runner for {inspect_tool_data.get('name')}...{RESET}\n")
                            if t_entries and t_path.exists():
                                entry = t_entries[0]
                                entry_file = t_path / entry
                                if entry.endswith(".py"):
                                    subprocess.run([sys.executable, str(entry_file)], cwd=str(t_path))
                                elif entry.endswith((".js", ".ts", ".mjs")):
                                    subprocess.run(["node", str(entry_file)], cwd=str(t_path))
                                else:
                                    print(f"Entrypoint is {entry}. Path: {t_path}")
                            else:
                                print(f"No direct entrypoint found or path missing: {t_path}")
                            input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                            stdscr.clear()
                            stdscr.refresh()
                            runner_status_msg = f"Runner exited for {inspect_tool_data.get('id')}"

                elif selected_menu == 3:
                    # Website Templates browser controls
                    if tool_view_mode == "list":
                        if ch in [curses.KEY_UP, ord('k'), ord('K')]:
                            template_cursor = (template_cursor - 1) % max(1, len(templates_list))
                        elif ch in [curses.KEY_DOWN, ord('j'), ord('J')]:
                            template_cursor = (template_cursor + 1) % max(1, len(templates_list))
                        elif ch in [10, 13, ord(' '), ord('i'), ord('I')]: # Enter / Space / i
                            if templates_list:
                                inspect_tool_data = templates_list[template_cursor]
                                tool_view_mode = "inspect"
                                runner_status_msg = ""
                        elif ch in [ord('o'), ord('O')]: # Rebrand in Site Generator
                            if templates_list:
                                sel = templates_list[template_cursor]
                                curses.endwin()
                                print(f"\n{BOLD}Opening template '{sel.get('name')}' in Zoth Website Generator...{RESET}\n")
                                url = f"http://127.0.0.1:8088/studio/site-generator.html?template={sel.get('id')}"
                                print(f"URL: {CYAN}{url}{RESET}")
                                subprocess.run(["xdg-open", url], stderr=subprocess.DEVNULL)
                                input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                                stdscr.clear()
                                stdscr.refresh()
                    elif tool_view_mode == "inspect":
                        if ch in [ord('b'), ord('B'), 27]:
                            tool_view_mode = "list"
                            runner_status_msg = ""
                        elif ch in [ord('o'), ord('O')]:
                            curses.endwin()
                            url = f"http://127.0.0.1:8088/studio/site-generator.html?template={inspect_tool_data.get('id')}"
                            print(f"\n{BOLD}Launching Web Foundry with blueprint '{inspect_tool_data.get('name')}'...{RESET}\n")
                            print(f"URL: {CYAN}{url}{RESET}")
                            subprocess.run(["xdg-open", url], stderr=subprocess.DEVNULL)
                            input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                            stdscr.clear()
                            stdscr.refresh()
                            runner_status_msg = f"Opened {inspect_tool_data.get('id')} in Foundry"
                        elif ch in [ord('p'), ord('P')]:
                            curses.endwin()
                            rel_path = inspect_tool_data.get("relative_path", "")
                            url = f"http://127.0.0.1:8088/templates-source/{rel_path}/index.html"
                            print(f"\n{BOLD}Opening browser preview for '{inspect_tool_data.get('name')}'...{RESET}\n")
                            print(f"URL: {CYAN}{url}{RESET}")
                            subprocess.run(["xdg-open", url], stderr=subprocess.DEVNULL)
                            input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                            stdscr.clear()
                            stdscr.refresh()
                            runner_status_msg = f"Preview launched for {inspect_tool_data.get('id')}"
        except curses.error:
            pass

def cmd_tui(args):
    try:
        curses.wrapper(run_tui)
    except Exception as e:
        print(f"{RED}TUI Error: {e}{RESET}")

# ═══════════════════════════════════════════════════════════════
# CLI Entrypoint
# ═══════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        prog="zoth",
        description="Zoth Studio CLI — Sovereign AI Agent & Multi-Node Orchestration Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", help="Zoth commands")

    # zoth start
    p_start = sub.add_parser("start", help="Start all Zoth Studio servers (Web, Orchestrator, Previews, Memory)")
    p_start.set_defaults(func=cmd_start)

    # zoth stop
    p_stop = sub.add_parser("stop", help="Stop all background Zoth Studio servers")
    p_stop.set_defaults(func=cmd_stop)

    # zoth status
    p_status = sub.add_parser("status", help="Show live status of all servers, pets, and tool pipelines")
    p_status.set_defaults(func=cmd_status)

    # zoth pet
    p_pet = sub.add_parser("pet", help="Manage Sovereign Figurine Mascot Spirits & Pet Dex")
    p_pet_sub = p_pet.add_subparsers(dest="pet_cmd", help="Pet subcommands")

    # zoth pet list
    p_pet_list = p_pet_sub.add_parser("list", help="List all 24 Sovereign Mascot Spirits & Pet Dex")
    p_pet_list.set_defaults(func=cmd_pet_list)

    # zoth pet summon <name>
    p_pet_summon = p_pet_sub.add_parser("summon", help="Summon and bind an active Sovereign Companion")
    p_pet_summon.add_argument("name", help="Spirit ID or Name (e.g. draco, kai, azoth, lycan)")
    p_pet_summon.set_defaults(func=cmd_pet_summon)

    # zoth pet status
    p_pet_status = p_pet_sub.add_parser("status", help="Show active Sovereign Companion and Vector Memory status")
    p_pet_status.set_defaults(func=cmd_pet_status)

    p_pet.set_defaults(func=cmd_pet)

    # zoth tui / dashboard
    p_tui = sub.add_parser("tui", help="Launch interactive Terminal User Interface (TUI) cockpit")
    p_tui.set_defaults(func=cmd_tui)

    # zoth list
    p_list = sub.add_parser("list", help="List registered tools and autonomous blueprints")
    p_list.add_argument("--summary", action="store_true", help="Group by category")
    p_list.add_argument("-c", "--category", help="Filter by category")
    p_list.set_defaults(func=cmd_list)

    # zoth doctor
    p_doctor = sub.add_parser("doctor", help="Run system diagnostics, environment probes, and runtime audits")
    p_doctor.set_defaults(func=cmd_doctor)

    # zoth run
    p_run = sub.add_parser("run", help="Run a sovereign tool command or pipeline")
    p_run.add_argument("tool_id", help="Tool ID or name (e.g. local_null_ai_subsweep)")
    p_run.add_argument("--confirm", action="store_true", help="Execute tool directly (skips dry-run)")
    p_run.add_argument("tool_args", nargs=argparse.REMAINDER, help="Additional arguments to pass to the tool")
    p_run.set_defaults(func=cmd_run)

    # zoth update
    p_update = sub.add_parser("update", help="Self-update Zoth Studio to latest git commits, refresh binaries and permissions")
    p_update.add_argument("--check", action="store_true", help="Check for available updates without applying them")
    p_update.add_argument("-y", "--yes", "-u", "--unattended", "--no-prompt", dest="unattended", action="store_true", help="Run update non-interactively")
    p_update.add_argument("-b", "--branch", help="Target git branch (default: active branch or main)")
    p_update.add_argument("--remote", default="origin", help="Target git remote (default: origin)")
    p_update.add_argument("--force", action="store_true", help="Force update and overwrite local modifications")
    p_update.set_defaults(func=cmd_update)

    args = parser.parse_args()
    if not args.command:
        # Default to banner and status if no command provided
        cmd_status(args)
        print(f"\n{BOLD}Available Commands:{RESET}")
        print(f"  {CYAN}zoth tui{RESET}          Launch interactive Terminal Dashboard & Pet Dex")
        print(f"  {CYAN}zoth pet list{RESET}     List all 24 Sovereign Mascot Spirits & Pet Dex")
        print(f"  {CYAN}zoth pet summon{RESET}   Summon and bind active companion spirit")
        print(f"  {CYAN}zoth pet status{RESET}   Check active companion & vector memory binding")
        print(f"  {CYAN}zoth start{RESET}        Start all local servers (:8484, :8088, :8787, :8788)")
        print(f"  {CYAN}zoth stop{RESET}         Stop all running servers")
        print(f"  {CYAN}zoth status{RESET}       Check active server ports and tool registry")
        print(f"  {CYAN}zoth update{RESET}       Pull latest git commits and update CLI binaries")
        print(f"  {CYAN}zoth doctor{RESET}       Run full diagnostics and runtime audits")
        print(f"  {CYAN}zoth list{RESET}         List all 298+ registered tools")
        print(f"  {CYAN}zoth run{RESET}          Run a sovereign tool command or pipeline\n")
        return 0

    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())

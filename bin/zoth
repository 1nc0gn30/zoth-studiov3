def print_banner():
    print(BANNER)

def check_port(port: int, host: str = "127.0.0.1") -> bool:
    import socket
    with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
        s.settimeout(0.4)
        return s.connect_ex((host, port)) == 0

def get_server_status() -> dict[str, Any]:
    status = {}
    
    # 1. Orchestrator :8484
    orch_up = check_port(8484)
    status["orchestrator"] = {
        "name": "Zoth Orchestrator API & Swarm Bus",
        "port": 8484,
        "up": orch_up,
        "url": "http://127.0.0.1:8484",
        "api_url": "http://127.0.0.1:8484/api/tools"
    }

    # 2. Web Server :8088
    web_up = check_port(8088)
    status["web"] = {
        "name": "Zoth Studio Web & Comics Hub",
        "port": 8088,
        "up": web_up,
        "url": "http://127.0.0.1:8088",
        "routes": ["/studio/", "/comic/", "/agents/", "/vault/", "/blueprints/"]
    }

    # 3. Previews Server :8787
    prev_up = check_port(8787)
    status["previews"] = {
        "name": "Web Previews Container (CORS)",
        "port": 8787,
        "up": prev_up,
        "url": "http://127.0.0.1:8787",
        "health_url": "http://127.0.0.1:8787/health"
    }

    return status

def cmd_status(args):
    print_banner()
    print(f"{BOLD}Runtime Server Matrix:{RESET}\n")
    statuses = get_server_status()
    for key, info in statuses.items():
        state_badge = f"{GREEN}● ACTIVE{RESET}" if info["up"] else f"{RED}○ OFFLINE{RESET}"
        print(f"  {state_badge}  {BOLD}{info['name']}{RESET}")
        print(f"       Port: {CYAN}{info['port']}{RESET}  |  URL: {GRAY}{info['url']}{RESET}\n")
    
    # Check tool registry if orchestrator is up
    if statuses["orchestrator"]["up"]:
        try:
            req = urllib.request.Request(statuses["orchestrator"]["api_url"], headers={"User-Agent": "ZothCLI/1.0"})
            with urllib.request.urlopen(req, timeout=1.0) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                tool_count = data.get("tool_count", len(data.get("tools", [])))
                print(f"  {GOLD}⚡ Tool Registry Connected:{RESET} {tool_count} sovereign tools online.\n")
        except Exception:
            pass

def cmd_list(args):
    print_banner()
    if not ORCHESTRATOR_PY.exists():
        print(f"{RED}Error: orchestrator.py not found at {ORCHESTRATOR_PY}{RESET}")
        return 1
    
    cmd = [sys.executable, str(ORCHESTRATOR_PY), "list"]
    if getattr(args, "summary", False):
        cmd.append("--summary")
    if getattr(args, "category", None):
        cmd.extend(["-c", args.category])
    
    subprocess.run(cmd)

def cmd_run(args):
    print_banner()
    if not ORCHESTRATOR_PY.exists():
        print(f"{RED}Error: orchestrator.py not found at {ORCHESTRATOR_PY}{RESET}")
        return 1

    cmd = [sys.executable, str(ORCHESTRATOR_PY), "run", args.tool_id]
    if getattr(args, "confirm", False):
        cmd.append("--confirm")
    if getattr(args, "tool_args", []):
        cmd.extend(args.tool_args)

    subprocess.run(cmd)

def cmd_doctor(args):
    print_banner()
    print(f"{BOLD}Executing Zoth Studio System Diagnostics...{RESET}\n")
    
    checks = [
        ("Python 3 Runtime", sys.version.split()[0], True),
        ("Git Version Control", shutil.which("git") or "missing", bool(shutil.which("git"))),
        ("Node.js Environment", shutil.which("node") or "missing", bool(shutil.which("node"))),
        ("NPM Package Manager", shutil.which("npm") or "missing", bool(shutil.which("npm"))),
        ("Zoth Public Root", str(PUBLIC_DIR) if PUBLIC_DIR.exists() else "missing", PUBLIC_DIR.exists()),
        ("Orchestrator Engine", str(ORCHESTRATOR_PY) if ORCHESTRATOR_PY.exists() else "missing", ORCHESTRATOR_PY.exists()),
    ]

    for name, detail, passed in checks:
        icon = f"{GREEN}✔{RESET}" if passed else f"{RED}✖{RESET}"
        print(f"  {icon} {BOLD}{name:24s}{RESET} {GRAY}{detail}{RESET}")
    print()

def find_git_root() -> Path | None:
    """Find repository root containing .git directory."""
    candidates = [CORE_APP_DIR, BASE_DIR, BASE_DIR.parent]
    for c in candidates:
        if (c / ".git").exists():
            return c
    try:
        res = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            cwd=str(CORE_APP_DIR),
            capture_output=True,
            text=True
        )
        if res.returncode == 0 and res.stdout.strip():
            top = Path(res.stdout.strip())
            if top.exists():
                return top
    except Exception:
        pass
    return None

def _sync_binaries(git_root: Path):
    """Synchronize binary symlinks, permissions, and launcher scripts."""
    zoth_candidates = [
        git_root / "core-app" / "bin" / "zoth",
        git_root / "bin" / "zoth",
        CORE_APP_DIR / "bin" / "zoth"
    ]
    cli_src = None
    for cand in zoth_candidates:
        if cand.exists():
            cli_src = cand
            break

    if cli_src:
        try:
            cli_src.chmod(cli_src.stat().st_mode | 0o755)
        except Exception:
            pass

        # Link in ~/.local/bin/zoth on POSIX systems
        if os.name != "nt":
            bin_dir = Path.home() / ".local" / "bin"
            try:
                bin_dir.mkdir(parents=True, exist_ok=True)
                target = bin_dir / "zoth"
                if target.is_symlink() or target.exists():
                    try:
                        target.unlink()
                    except Exception:
                        pass
                target.symlink_to(cli_src)
                print(f"  {GREEN}✔{RESET} CLI symlink synced: {CYAN}{target}{RESET} -> {GRAY}{cli_src}{RESET}")
            except Exception as e:
                print(f"  {GOLD}⚠ Warning syncing CLI symlink: {e}{RESET}")

    # Chmod all launcher shell scripts
    for s_dir in [git_root / "scripts", git_root / "core-app" / "scripts"]:
        if s_dir.exists():
            for sh_file in s_dir.glob("*.sh"):
                try:
                    sh_file.chmod(sh_file.stat().st_mode | 0o755)
                except Exception:
                    pass

def cmd_update(args):
    print_banner()
    print(f"{BOLD}Zoth Studio Sovereign Self-Updater{RESET}\n")

    git_bin = shutil.which("git")
    if not git_bin:
        print(f"{RED}✖ Error: git command not found. Please install git to enable self-updating.{RESET}")
        return 1

    git_root = find_git_root()
    if not git_root:
        print(f"{RED}✖ Error: Not running inside a Git repository.{RESET}")
        print(f"  To install Zoth Studio as a git workstation, run:")
        print(f"  {CYAN}curl -fsSL https://zoth.nullai.tech/install.sh | bash{RESET}\n")
        return 1

    # Detect current branch and remotes
    try:
        branch_res = subprocess.run(
            ["git", "rev-parse", "--abbrev-ref", "HEAD"],
            cwd=str(git_root),
            capture_output=True,
            text=True,
            check=True
        )
        current_branch = branch_res.stdout.strip() or "main"
    except Exception:
        current_branch = "main"

    target_branch = getattr(args, "branch", None) or current_branch
    target_remote = getattr(args, "remote", None) or "origin"
    is_check_only = getattr(args, "check", False)
    is_force = getattr(args, "force", False)
    is_unattended = getattr(args, "unattended", False) or os.getenv("ZOTH_UNATTENDED") == "1" or os.getenv("CI") == "true"

    print(f"  Repo Root:      {GRAY}{git_root}{RESET}")
    print(f"  Active Branch:  {CYAN}{target_branch}{RESET}")
    print(f"  Remote Target:  {CYAN}{target_remote}{RESET}")

    # Local commit status
    try:
        local_hash = subprocess.check_output(
            ["git", "rev-parse", "--short", "HEAD"],
            cwd=str(git_root),
            text=True
        ).strip()
        local_desc = subprocess.check_output(
            ["git", "log", "-1", "--format=%s (%cr)", "HEAD"],
            cwd=str(git_root),
            text=True
        ).strip()
        print(f"  Current Commit: {GOLD}{local_hash}{RESET} - {GRAY}{local_desc}{RESET}\n")
    except Exception:
        local_hash = "unknown"
        print(f"  Current Commit: {GRAY}{local_hash}{RESET}\n")

    # Fetch updates from remote
    print(f"{BOLD}Fetching latest commits from {target_remote}/{target_branch}...{RESET}")
    fetch_env = os.environ.copy()
    if is_unattended:
        fetch_env["GIT_TERMINAL_PROMPT"] = "0"

    fetch_res = subprocess.run(
        ["git", "fetch", target_remote, target_branch],
        cwd=str(git_root),
        capture_output=True,
        text=True,
        env=fetch_env
    )
    if fetch_res.returncode != 0:
        print(f"{RED}✖ Fetch failed:{RESET} {fetch_res.stderr.strip()}")
        remotes_res = subprocess.run(["git", "remote"], cwd=str(git_root), capture_output=True, text=True)
        remotes = remotes_res.stdout.split()
        if remotes and target_remote not in remotes:
            print(f"  Available remotes: {', '.join(remotes)}")
        return 1

    remote_ref = f"{target_remote}/{target_branch}"
    try:
        remote_hash = subprocess.check_output(
            ["git", "rev-parse", "--short", remote_ref],
            cwd=str(git_root),
            text=True
        ).strip()
    except Exception:
        remote_hash = "unknown"

    try:
        rev_count_out = subprocess.check_output(
            ["git", "rev-list", "--count", f"HEAD..{remote_ref}"],
            cwd=str(git_root),
            text=True
        ).strip()
        commits_behind = int(rev_count_out)
    except Exception:
        commits_behind = 0

    if commits_behind == 0 and not is_force:
        print(f"  {GREEN}✔ Zoth Studio is already up to date!{RESET}")
        print(f"  Running on latest commit {GOLD}{local_hash}{RESET} on {CYAN}{target_branch}{RESET}.\n")
        _sync_binaries(git_root)
        return 0

    if is_check_only:
        print(f"  {GOLD}⚡ Update Available:{RESET} Local installation is {BOLD}{commits_behind}{RESET} commit(s) behind {CYAN}{remote_ref}{RESET} ({local_hash} -> {remote_hash}).\n")
        try:
            log_out = subprocess.check_output(
                ["git", "log", f"HEAD..{remote_ref}", "--oneline", "-n", "10"],
                cwd=str(git_root),
                text=True
            ).strip()
            print(f"{BOLD}Upcoming commits:{RESET}\n{GRAY}{log_out}{RESET}\n")
        except Exception:
            pass
        print(f"Run {CYAN}zoth update{RESET} to pull and apply updates.\n")
        return 0

    # Display pending commits if any
    if commits_behind > 0:
        print(f"  {GOLD}⚡ Found {BOLD}{commits_behind}{RESET}{GOLD} new commit(s) on {CYAN}{remote_ref}{RESET}:")
        try:
            log_out = subprocess.check_output(
                ["git", "log", f"HEAD..{remote_ref}", "--oneline", "-n", "5"],
                cwd=str(git_root),
                text=True
            ).strip()
            print(f"{GRAY}{log_out}{RESET}\n")
        except Exception:
            pass

    print(f"{BOLD}Applying updates to Zoth Studio...{RESET}")
    if is_force:
        pull_cmd = ["git", "reset", "--hard", remote_ref]
    else:
        pull_cmd = ["git", "pull", "--ff-only", target_remote, target_branch]

    pull_res = subprocess.run(pull_cmd, cwd=str(git_root), capture_output=True, text=True, env=fetch_env)
    if pull_res.returncode != 0 and not is_force:
        pull_res = subprocess.run(["git", "pull", target_remote, target_branch], cwd=str(git_root), capture_output=True, text=True, env=fetch_env)

    if pull_res.returncode != 0:
        print(f"{RED}✖ Error updating repository:{RESET}\n{pull_res.stderr.strip()}")
        print(f"  To force update and overwrite local changes, use: {CYAN}zoth update --force{RESET}")
        return 1

    try:
        new_hash = subprocess.check_output(["git", "rev-parse", "--short", "HEAD"], cwd=str(git_root), text=True).strip()
    except Exception:
        new_hash = "updated"

    # Synchronize binaries, symlinks, and execution permissions
    _sync_binaries(git_root)

    print(f"\n{GREEN}{BOLD}══════════════════════════════════════════════════════════════════{RESET}")
    print(f"  {GREEN}{BOLD}✔ Zoth Studio Successfully Updated! ({local_hash} → {new_hash}){RESET}")
    print(f"{GREEN}{BOLD}══════════════════════════════════════════════════════════════════{RESET}\n")
    return 0

def cmd_start(args):
    print_banner()
    print(f"{BOLD}Starting Zoth Studio Sovereign Workstation Suite...{RESET}\n")
    
    script_path = BASE_DIR.parent / "scripts" / "start-all-servers.sh"
    if script_path.exists():
        subprocess.run(["bash", str(script_path)])
    else:
        print(f"{RED}start-all-servers.sh not found. Starting manually...{RESET}")
        subprocess.Popen([sys.executable, "-m", "http.server", "8088", "--bind", "0.0.0.0", "--directory", str(PUBLIC_DIR)])
        print(f"{GREEN}✔ Web Server started on port 8088{RESET}")

def cmd_stop(args):
    print_banner()
    print(f"{BOLD}Stopping active Zoth servers on ports 8484, 8088, 8787...{RESET}\n")
    for port in [8484, 8088, 8787]:
        try:
            out = subprocess.check_output(["lsof", "-ti", f":{port}"], text=True).strip()
            if out:
                pids = out.split()
                for pid in pids:
                    os.kill(int(pid), signal.SIGTERM)
                print(f"  {GREEN}✔ Port {port} freed (killed PID(s): {', '.join(pids)}){RESET}")
        except Exception:
            print(f"  {GRAY}○ Port {port} is idle.{RESET}")
    print(f"\n{GREEN}All Zoth servers stopped cleanly.{RESET}\n")

# ═══════════════════════════════════════════════════════════════
# TUI (Terminal User Interface Dashboard) & Telemetry
# ═══════════════════════════════════════════════════════════════

try:
    import psutil
    HAS_PSUTIL = True
except ImportError:
    HAS_PSUTIL = False

REGISTRY_CACHE_PATH = ORCHESTRATOR_PY.parent / "registry.local.json"

def get_system_telemetry() -> tuple[float, float, str, str]:
    """Return (cpu_percent, ram_percent, ram_used_str, ram_total_str)."""
    if HAS_PSUTIL:
        try:
            cpu = psutil.cpu_percent(interval=None)
            mem = psutil.virtual_memory()
            used_gb = mem.used / (1024 ** 3)
            total_gb = mem.total / (1024 ** 3)
            return cpu, mem.percent, f"{used_gb:.1f}G", f"{total_gb:.1f}G"
        except Exception:
            pass

    # Fallback to /proc if psutil is unavailable or errors
    cpu = 0.0
    ram_pct = 0.0
    used_str = "?"
    total_str = "?"
    try:
        if Path("/proc/meminfo").exists():
            meminfo = {}
            for line in Path("/proc/meminfo").read_text().splitlines():
                parts = line.split(":")
                if len(parts) == 2:
                    meminfo[parts[0].strip()] = parts[1].strip()
            total_kb = float(meminfo.get("MemTotal", "0 kB").split()[0])
            avail_kb = float(meminfo.get("MemAvailable", "0 kB").split()[0])
            if total_kb > 0:
                used_kb = total_kb - avail_kb
                ram_pct = (used_kb / total_kb) * 100.0
                used_str = f"{used_kb / (1024*1024):.1f}G"
                total_str = f"{total_kb / (1024*1024):.1f}G"
        if Path("/proc/loadavg").exists():
            load1 = float(Path("/proc/loadavg").read_text().split()[0])
            cpu_count = os.cpu_count() or 1
            cpu = min(100.0, (load1 / cpu_count) * 100.0)
    except Exception:
        pass
    return cpu, ram_pct, used_str, total_str

def make_meter_bar(pct: float, width: int = 10) -> str:
    """Render a colored/proportional ASCII bar like [████░░░░░░]."""
    pct = max(0.0, min(100.0, pct))
    filled = int(round((pct / 100.0) * width))
    bar = "█" * filled + "░" * (width - filled)
    return f"[{bar}] {pct:4.1f}%"

def load_all_tools() -> list[dict[str, Any]]:
    """Load tools from local registry cache or fallback sample."""
    if REGISTRY_CACHE_PATH.exists():
        try:
            data = json.loads(REGISTRY_CACHE_PATH.read_text(encoding="utf-8"))
            tools = data.get("tools", [])
            if tools:
                return tools
        except Exception:
            pass
    # Fallback default tools if registry not yet generated
    return [
        {"id": "local_null_ai_omnipost", "name": "OmniPost 2.0", "description": "Social Repurposer & Multi-Platform Distribution", "category": "Social Automation", "runtimes": ["python", "node"], "entrypoints": ["app.py", "cli.py"]},
        {"id": "local_null_ai_subsweep", "name": "SubSweep", "description": "OSINT & Surface Vulnerability Recon", "category": "Security Operations", "runtimes": ["python"], "entrypoints": ["subsweep.py"]},
        {"id": "local_null_ai_site_foundry", "name": "Site Foundry", "description": "Rapid Multi-Framework Website Generator", "category": "Website Generation", "runtimes": ["node", "astro"], "entrypoints": ["index.html"]},
        {"id": "local_null_ai_nexus3d", "name": "Nexus 3D", "description": "Volumetric CAD & Shaders Studio", "category": "Design Intelligence", "runtimes": ["node", "threejs"], "entrypoints": ["main.tsx"]},
        {"id": "local_null_ai_consensus_arena", "name": "Consensus Arena", "description": "3-Agent AST Quorum Synthesizer", "category": "AI Agents & LLM", "runtimes": ["python"], "entrypoints": ["arena.py"]},
        {"id": "local_null_ai_argon2id_vault", "name": "Argon2id Vault", "description": "Memory-Hard Cryptographic Isolation (:8484)", "category": "Security Operations", "runtimes": ["rust", "python"], "entrypoints": ["vault.rs"]},
        {"id": "local_null_ai_signal_bridge", "name": "Signal Bridge", "description": "Encrypted Swarm Mobile Dispatcher", "category": "Automation & Tools", "runtimes": ["node"], "entrypoints": ["server.ts"]},
    ]

# Theme definitions
THEMES = {
    "Cyber Gold": {
        "primary": curses.COLOR_YELLOW,
        "accent": curses.COLOR_CYAN,
        "success": curses.COLOR_GREEN,
        "warn": curses.COLOR_MAGENTA,
        "error": curses.COLOR_RED,
        "text": curses.COLOR_WHITE,
    },
    "Matrix Green": {
        "primary": curses.COLOR_GREEN,
        "accent": curses.COLOR_CYAN,
        "success": curses.COLOR_GREEN,
        "warn": curses.COLOR_YELLOW,
        "error": curses.COLOR_RED,
        "text": curses.COLOR_WHITE,
    },
    "Cyberpunk Neon": {
        "primary": curses.COLOR_MAGENTA,
        "accent": curses.COLOR_CYAN,
        "success": curses.COLOR_GREEN,
        "warn": curses.COLOR_YELLOW,
        "error": curses.COLOR_RED,
        "text": curses.COLOR_WHITE,
    },
    "Monochrome Stealth": {
        "primary": curses.COLOR_WHITE,
        "accent": curses.COLOR_WHITE,
        "success": curses.COLOR_WHITE,
        "warn": curses.COLOR_WHITE,
        "error": curses.COLOR_WHITE,
        "text": curses.COLOR_WHITE,
    }
}

def apply_theme(theme_name: str):
    palette = THEMES.get(theme_name, THEMES["Cyber Gold"])
    curses.init_pair(1, palette["accent"], -1)   # Accent / borders
    curses.init_pair(2, palette["primary"], -1)  # Primary / Headers / Highlights
    curses.init_pair(3, palette["success"], -1)  # Online / Success
    curses.init_pair(4, palette["warn"], -1)     # Warning / Swarm
    curses.init_pair(5, palette["error"], -1)    # Error / Offline
    curses.init_pair(6, palette["text"], -1)     # Body Text

def safe_addstr(win, y: int, x: int, text: str, attr: int = 0):
    """Safely write string to curses window without throwing out-of-bounds curses.error."""
    try:
        h, w = win.getmaxyx()
        if 0 <= y < h and 0 <= x < w:
            max_len = w - x - 1
            if max_len > 0:
                win.addstr(y, x, text[:max_len], attr)
    except curses.error:
        pass

def run_tui(stdscr):
    curses.curs_set(0)
    stdscr.nodelay(True)
    stdscr.timeout(800)

    # Init colors & terminal auto-detection
    has_color = curses.has_colors()
    if has_color:
        curses.start_color()
        curses.use_default_colors()

    theme_keys = list(THEMES.keys())
    # Auto-detect terminal support: default to Cyber Gold if >= 8 colors, else Monochrome
    current_theme_idx = 0 if (has_color and curses.COLORS >= 8) else 3
    if has_color:
        apply_theme(theme_keys[current_theme_idx])

    selected_menu = 0
    menu_items = [
        "Dashboard & Status",
        "Registered Tools",
        "Live Bus Events",
        "Restart Servers",
        "Toggle Theme",
        "Quit (q)"
    ]

    # Tool runner state
    tools_list = load_all_tools()
    tool_cursor = 0
    tool_scroll_offset = 0
    tool_filter = ""
    tool_view_mode = "list" # "list" or "inspect"
    inspect_tool_data = None
    runner_status_msg = ""

    # Live telemetry initial read
    if HAS_PSUTIL:
        psutil.cpu_percent(interval=None)

    while True:
        try:
            stdscr.erase()
            h, w = stdscr.getmaxyx()

            if h < 12 or w < 50:
                safe_addstr(stdscr, 1, 2, "Window too small for Zoth TUI", curses.A_BOLD)
                safe_addstr(stdscr, 2, 2, f"Size: {w}x{h} (Min: 50x12)", curses.A_DIM)
                stdscr.refresh()
                time.sleep(0.2)
                ch = stdscr.getch()
                if ch in [ord('q'), ord('Q'), 27]:
                    break
                continue

            theme_name = theme_keys[current_theme_idx]

            # ── 1. Top Header & Telemetry Bar ──────────────────────────────
            title = " ⚡ ZOTH STUDIO SOVEREIGN TERMINAL COMMAND DECK (TUI v1.1) ⚡ "
            safe_addstr(stdscr, 0, max(0, (w - len(title)) // 2), title, curses.color_pair(2) | curses.A_BOLD)

            # Live CPU & RAM Telemetry Header
            cpu_pct, ram_pct, ram_used, ram_total = get_system_telemetry()
            cpu_bar = make_meter_bar(cpu_pct, width=8)
            ram_bar = make_meter_bar(ram_pct, width=8)
            telem_line = f" CPU: {cpu_bar}  │  RAM: {ram_bar} ({ram_used}/{ram_total})  │  Theme: [{theme_name}]"
            safe_addstr(stdscr, 1, max(0, (w - len(telem_line)) // 2), telem_line, curses.color_pair(1))

            # Horizontal divider below telemetry
            safe_addstr(stdscr, 2, 2, "─" * max(1, w - 4), curses.color_pair(1) | curses.A_DIM)

            # ── 2. Left Column: Navigation Menu ────────────────────────────
            safe_addstr(stdscr, 4, 3, "COMMANDS", curses.color_pair(6) | curses.A_BOLD)

            for i, item in enumerate(menu_items):
                y_pos = 6 + (i * 2)
                if y_pos < h - 3:
                    if i == selected_menu:
                        safe_addstr(stdscr, y_pos, 3, f" ▶ {item} ", curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                    else:
                        safe_addstr(stdscr, y_pos, 3, f"   {item}", curses.color_pair(6))

            # Vertical Divider
            for y in range(3, h - 2):
                safe_addstr(stdscr, y, 26, "│", curses.color_pair(1) | curses.A_DIM)

            # ── 3. Right Column: Dynamic Content Pane ──────────────────────
            content_x = 29
            content_w = max(10, w - content_x - 2)

            if selected_menu == 0:
                # Dashboard & Status
                safe_addstr(stdscr, 4, content_x, "SYSTEM TELEMETRY & ACTIVE PORTS", curses.color_pair(1) | curses.A_BOLD)

                statuses = get_server_status()
                y_offset = 6
                for s_key, info in statuses.items():
                    if y_offset >= h - 7:
                        break
                    is_up = info["up"]
                    status_color = curses.color_pair(3) if is_up else curses.color_pair(5)
                    status_str = " [ONLINE] " if is_up else " [OFFLINE]"
                    
                    safe_addstr(stdscr, y_offset, content_x, status_str, status_color | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset, content_x + 12, f"{info['name']} (Port {info['port']})", curses.color_pair(6) | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset + 1, content_x + 12, f"URL: {info['url']}", curses.color_pair(6) | curses.A_DIM)
                    y_offset += 3

                if y_offset < h - 4:
                    safe_addstr(stdscr, y_offset, content_x, "─" * content_w, curses.color_pair(1) | curses.A_DIM)
                    safe_addstr(stdscr, y_offset + 1, content_x, f"Total Registered Tools: {len(tools_list)} sovereign nodes loaded", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset + 2, content_x, "Agent Swarm State: 21 Autonomous Model Archetypes Active", curses.color_pair(4) | curses.A_BOLD)
                    safe_addstr(stdscr, y_offset + 3, content_x, "Local Loopback Latency: < 0.45ms | Cloud Egress: 0 B/s (Zero-Leakage)", curses.color_pair(6) | curses.A_DIM)

            elif selected_menu == 1:
                # Registered Tools / Tool Runner Mode
                if tool_view_mode == "inspect" and inspect_tool_data:
                    # Tool Details / Runner Mode
                    t = inspect_tool_data
                    tid = t.get("id", "?")
                    tname = t.get("name", tid)
                    tcat = t.get("category", "General")
                    tdesc = t.get("description", "No description provided.")
                    truns = ", ".join(t.get("runtimes", [])) or "universal"
                    tpath = t.get("path", t.get("relative_path", "?"))
                    tentry = ", ".join(t.get("entrypoints", [])) or "none"
                    tscripts = t.get("package_scripts", {})

                    safe_addstr(stdscr, 4, content_x, f"⚡ TOOL INSPECTION & RUNNER: {tname[:content_w-30]}", curses.color_pair(2) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, "─" * content_w, curses.color_pair(1) | curses.A_DIM)

                    y_row = 6
                    safe_addstr(stdscr, y_row, content_x, f"ID:          {tid}", curses.color_pair(6) | curses.A_BOLD)
                    safe_addstr(stdscr, y_row + 1, content_x, f"Category:    {tcat}", curses.color_pair(1))
                    safe_addstr(stdscr, y_row + 2, content_x, f"Runtimes:    {truns}", curses.color_pair(3))
                    safe_addstr(stdscr, y_row + 3, content_x, f"Path:        {tpath[:content_w-15]}", curses.color_pair(6) | curses.A_DIM)
                    safe_addstr(stdscr, y_row + 4, content_x, f"Entrypoints: {tentry[:content_w-15]}", curses.color_pair(6))
                    safe_addstr(stdscr, y_row + 5, content_x, f"Description: {tdesc[:content_w-15]}", curses.color_pair(6))

                    y_row += 7
                    safe_addstr(stdscr, y_row, content_x, "ACTIONS / QUICK RUNNERS:", curses.color_pair(2) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, " [d] Run Tool Diagnostics (Doctor)   |  [r] Run Default Entrypoint", curses.color_pair(1) | curses.A_BOLD)
                    y_row += 1
                    safe_addstr(stdscr, y_row, content_x, " [s] Show CLI Info                  |  [ESC/b] Back to Tool List", curses.color_pair(6))

                    if tscripts and y_row + 2 < h - 4:
                        y_row += 2
                        safe_addstr(stdscr, y_row, content_x, "Package Scripts:", curses.color_pair(2))
                        for s_name, s_cmd in list(tscripts.items())[:3]:
                            y_row += 1
                            if y_row < h - 3:
                                safe_addstr(stdscr, y_row, content_x + 2, f"• {s_name}: {s_cmd[:content_w-15]}", curses.color_pair(6) | curses.A_DIM)

                    if runner_status_msg and y_row + 2 < h - 2:
                        safe_addstr(stdscr, y_row + 2, content_x, f"Status: {runner_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)

                else:
                    # Tool List Mode with Interactive Scroll & Selector
                    safe_addstr(stdscr, 4, content_x, f"REGISTERED SOVEREIGN TOOLS ({len(tools_list)} total)", curses.color_pair(1) | curses.A_BOLD)
                    safe_addstr(stdscr, 5, content_x, " [▲/▼] Scroll Tool  |  [ENTER/i] Inspect / Run Tool  |  [d] Run Doctor", curses.color_pair(6) | curses.A_DIM)

                    visible_rows = max(1, h - 9)
                    if tool_cursor < tool_scroll_offset:
                        tool_scroll_offset = tool_cursor
                    elif tool_cursor >= tool_scroll_offset + visible_rows:
                        tool_scroll_offset = tool_cursor - visible_rows + 1

                    for idx in range(visible_rows):
                        t_idx = tool_scroll_offset + idx
                        if t_idx >= len(tools_list):
                            break
                        tool = tools_list[t_idx]
                        t_name = tool.get("name", tool.get("id", "?"))
                        t_cat = tool.get("category", "General")
                        t_desc = tool.get("description", "")
                        y_pos = 7 + idx

                        is_cur = (t_idx == tool_cursor)
                        if is_cur:
                            safe_addstr(stdscr, y_pos, content_x, f" ▶ ⚡ {t_name:22s}", curses.color_pair(2) | curses.A_REVERSE | curses.A_BOLD)
                            cat_badge = f"[{t_cat[:16]}]"
                            safe_addstr(stdscr, y_pos, content_x + 28, f"{cat_badge:18s} {t_desc[:content_w-50]}", curses.color_pair(6) | curses.A_BOLD)
                        else:
                            safe_addstr(stdscr, y_pos, content_x, f"   ⚡ {t_name:22s}", curses.color_pair(2))
                            cat_badge = f"[{t_cat[:16]}]"
                            safe_addstr(stdscr, y_pos, content_x + 28, f"{cat_badge:18s} {t_desc[:content_w-50]}", curses.color_pair(6) | curses.A_DIM)

                    if runner_status_msg:
                        safe_addstr(stdscr, h - 3, content_x, f"Status: {runner_status_msg[:content_w-10]}", curses.color_pair(3) | curses.A_BOLD)

            elif selected_menu == 2:
                # Live Bus Events
                safe_addstr(stdscr, 4, content_x, "LIVE SWARM BUS STREAM (IPC / LOCALHOST:8484)", curses.color_pair(1) | curses.A_BOLD)

                sample_logs = [
                    ("[00:00:01]", "AST Validation Node", "Shannon entropy passed for /index.html"),
                    ("[00:00:02]", "Master Azoth", "Operator instruction broadcasted to 21 specialists"),
                    ("[00:00:03]", "OmniPost Engine", "Sentence-aware thread chunks serialized for Telegram"),
                    ("[00:00:04]", "SubSweep Recon", "Scanned news.zoth.nullai.tech (100% verified)"),
                    ("[00:00:05]", "Security Auditor", "Argon2id container health check: PASSED"),
                    ("[00:00:06]", "Nexus 3D Engine", "GLSL shaders compiled for volumetric preview (:8787)"),
                    ("[00:00:07]", "Telemetry Probe", "Local node network latency stable at 0.42ms"),
                ]
                for idx, (t_time, t_src, t_msg) in enumerate(sample_logs):
                    y_pos = 6 + (idx * 2)
                    if y_pos + 1 < h - 3:
                        safe_addstr(stdscr, y_pos, content_x, f"{t_time}", curses.color_pair(2))
                        safe_addstr(stdscr, y_pos, content_x + 12, f"[{t_src}]", curses.color_pair(4) | curses.A_BOLD)
                        safe_addstr(stdscr, y_pos + 1, content_x + 14, f"↳ {t_msg}", curses.color_pair(6) | curses.A_DIM)

            elif selected_menu == 3:
                # Restart Servers
                safe_addstr(stdscr, 4, content_x, "SERVER CLUSTER RESTART CONTROL", curses.color_pair(1) | curses.A_BOLD)
                safe_addstr(stdscr, 6, content_x, "Press [ENTER] or [SPACE] to execute server restart cycle.", curses.color_pair(2) | curses.A_BOLD)
                safe_addstr(stdscr, 8, content_x, "This will cleanly terminate existing instances and reload :8484, :8088, and :8787.", curses.color_pair(6) | curses.A_DIM)
                if runner_status_msg:
                    safe_addstr(stdscr, 10, content_x, runner_status_msg, curses.color_pair(3) | curses.A_BOLD)

            elif selected_menu == 4:
                # Toggle Theme
                safe_addstr(stdscr, 4, content_x, "COLOR THEME & DISPLAY PREFERENCES", curses.color_pair(1) | curses.A_BOLD)
                safe_addstr(stdscr, 6, content_x, f"Active Theme: {theme_name}", curses.color_pair(2) | curses.A_BOLD)
                safe_addstr(stdscr, 8, content_x, "Press [ENTER] or [t] to cycle through visual themes:", curses.color_pair(6))
                for i_t, t_name in enumerate(theme_keys):
                    bullet = " ● " if i_t == current_theme_idx else " ○ "
                    attr = (curses.color_pair(2) | curses.A_BOLD) if i_t == current_theme_idx else curses.color_pair(6)
                    safe_addstr(stdscr, 10 + i_t, content_x + 2, f"{bullet} {t_name}", attr)

            elif selected_menu == 5:
                break

            # ── 4. Footer ──────────────────────────────────────────────────
            footer_text = " [▲/▼] Navigate  |  [ENTER] Select/Inspect  |  [t] Cycle Theme  |  [q] Exit TUI "
            safe_addstr(stdscr, h - 1, max(0, (w - len(footer_text)) // 2), footer_text, curses.color_pair(1) | curses.A_REVERSE)

            stdscr.refresh()

            # ── 5. Input Handling & Resize Resiliency ──────────────────────
            ch = stdscr.getch()
            if ch == curses.KEY_RESIZE or ch == -1:
                # Resize event or timeout: loop back and re-render cleanly
                continue

            if ch in [ord('q'), ord('Q')]:
                if tool_view_mode == "inspect":
                    tool_view_mode = "list"
                    runner_status_msg = ""
                else:
                    break
            elif ch == 27: # ESC key
                if tool_view_mode == "inspect":
                    tool_view_mode = "list"
                    runner_status_msg = ""
                else:
                    break
            elif ch in [ord('t'), ord('T')]:
                # Cycle theme
                if has_color:
                    current_theme_idx = (current_theme_idx + 1) % len(theme_keys)
                    apply_theme(theme_keys[current_theme_idx])
            elif selected_menu == 1:
                # Tool Runner mode controls
                if tool_view_mode == "list":
                    if ch in [curses.KEY_UP, ord('k'), ord('K')]:
                        tool_cursor = max(0, tool_cursor - 1)
                    elif ch in [curses.KEY_DOWN, ord('j'), ord('J')]:
                        tool_cursor = min(len(tools_list) - 1, tool_cursor + 1)
                    elif ch in [10, 13, ord(' '), ord('i'), ord('I')]: # Enter / Space / i
                        if tools_list:
                            inspect_tool_data = tools_list[tool_cursor]
                            tool_view_mode = "inspect"
                            runner_status_msg = ""
                    elif ch in [curses.KEY_LEFT, ord('h'), ord('H')]:
                        selected_menu = 0
                    elif ch in [ord('d'), ord('D')]: # Quick run doctor for selected tool
                        if tools_list:
                            sel = tools_list[tool_cursor]
                            curses.endwin()
                            print(f"\n{BOLD}Running diagnostics for tool: {sel.get('name', sel.get('id'))}...{RESET}\n")
                            if ORCHESTRATOR_PY.exists():
                                subprocess.run([sys.executable, str(ORCHESTRATOR_PY), "show", sel.get("id", "")])
                            input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                            stdscr.clear()
                            stdscr.refresh()
                elif tool_view_mode == "inspect":
                    if ch in [ord('b'), ord('B')]:
                        tool_view_mode = "list"
                        runner_status_msg = ""
                    elif ch in [ord('d'), ord('D')]:
                        # Run Doctor in subshell
                        curses.endwin()
                        print(f"\n{BOLD}Running diagnostics for {inspect_tool_data.get('name')}...{RESET}\n")
                        if ORCHESTRATOR_PY.exists():
                            subprocess.run([sys.executable, str(ORCHESTRATOR_PY), "show", inspect_tool_data.get("id", "")])
                        input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                        stdscr.clear()
                        stdscr.refresh()
                        runner_status_msg = f"Diagnostics executed for {inspect_tool_data.get('id')}"
                    elif ch in [ord('r'), ord('R')]:
                        # Run entrypoint in subshell
                        t_path = Path(inspect_tool_data.get("path", ""))
                        t_entries = inspect_tool_data.get("entrypoints", [])
                        curses.endwin()
                        print(f"\n{BOLD}Executing runner for {inspect_tool_data.get('name')}...{RESET}\n")
                        if t_entries and t_path.exists():
                            entry = t_entries[0]
                            entry_file = t_path / entry
                            if entry.endswith(".py"):
                                subprocess.run([sys.executable, str(entry_file)], cwd=str(t_path))
                            elif entry.endswith((".js", ".ts", ".mjs")):
                                subprocess.run(["node", str(entry_file)], cwd=str(t_path))
                            else:
                                print(f"Entrypoint is {entry}. Path: {t_path}")
                        else:
                            print(f"No direct entrypoint found or path missing: {t_path}")
                        input(f"\n{GRAY}Press Enter to return to TUI...{RESET}")
                        stdscr.clear()
                        stdscr.refresh()
                        runner_status_msg = f"Runner exited for {inspect_tool_data.get('id')}"
            else:
                # Main menu navigation
                if ch in [curses.KEY_UP, ord('k'), ord('K')]:
                    selected_menu = (selected_menu - 1) % len(menu_items)
                    runner_status_msg = ""
                elif ch in [curses.KEY_DOWN, ord('j'), ord('J')]:
                    selected_menu = (selected_menu + 1) % len(menu_items)
                    runner_status_msg = ""
                elif ch in [curses.KEY_RIGHT, ord('l'), ord('L')]:
                    if selected_menu == 1:
                        tool_view_mode = "list"
                elif ch in [10, 13, ord(' ')]: # Enter or space
                    if selected_menu == 3: # Restart
                        safe_addstr(stdscr, 10, content_x, "Restarting servers...", curses.color_pair(2) | curses.A_BOLD)
                        stdscr.refresh()
                        cmd_stop(None)
                        cmd_start(None)
                        runner_status_msg = "Servers restarted successfully on :8484, :8088, :8787."
                        time.sleep(1)
                    elif selected_menu == 4: # Toggle theme
                        if has_color:
                            current_theme_idx = (current_theme_idx + 1) % len(theme_keys)
                            apply_theme(theme_keys[current_theme_idx])
                    elif selected_menu == 5:
                        break
        except curses.error:
            pass

def cmd_tui(args):
    try:
        curses.wrapper(run_tui)
    except Exception as e:
        print(f"{RED}TUI Error: {e}{RESET}")

# ═══════════════════════════════════════════════════════════════
# CLI Entrypoint
# ═══════════════════════════════════════════════════════════════

def main():
    parser = argparse.ArgumentParser(
        prog="zoth",
        description="Zoth Studio CLI — Sovereign AI Agent & Multi-Node Orchestration Engine",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    sub = parser.add_subparsers(dest="command", help="Zoth commands")

    # zoth start
    p_start = sub.add_parser("start", help="Start all Zoth Studio servers (Web, Orchestrator, Previews)")
    p_start.set_defaults(func=cmd_start)

    # zoth stop
    p_stop = sub.add_parser("stop", help="Stop all background Zoth Studio servers")
    p_stop.set_defaults(func=cmd_stop)

    # zoth status
    p_status = sub.add_parser("status", help="Show live status of all servers and tool pipelines")
    p_status.set_defaults(func=cmd_status)

    # zoth tui / dashboard
    p_tui = sub.add_parser("tui", help="Launch interactive Terminal User Interface (TUI) cockpit")
    p_tui.set_defaults(func=cmd_tui)

    # zoth list
    p_list = sub.add_parser("list", help="List registered tools and autonomous blueprints")
    p_list.add_argument("--summary", action="store_true", help="Group by category")
    p_list.add_argument("-c", "--category", help="Filter by category")
    p_list.set_defaults(func=cmd_list)

    # zoth doctor
    p_doctor = sub.add_parser("doctor", help="Run system diagnostics, environment probes, and runtime audits")
    p_doctor.set_defaults(func=cmd_doctor)

    # zoth run
    p_run = sub.add_parser("run", help="Run a sovereign tool command or pipeline")
    p_run.add_argument("tool_id", help="Tool ID or name (e.g. local_null_ai_subsweep)")
    p_run.add_argument("--confirm", action="store_true", help="Execute tool directly (skips dry-run)")
    p_run.add_argument("tool_args", nargs=argparse.REMAINDER, help="Additional arguments to pass to the tool")
    p_run.set_defaults(func=cmd_run)

    # zoth update
    p_update = sub.add_parser("update", help="Self-update Zoth Studio to latest git commits, refresh binaries and permissions")
    p_update.add_argument("--check", action="store_true", help="Check for available updates without applying them")
    p_update.add_argument("-y", "--yes", "-u", "--unattended", "--no-prompt", dest="unattended", action="store_true", help="Run update non-interactively")
    p_update.add_argument("-b", "--branch", help="Target git branch (default: active branch or main)")
    p_update.add_argument("--remote", default="origin", help="Target git remote (default: origin)")
    p_update.add_argument("--force", action="store_true", help="Force update and overwrite local modifications")
    p_update.set_defaults(func=cmd_update)

    args = parser.parse_args()
    if not args.command:
        # Default to banner and status if no command provided
        cmd_status(args)
        print(f"\n{BOLD}Available Commands:{RESET}")
        print(f"  {CYAN}zoth tui{RESET}     Launch interactive Terminal Dashboard")
        print(f"  {CYAN}zoth start{RESET}   Start all local servers (:8484, :8088, :8787)")
        print(f"  {CYAN}zoth stop{RESET}    Stop all running servers")
        print(f"  {CYAN}zoth status{RESET}  Check active server ports and tool registry")
        print(f"  {CYAN}zoth update{RESET}  Pull latest git commits and update CLI binaries")
        print(f"  {CYAN}zoth doctor{RESET}  Run full diagnostics and runtime audits")
        print(f"  {CYAN}zoth list{RESET}    List all 298+ registered tools")
        print(f"  {CYAN}zoth run{RESET}     Run a sovereign tool command or pipeline\n")
        return 0

    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())

PET_STATE_FILE = Path.home() / ".zoth" / "active_pet.json"
FALLBACK_PET_STATE = CORE_APP_DIR / "data" / "active_pet.json"

def get_vector_memory_status() -> tuple[bool, str]:
    """Check if the Vector Memory Daemon (:8788) is bound and running."""
    is_up = check_port(8788)
    if is_up:
        return True, "BOUND [Port :8788 · Online]"
    return False, "UNBOUND [Port :8788 · Offline]"

def find_spirit(query: str) -> dict[str, Any] | None:
    """Find a spirit by ID or Name (case-insensitive fuzzy match)."""
    q = query.strip().lower()
    if not q:
        return None
    # 1. Exact ID or Name match
    for s in SOVEREIGN_SPIRITS:
        if s["id"].lower() == q or s["name"].lower() == q:
            return s
    # 2. Substring match
    for s in SOVEREIGN_SPIRITS:
        if q in s["id"].lower() or q in s["name"].lower():
            return s
    return None

def get_active_pet_id() -> str:
    """Retrieve the currently active companion pet ID."""
    for path in [PET_STATE_FILE, FALLBACK_PET_STATE]:
        if path.exists():
            try:
                data = json.loads(path.read_text(encoding="utf-8"))
                active_id = data.get("active_pet", "").lower()
                if active_id and find_spirit(active_id):
                    return active_id
            except Exception:
                pass
    return "azoth"

def get_active_spirit() -> dict[str, Any]:
    """Retrieve the active spirit dict, defaulting to Azoth."""
    active_id = get_active_pet_id()
    spirit = find_spirit(active_id)
    return spirit or SOVEREIGN_SPIRITS[0]

def set_active_pet(query: str) -> dict[str, Any] | None:
    """Set active companion pet and persist state."""
    spirit = find_spirit(query)
    if not spirit:
        return None
    data = {
        "active_pet": spirit["id"],
        "name": spirit["name"],
        "archetype": spirit["archetype"],
        "element": spirit["element"],
        "domain": spirit["domain"],
        "harness": spirit["harness"],
        "summoned_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    for path in [PET_STATE_FILE, FALLBACK_PET_STATE]:
        try:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(json.dumps(data, indent=2), encoding="utf-8")
        except Exception:
            pass
    return spirit

def cmd_pet_list(args=None):
    """List all 24 Sovereign Mascot Spirits."""
    print_banner()
    mem_bound, mem_str = get_vector_memory_status()
    mem_badge = f"{GREEN}● {mem_str}{RESET}" if mem_bound else f"{RED}○ {mem_str}{RESET}"
    active_id = get_active_pet_id()

    print(f"{BOLD}🐾 ZOTH SOVEREIGN PET DEX — 24 Autonomous Figurine Spirits{RESET}")
    print(f"  Vector Memory Engine: {mem_badge}\n")

    header = f"  {'#':<3} {'EMOJI':<5} {'NAME':<18} {'ARCHETYPE':<36} {'ELEMENT / ASPECT':<28} {'DOMAIN':<14} {'STATUS'}"
    print(f"{BOLD}{header}{RESET}")
    print(f"  {'─'*116}")

    for idx, s in enumerate(SOVEREIGN_SPIRITS, 1):
        is_active = (s["id"] == active_id)
        status_tag = f"{GOLD}{BOLD}★ [ACTIVE]{RESET}" if is_active else f"{GRAY}AVAILABLE{RESET}"
        name_padded = f"{s['name']:<18}"
        name_str = f"{BOLD}{name_padded}{RESET}" if is_active else name_padded
        arch_str = f"{s['archetype'][:34]:<36}"
        elem_str = f"{s['element'][:26]:<28}"
        domain_str = f"{s['domain'][:12]:<14}"
        print(f"  {idx:<3} {s['emoji']:<5} {name_str} {arch_str} {elem_str} {domain_str} {status_tag}")

    print(f"  {'─'*116}\n")
    print(f"  {GOLD}⚡ Quick Commands:{RESET}")
    print(f"     Summon Companion:   {CYAN}zoth pet summon <name>{RESET}  (e.g. zoth pet summon draco)")
    print(f"     Check Companion:    {CYAN}zoth pet status{RESET}")
    print(f"     Open Pet Dex TUI:   {CYAN}zoth tui{RESET} -> select '🐾 Mascot Spirits & Pet Dex'\n")

def cmd_pet_summon(args):
    """Summon and bind an active companion spirit."""
    print_banner()
    target = getattr(args, "name", "").strip()
    if not target:
        print(f"{RED}✖ Error: Please specify a spirit name or ID to summon.{RESET}")
        print(f"  Example: {CYAN}zoth pet summon draco{RESET}")
        print(f"  To see all 24 figurines: {CYAN}zoth pet list{RESET}\n")
        return 1

    spirit = set_active_pet(target)
    if not spirit:
        print(f"{RED}✖ Spirit '{target}' not found in the 24 Sovereign Figurine Spirits.{RESET}\n")
        print(f"Available Spirits: {', '.join(s['id'] for s in SOVEREIGN_SPIRITS)}\n")
        return 1

    mem_bound, mem_str = get_vector_memory_status()
    mem_badge = f"{GREEN}● {mem_str}{RESET}" if mem_bound else f"{RED}○ {mem_str}{RESET}"

    print(f"{GOLD}{BOLD}╔══════════════════════════════════════════════════════════════════════════════╗{RESET}")
    print(f"{GOLD}{BOLD}║ 🐾 SOVEREIGN FIGURINE SPIRIT SUMMONED: {spirit['emoji']} {spirit['name'].upper():<37} ║{RESET}")
    print(f"{GOLD}{BOLD}╚══════════════════════════════════════════════════════════════════════════════╝{RESET}\n")

    print(f"  {BOLD}Archetype:{RESET}      {CYAN}{spirit['archetype']}{RESET}")
    print(f"  {BOLD}Element:{RESET}        {GOLD}{spirit['element']}{RESET}")
    print(f"  {BOLD}Aspect:{RESET}         {spirit['aspect']}")
    print(f"  {BOLD}Domain:{RESET}         {spirit['domain']}  (Resonance: {GREEN}{spirit['resonance']}{RESET})")
    print(f"  {BOLD}Harness:{RESET}        {PURPLE}{spirit['harness']}{RESET}")
    print(f"  {BOLD}Vector Memory:{RESET}  {mem_badge}\n")

    print(f"  {BOLD}Soul Lore:{RESET}")
    print(f"  {GRAY}{spirit['lore']}{RESET}\n")

    print(f"  {GOLD}Invocational Dialogue:{RESET}")
    print(f"  {CYAN}\"{spirit['quote']}\"{RESET}\n")

    print(f"  {GREEN}✔ Companion '{spirit['name']}' is now active and guarding your session.{RESET}\n")
    return 0


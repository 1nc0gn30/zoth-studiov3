---
import config from '../../configs/navbars/navbar-minimalist-sidebar.json';
import BrandMark from './BrandMark.astro';

interface NavItem { label: string; url: string; type?: 'link' | 'button' | 'dropdown' }
interface NavData {
  homeUrl?: string;
  labels?: { menuToggle?: string };
  brand?: { name?: string; logoUrl?: string; fallbackIcon?: string };
  menu?: NavItem[];
  settings?: { sticky?: boolean };
}
interface Props { data?: NavData }

const { data } = Astro.props;
const navData: NavData = data ?? (config as NavData);

// Separate main links from CTA buttons for sidebar layout
const links = (navData.menu ?? []).filter((m) => m.type !== 'button');
const buttons = (navData.menu ?? []).filter((m) => m.type === 'button');

// SVG Icon Generator
const getIconSvg = (type?: string) => {
  if (type === 'button') {
    return `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>`;
  }
  return `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>`;
};
---

<header class="nav-side" data-nav-side>
  
  <aside class="nav-side__desktop">
    <div class="nav-side__desktop-inner">
      
      <BrandMark
        href={navData.homeUrl ?? '/'}
        brand={navData.brand}
        brandClass="nav-side__brand"
        logoClass="nav-side__brand-logo"
        titleClass="nav-side__brand-title"
      />

      <nav class="nav-side__links" aria-label="Primary navigation">
        {links.map((item) => (
          <a class="nav-side__link" href={item.url}>
            <span class="nav-side__icon" set:html={getIconSvg(item.type)}></span>
            <span class="nav-side__link-text">{item.label}</span>
          </a>
        ))}
      </nav>

      <div class="nav-side__ctas">
        {buttons.map((item) => (
          <a class="nav-side__cta" href={item.url}>
            <span class="nav-side__cta-text">{item.label}</span>
            <span class="nav-side__icon" set:html={getIconSvg(item.type)}></span>
          </a>
        ))}
      </div>

    </div>
  </aside>

  <div class:list={['nav-side__mobile-header', navData.settings?.sticky && 'nav-side__mobile-header--sticky']}>
    <BrandMark
      href={navData.homeUrl ?? '/'}
      brand={navData.brand}
      brandClass="nav-side__brand nav-side__brand--mobile"
      logoClass="nav-side__brand-logo"
      titleClass="nav-side__brand-title"
    />

    <button class="nav-side__toggle" type="button" aria-expanded="false" aria-label={navData.labels?.menuToggle ?? 'Open menu'} data-nav-toggle>
      <span class="nav-side__toggle-box">
        <span class="nav-side__toggle-inner"></span>
      </span>
    </button>
  </div>

  <div class="nav-side__overlay" aria-hidden="true" data-nav-overlay></div>

  <nav class="nav-side__mobile-drawer" aria-label="Mobile navigation" data-nav-drawer>
    <div class="nav-side__drawer-header">
      {navData.brand?.name && <span class="nav-side__brand-title">{navData.brand.name}</span>}
    </div>

    <div class="nav-side__drawer-links">
      {links.map((item) => (
        <a class="nav-side__mobile-link" href={item.url}>
          <span class="nav-side__link-text">{item.label}</span>
          <span class="nav-side__icon" set:html={getIconSvg(item.type)}></span>
        </a>
      ))}
    </div>

    <div class="nav-side__drawer-ctas">
      {buttons.map((item) => (
        <a class="nav-side__cta" href={item.url}>
          <span class="nav-side__cta-text">{item.label}</span>
          <span class="nav-side__icon" set:html={getIconSvg(item.type)}></span>
        </a>
      ))}
    </div>
  </nav>

</header>

<script>
  document.querySelectorAll<HTMLElement>('[data-nav-side]').forEach((root) => {
    const toggle = root.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const drawer = root.querySelector<HTMLElement>('[data-nav-drawer]');
    const overlay = root.querySelector<HTMLElement>('[data-nav-overlay]');
    
    if (!toggle || !drawer || !overlay) return;

    const closeMenu = () => {
      drawer.classList.remove('nav-side__mobile-drawer--open');
      overlay.classList.remove('nav-side__overlay--visible');
      toggle.classList.remove('nav-side__toggle--active');
      toggle.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };

    toggle.addEventListener('click', () => {
      const isOpen = drawer.classList.contains('nav-side__mobile-drawer--open');
      if (isOpen) {
        closeMenu();
      } else {
        drawer.classList.add('nav-side__mobile-drawer--open');
        overlay.classList.add('nav-side__overlay--visible');
        toggle.classList.add('nav-side__toggle--active');
        toggle.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }
    });

    overlay.addEventListener('click', closeMenu);
    
    window.addEventListener('resize', () => {
      if (window.innerWidth >= 992) closeMenu();
    });
  });
</script>

<style>
  /* --- Base & Variables --- */
  .nav-side {
    --nav-bg: color-mix(in srgb, var(--bg) 98%, var(--text) 2%);
    --nav-border: color-mix(in srgb, var(--text) 10%, transparent);
    --nav-hover-bg: color-mix(in srgb, var(--text) 5%, transparent);
    --sidebar-width: 280px;
  }

  /* =============================== */
  /* DESKTOP SIDEBAR                 */
  /* =============================== */
  .nav-side__desktop {
    position: sticky;
    top: 0;
    width: var(--sidebar-width);
    height: 100dvh;
    background: var(--nav-bg);
    border-right: 1px solid var(--nav-border);
    flex-shrink: 0; /* Prevents sidebar from squishing if parent is flex */
    z-index: 50;
  }

  .nav-side__desktop-inner {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.5rem;
  }

  /* Branding */
  .nav-side__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--text);
    margin-bottom: 3rem;
    transition: opacity 0.2s ease;
  }

  .nav-side__brand:hover {
    opacity: 0.8;
  }

  .nav-side__brand-logo {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: contain;
  }

  .nav-side__brand-title {
    font-weight: 800;
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }

  /* Links */
  .nav-side__links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nav-side__link {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: color-mix(in srgb, var(--text) 85%, transparent);
    padding: 0.75rem 1rem;
    border-radius: 12px;
    font-weight: 500;
    font-size: 0.95rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-side__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: color-mix(in srgb, var(--text) 50%, transparent);
    transition: all 0.2s ease;
  }

  .nav-side__link:hover {
    background: var(--nav-hover-bg);
    color: var(--text);
    transform: translateX(4px);
  }

  .nav-side__link:hover .nav-side__icon {
    color: var(--accent);
  }

  /* CTAs - pushed to bottom */
  .nav-side__ctas {
    margin-top: auto; /* Pushes everything below this to the bottom */
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 2rem;
    border-top: 1px solid var(--nav-border);
  }

  .nav-side__cta {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    text-decoration: none;
    background: var(--text);
    color: var(--bg);
    padding: 0.85rem 1.25rem;
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.95rem;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-side__cta .nav-side__icon {
    color: var(--bg);
    opacity: 0.8;
  }

  .nav-side__cta:hover {
    background: var(--accent);
    color: var(--bg);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -8px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .nav-side__cta:hover .nav-side__icon {
    transform: translateX(4px);
    opacity: 1;
    color: var(--bg);
  }

  /* =============================== */
  /* MOBILE HEADER & DRAWER          */
  /* =============================== */
  
  /* Hide mobile elements on desktop */
  .nav-side__mobile-header,
  .nav-side__overlay,
  .nav-side__mobile-drawer {
    display: none;
  }

  /* Responsive Breakpoint */
  @media (max-width: 991px) {
    /* Hide Desktop Sidebar */
    .nav-side__desktop {
      display: none;
    }

    /* Mobile Header */
    .nav-side__mobile-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.25rem;
      background: color-mix(in srgb, var(--bg) 85%, transparent);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--nav-border);
      z-index: 90;
    }

    .nav-side__mobile-header--sticky {
      position: sticky;
      top: 0;
    }

    .nav-side__brand--mobile {
      margin-bottom: 0; /* Reset desktop margin */
    }

    /* Mobile Hamburger Toggle */
    .nav-side__toggle {
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0.5rem;
      z-index: 102;
    }

    .nav-side__toggle-box {
      width: 24px;
      height: 24px;
      display: inline-block;
      position: relative;
    }

    .nav-side__toggle-inner {
      display: block;
      top: 50%;
      margin-top: -1px;
    }

    .nav-side__toggle-inner, 
    .nav-side__toggle-inner::before, 
    .nav-side__toggle-inner::after {
      width: 24px;
      height: 2px;
      background-color: var(--text);
      position: absolute;
      transition-property: transform;
      transition-duration: 0.2s;
      transition-timing-function: ease;
      border-radius: 4px;
    }

    .nav-side__toggle-inner::before, 
    .nav-side__toggle-inner::after {
      content: "";
      display: block;
    }

    .nav-side__toggle-inner::before { top: -8px; }
    .nav-side__toggle-inner::after { bottom: -8px; }

    /* Hamburger Active Animation */
    .nav-side__toggle--active .nav-side__toggle-inner {
      transform: rotate(45deg);
    }
    .nav-side__toggle--active .nav-side__toggle-inner::before {
      top: 0;
      opacity: 0;
    }
    .nav-side__toggle--active .nav-side__toggle-inner::after {
      bottom: 0;
      transform: rotate(-90deg);
    }

    /* Full Screen Dark Overlay */
    .nav-side__overlay {
      display: block;
      position: fixed;
      inset: 0;
      background: color-mix(in srgb, var(--text) 25%, transparent);
      backdrop-filter: blur(4px);
      z-index: 99;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }
    
    .nav-side__overlay--visible {
      opacity: 1;
      pointer-events: auto;
    }

    /* Slide-out Sidebar Drawer (Left Side) */
    .nav-side__mobile-drawer {
      display: flex;
      position: fixed;
      top: 0;
      left: -100%;
      width: min(85vw, 340px);
      height: 100dvh;
      background: var(--bg);
      border-right: 1px solid var(--nav-border);
      z-index: 101;
      flex-direction: column;
      transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
      pointer-events: auto;
      box-shadow: 20px 0 40px rgba(0,0,0,0.1);
    }

    .nav-side__mobile-drawer--open {
      left: 0;
    }

    .nav-side__drawer-header {
      padding: 1.5rem;
      border-bottom: 1px solid var(--nav-border);
      background: var(--nav-bg);
    }

    .nav-side__drawer-links {
      display: flex;
      flex-direction: column;
      padding: 1.5rem 1rem;
      gap: 0.5rem;
    }

    .nav-side__mobile-link {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      text-decoration: none;
      color: var(--text);
      padding: 1rem;
      border-radius: 12px;
      font-weight: 600;
      font-size: 1.1rem;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .nav-side__mobile-link:hover {
      background: var(--nav-hover-bg);
      border-color: var(--nav-border);
    }

    .nav-side__mobile-link .nav-side__icon {
      color: var(--accent);
    }

    .nav-side__drawer-ctas {
      margin-top: auto;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      background: var(--nav-bg);
      border-top: 1px solid var(--nav-border);
    }
  }
</style>

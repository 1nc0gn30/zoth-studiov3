---
interface HeroDiagonalButton {
  label: string;
  url: string;
  variant: 'primary' | 'secondary';
}

interface HeroDiagonalHighlight {
  title: string;
  description: string;
}

interface HeroDiagonalMedia {
  desktopSrc: string;
  mobileSrc: string;
  fallbackSrc: string;
  alt: string;
}

interface HeroDiagonalSpotlightConfig {
  eyebrow: string;
  heading: string;
  headingAccent: string;
  subtext: string;
  buttons: HeroDiagonalButton[];
  highlights: HeroDiagonalHighlight[];
  media: HeroDiagonalMedia;
}

interface Props {
  config: HeroDiagonalSpotlightConfig;
  data?: Partial<HeroDiagonalSpotlightConfig> & {
    image?: {
      src?: string;
      alt?: string;
    };
    media?: Partial<HeroDiagonalMedia> & {
      src?: string;
      alt?: string;
    };
  };
}

const { config, data = {} } = Astro.props;

const hero: HeroDiagonalSpotlightConfig = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  headingAccent: data.headingAccent ?? config.headingAccent,
  subtext: data.subtext ?? config.subtext,
  buttons: data.buttons ?? config.buttons,
  highlights: data.highlights ?? config.highlights,
  media: {
    desktopSrc: data.media?.desktopSrc ?? data.media?.src ?? data.image?.src ?? config.media.desktopSrc ?? config.media.fallbackSrc,
    mobileSrc: data.media?.mobileSrc ?? data.media?.src ?? data.image?.src ?? config.media.mobileSrc ?? config.media.desktopSrc,
    fallbackSrc: data.media?.fallbackSrc ?? data.media?.src ?? data.image?.src ?? config.media.fallbackSrc ?? config.media.desktopSrc,
    alt: data.media?.alt ?? data.image?.alt ?? config.media.alt,
  },
};
---

<section class="h9" aria-labelledby="h9-title">
  <div class="h9__spotlight" aria-hidden="true"></div>
  <div class="h9__inner">
    <div class="h9__copy h9__reveal">
      <p>{hero.eyebrow}</p>
      <h1 id="h9-title">
        {hero.heading}
        <span>{hero.headingAccent}</span>
      </h1>
      <p class="h9__subtext">{hero.subtext}</p>
      <div class="h9__actions">
        {hero.buttons.map((button) => (
          <a href={button.url} class={`h9__btn ${button.variant}`}>
            {button.label}
          </a>
        ))}
      </div>
    </div>

    <div class="h9__cards h9__reveal-delay">
      <article class="h9__media">
        <picture>
          <source media="(max-width: 767px)" srcset={hero.media.mobileSrc} />
          <img
            src={hero.media.desktopSrc}
            alt={hero.media.alt}
            loading="lazy"
            decoding="async"
            onerror={`this.onerror=null;this.src='${hero.media.fallbackSrc}'`}
          />
        </picture>
      </article>
      {hero.highlights.slice(0, 3).map((item) => (
        <article>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .h9 {
    position: relative;
    max-width: 1140px;
    margin: 0 auto;
    padding: clamp(2.6rem, 6vw, 5rem) 1rem;
    overflow: clip;
  }

  .h9__spotlight {
    position: absolute;
    right: -220px;
    top: -110px;
    width: 520px;
    height: 520px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--accentColor) 26%, transparent), transparent 62%);
    pointer-events: none;
  }

  .h9__inner {
    position: relative;
    display: grid;
    gap: 0.9rem;
    grid-template-columns: 1fr;
  }

  .h9__copy,
  .h9__cards {
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--bgColor) 95%, var(--accentColor) 5%);
    padding: clamp(1.1rem, 2.5vw, 1.9rem);
  }

  .h9__copy p {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accentColor);
    font-size: 0.8rem;
    font-weight: 700;
  }

  h1 {
    margin: 0.68rem 0 0;
    line-height: 1.04;
    letter-spacing: -0.03em;
    font-size: clamp(2rem, 5vw, 3.6rem);
    max-width: 14ch;
  }

  h1 span {
    display: block;
    background: linear-gradient(90deg, var(--accentColor), #67ddff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .h9__subtext {
    margin: 1rem 0 0;
    line-height: 1.62;
    max-width: 58ch;
    color: color-mix(in srgb, var(--textColor) 84%, transparent);
    text-transform: none;
    font-size: 1rem;
    letter-spacing: 0;
    font-weight: 400;
  }

  .h9__actions {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .h9__btn {
    text-decoration: none;
    border-radius: 10px;
    padding: 0.7rem 1rem;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .h9__btn.primary {
    background: linear-gradient(135deg, var(--accentColor), #67ddff);
    color: #fff;
    border: 1px solid color-mix(in srgb, var(--accentColor) 76%, #000 24%);
  }

  .h9__btn.secondary {
    background: transparent;
    color: var(--textColor);
    border: 1px solid color-mix(in srgb, var(--textColor) 20%, transparent);
  }

  .h9__btn:hover {
    transform: translateY(-2px);
  }

  .h9__cards {
    display: grid;
    gap: 0.55rem;
  }

  .h9__cards article {
    border: 1px solid color-mix(in srgb, var(--textColor) 10%, transparent);
    border-radius: 12px;
    padding: 0.72rem;
  }

  .h9__media {
    padding: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
  }

  .h9__media picture,
  .h9__media img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .h9__media img {
    object-fit: cover;
  }

  .h9__cards h2 {
    margin: 0;
    font-size: 1rem;
  }

  .h9__cards p {
    margin: 0.33rem 0 0;
    line-height: 1.52;
    font-size: 0.9rem;
  }

  .h9__reveal,
  .h9__reveal-delay {
    opacity: 0;
    animation: h9-fade 0.68s cubic-bezier(.22, 1, .36, 1) forwards;
  }

  .h9__reveal-delay {
    animation-delay: 0.1s;
  }

  @keyframes h9-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 980px) {
    .h9__inner {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }
</style>

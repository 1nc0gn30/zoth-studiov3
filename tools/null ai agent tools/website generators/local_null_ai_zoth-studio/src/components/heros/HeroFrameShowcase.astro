---
interface HeroFrameButton {
  label: string;
  url: string;
  variant: 'primary' | 'secondary';
}

interface HeroFrameHighlight {
  title: string;
  description: string;
}

interface HeroFrameMedia {
  desktopSrc: string;
  mobileSrc: string;
  fallbackSrc: string;
  alt: string;
}

interface HeroFrameShowcaseConfig {
  eyebrow: string;
  heading: string;
  headingAccent: string;
  subtext: string;
  proofPoints: string[];
  buttons: HeroFrameButton[];
  highlights: HeroFrameHighlight[];
  media: HeroFrameMedia;
}

interface Props {
  config: HeroFrameShowcaseConfig;
  data?: Partial<HeroFrameShowcaseConfig> & {
    image?: {
      src?: string;
      alt?: string;
    };
    media?: Partial<HeroFrameMedia> & {
      src?: string;
      alt?: string;
    };
  };
}

const { config, data = {} } = Astro.props;

const hero: HeroFrameShowcaseConfig = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  headingAccent: data.headingAccent ?? config.headingAccent,
  subtext: data.subtext ?? config.subtext,
  proofPoints: data.proofPoints ?? config.proofPoints,
  buttons: data.buttons ?? config.buttons,
  highlights: data.highlights ?? config.highlights,
  media: {
    desktopSrc: data.media?.desktopSrc ?? data.media?.src ?? data.image?.src ?? config.media.desktopSrc ?? config.media.fallbackSrc,
    mobileSrc: data.media?.mobileSrc ?? data.media?.src ?? data.image?.src ?? config.media.mobileSrc ?? config.media.desktopSrc,
    fallbackSrc: data.media?.fallbackSrc ?? data.media?.src ?? data.image?.src ?? config.media.fallbackSrc ?? config.media.desktopSrc,
    alt: data.media?.alt ?? data.image?.alt ?? config.media.alt,
  },
};
---

<section class="h3" aria-labelledby="h3-title">
  <div class="h3__shell">
    <div class="h3__copy h3__reveal">
      <p class="h3__eyebrow">{hero.eyebrow}</p>
      <h1 id="h3-title">
        {hero.heading}
        <span>{hero.headingAccent}</span>
      </h1>
      <p class="h3__subtext">{hero.subtext}</p>

      <ul class="h3__checklist">
        {hero.proofPoints.map((point) => <li>{point}</li>)}
      </ul>

      <div class="h3__actions">
        {hero.buttons.map((button) => (
          <a href={button.url} class={`h3__btn ${button.variant}`}>
            {button.label}
          </a>
        ))}
      </div>
    </div>

    <aside class="h3__frame h3__reveal-delay" aria-label="Highlights">
      <div class="h3__frame-top"></div>
      <div class="h3__media">
        <picture>
          <source media="(max-width: 767px)" srcset={hero.media.mobileSrc} />
          <img
            src={hero.media.desktopSrc}
            alt={hero.media.alt}
            loading="lazy"
            decoding="async"
            onerror={`this.onerror=null;this.src='${hero.media.fallbackSrc}'`}
          />
        </picture>
      </div>
      <div class="h3__frame-body">
        {hero.highlights.slice(0, 3).map((item) => (
          <article>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </aside>
  </div>
</section>

<style>
  .h3 {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(2.6rem, 6vw, 5.2rem) 1rem;
  }

  .h3__shell {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .h3__copy {
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: linear-gradient(160deg, color-mix(in srgb, var(--bgColor) 86%, #fff 14%), color-mix(in srgb, var(--bgColor) 94%, var(--accentColor) 6%));
    border-radius: 18px;
    padding: clamp(1.2rem, 2.5vw, 2.1rem);
    box-shadow: 0 30px 65px -56px color-mix(in srgb, var(--accentColor) 65%, #000 35%);
  }

  .h3__eyebrow {
    margin: 0;
    color: var(--accentColor);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 700;
  }

  h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(2rem, 5vw, 3.8rem);
    line-height: 1.03;
    letter-spacing: -0.03em;
    max-width: 13ch;
  }

  h1 span {
    display: block;
    background: linear-gradient(90deg, var(--accentColor), #63d7ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .h3__subtext {
    margin: 1rem 0 0;
    line-height: 1.65;
    max-width: 58ch;
  }

  .h3__checklist {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .h3__checklist li::before {
    content: '✓';
    color: var(--accentColor);
    margin-right: 0.5rem;
  }

  .h3__actions {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .h3__btn {
    text-decoration: none;
    border-radius: 10px;
    padding: 0.7rem 1rem;
    font-weight: 700;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .h3__btn.primary {
    background: linear-gradient(135deg, var(--accentColor), #63d7ff);
    color: #fff;
    border: 1px solid color-mix(in srgb, var(--accentColor) 75%, #000 25%);
    box-shadow: 0 18px 36px -24px color-mix(in srgb, var(--accentColor) 70%, #000 30%);
  }

  .h3__btn.secondary {
    background: transparent;
    color: var(--textColor);
    border: 1px solid color-mix(in srgb, var(--textColor) 20%, transparent);
  }

  .h3__btn:hover {
    transform: translateY(-2px);
  }

  .h3__frame {
    border: 1px solid color-mix(in srgb, var(--textColor) 16%, transparent);
    border-radius: 18px;
    overflow: hidden;
    background: color-mix(in srgb, var(--bgColor) 96%, transparent);
  }

  .h3__frame-top {
    height: 46px;
    background:
      radial-gradient(circle at 24px 23px, #ff6b6b 0 6px, transparent 7px),
      radial-gradient(circle at 48px 23px, #ffd166 0 6px, transparent 7px),
      radial-gradient(circle at 72px 23px, #06d6a0 0 6px, transparent 7px),
      color-mix(in srgb, var(--textColor) 4%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
  }

  .h3__media {
    border-bottom: 1px solid color-mix(in srgb, var(--textColor) 10%, transparent);
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .h3__media picture,
  .h3__media img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .h3__media img {
    object-fit: cover;
  }

  .h3__frame-body {
    display: grid;
    gap: 0.7rem;
    padding: 0.9rem;
  }

  .h3__frame-body article {
    border: 1px solid color-mix(in srgb, var(--textColor) 10%, transparent);
    border-radius: 12px;
    padding: 0.72rem;
  }

  .h3__frame-body h2 {
    margin: 0;
    font-size: 0.98rem;
  }

  .h3__frame-body p {
    margin: 0.34rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .h3__reveal,
  .h3__reveal-delay {
    opacity: 0;
    animation: h3-up 0.68s cubic-bezier(.22, 1, .36, 1) forwards;
  }

  .h3__reveal-delay {
    animation-delay: 0.1s;
  }

  @keyframes h3-up {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 980px) {
    .h3__shell {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: stretch;
    }
  }
</style>

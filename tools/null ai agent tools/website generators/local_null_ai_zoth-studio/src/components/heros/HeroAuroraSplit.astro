---
interface HeroAuroraButton {
  label: string;
  url: string;
  variant: 'primary' | 'secondary';
}

interface HeroAuroraHighlight {
  title: string;
  description: string;
}

interface HeroAuroraStat {
  label: string;
  value: string;
}

interface HeroAuroraMedia {
  desktopSrc: string;
  mobileSrc: string;
  fallbackSrc: string;
  alt: string;
}

interface HeroAuroraSplitConfig {
  eyebrow: string;
  heading: string;
  headingAccent: string;
  subtext: string;
  proofPoints: string[];
  buttons: HeroAuroraButton[];
  highlights: HeroAuroraHighlight[];
  stats: HeroAuroraStat[];
  media: HeroAuroraMedia;
}

interface Props {
  config: HeroAuroraSplitConfig;
  data?: Partial<HeroAuroraSplitConfig> & {
    image?: {
      src?: string;
      alt?: string;
    };
    media?: Partial<HeroAuroraMedia> & {
      src?: string;
      alt?: string;
    };
  };
}

const { config, data = {} } = Astro.props;

const hero: HeroAuroraSplitConfig = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  headingAccent: data.headingAccent ?? config.headingAccent,
  subtext: data.subtext ?? config.subtext,
  proofPoints: data.proofPoints ?? config.proofPoints,
  buttons: data.buttons ?? config.buttons,
  highlights: data.highlights ?? config.highlights,
  stats: data.stats ?? config.stats,
  media: {
    desktopSrc: data.media?.desktopSrc ?? data.media?.src ?? data.image?.src ?? config.media.desktopSrc ?? config.media.fallbackSrc,
    mobileSrc: data.media?.mobileSrc ?? data.media?.src ?? data.image?.src ?? config.media.mobileSrc ?? config.media.desktopSrc,
    fallbackSrc: data.media?.fallbackSrc ?? data.media?.src ?? data.image?.src ?? config.media.fallbackSrc ?? config.media.desktopSrc,
    alt: data.media?.alt ?? data.image?.alt ?? config.media.alt,
  },
};
---

<section class="aurora" aria-labelledby="aurora-title">
  <div class="aurora__bg" aria-hidden="true"></div>
  <div class="aurora__grid">
    <div class="aurora__copy aurora-reveal">
      <p class="aurora__eyebrow">{hero.eyebrow}</p>
      <h1 id="aurora-title" class="aurora__title">
        {hero.heading}
        <span>{hero.headingAccent}</span>
      </h1>
      <p class="aurora__subtext">{hero.subtext}</p>

      <ul class="aurora__points" aria-label="Key benefits">
        {hero.proofPoints.map((point) => <li>{point}</li>)}
      </ul>

      <div class="aurora__actions">
        {hero.buttons.map((button) => (
          <a class={`aurora__btn ${button.variant}`} href={button.url}>
            {button.label}
          </a>
        ))}
      </div>
    </div>

    <div class="aurora__visual aurora-reveal-delay">
      <div class="aurora__media">
        <picture>
          <source media="(max-width: 767px)" srcset={hero.media.mobileSrc} />
          <img
            src={hero.media.desktopSrc}
            alt={hero.media.alt}
            loading="lazy"
            decoding="async"
            onerror={`this.onerror=null;this.src='${hero.media.fallbackSrc}'`}
          />
        </picture>
      </div>

      <ul class="aurora__highlights" aria-label="Highlights">
        {hero.highlights.slice(0, 3).map((item) => (
          <li>
            <h2>{item.title}</h2>
            <p>{item.description}</p>
          </li>
        ))}
      </ul>

      <div class="aurora__stats" aria-label="Stats">
        {hero.stats.slice(0, 4).map((stat) => (
          <article>
            <strong>{stat.value}</strong>
            <span>{stat.label}</span>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .aurora {
    box-sizing: border-box; /* Fixes overall wrapper overflow */
    width: min(1180px, 100%);
    max-width: min(1180px, 100%);
    margin: 0 auto;
    padding: clamp(2.4rem, 6vw, 5.25rem) clamp(0.85rem, 3.6vw, 1.15rem);
    position: relative;
    overflow-x: clip;
    overflow: hidden;
    font-family: var(--fontBody, var(--fontFamily));
  }

  .aurora__bg {
    position: absolute;
    inset: 0 -15% auto;
    height: clamp(240px, 40vw, 420px);
    background:
      radial-gradient(circle at 18% 24%, color-mix(in srgb, #7be7ff 36%, transparent), transparent 45%),
      radial-gradient(circle at 78% 14%, color-mix(in srgb, var(--accentColor) 35%, transparent), transparent 50%),
      linear-gradient(180deg, color-mix(in srgb, var(--bgColor) 74%, transparent), transparent);
    filter: blur(14px);
    pointer-events: none;
  }

  .aurora__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: stretch;
  }

  .aurora__grid > * {
    min-width: 0;
  }

  .aurora__copy,
  .aurora__visual {
    box-sizing: border-box; /* Fixes inner padding overflow */
    min-width: 0;
    border: 1px solid color-mix(in srgb, var(--textColor) 14%, transparent);
    border-radius: 20px;
    background:
      linear-gradient(155deg, color-mix(in srgb, var(--bgColor) 82%, #fff 18%), color-mix(in srgb, var(--bgColor) 94%, var(--accentColor) 6%));
    padding: clamp(1.2rem, 2.8vw, 2rem);
    box-shadow: 0 36px 85px -70px color-mix(in srgb, var(--accentColor) 70%, #000 30%);
    backdrop-filter: blur(8px);
  }

  .aurora__eyebrow {
    margin: 0;
    font-size: 0.77rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }

  .aurora__title {
    margin: 0.7rem 0 0;
    line-height: 1.03;
    letter-spacing: -0.035em;
    font-size: clamp(2rem, 5.3vw, 3.9rem);
    max-width: 13.5ch;
    overflow-wrap: anywhere;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .aurora__title span {
    display: block;
    background: linear-gradient(90deg, var(--accentColor), #7be7ff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .aurora__subtext {
    margin: 1rem 0 0;
    max-width: 58ch;
    line-height: 1.66;
    color: color-mix(in srgb, var(--textColor) 84%, transparent);
    overflow-wrap: anywhere;
  }

  .aurora__points {
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.52rem;
  }

  .aurora__points li {
    color: color-mix(in srgb, var(--textColor) 86%, transparent);
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    overflow-wrap: anywhere;
    min-width: 0;
  }

  .aurora__points li::before {
    content: '◇';
    color: var(--accentColor);
  }

  .aurora__actions {
    margin-top: 1.25rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    min-width: 0;
  }

  .aurora__btn {
    box-sizing: border-box; /* Keeps 100% width on mobile clean */
    text-decoration: none;
    border-radius: 12px;
    padding: 0.72rem 1.05rem;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    white-space: normal;
    max-width: 100%;
    font-weight: 700;
    transition: transform 0.22s ease, box-shadow 0.22s ease, background-color 0.22s ease;
  }

  .aurora__btn.primary {
    background: linear-gradient(135deg, var(--accentColor), #7be7ff);
    border: 1px solid color-mix(in srgb, var(--accentColor) 78%, #000 22%);
    color: #fff;
    box-shadow: 0 18px 34px -24px color-mix(in srgb, var(--accentColor) 74%, #000 26%);
  }

  .aurora__btn.secondary {
    background: color-mix(in srgb, var(--bgColor) 86%, white 14%);
    color: var(--textColor);
    border: 1px solid color-mix(in srgb, var(--textColor) 20%, transparent);
  }

  .aurora__btn:hover {
    transform: translateY(-2px);
  }

  .aurora__btn.primary:hover {
    box-shadow: 0 24px 46px -24px color-mix(in srgb, var(--accentColor) 76%, #000 24%);
  }

  .aurora__media {
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    aspect-ratio: 16 / 10;
  }

  .aurora__media picture,
  .aurora__media img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .aurora__media img {
    object-fit: cover;
  }

  .aurora__highlights {
    margin: 0.85rem 0 0;
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .aurora__highlights li {
    box-sizing: border-box;
    border-radius: 12px;
    padding: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: color-mix(in srgb, var(--bgColor) 93%, var(--accentColor) 7%);
    min-width: 0;
  }

  .aurora__highlights h2 {
    margin: 0;
    font-size: 0.98rem;
  }

  .aurora__highlights p {
    margin: 0.35rem 0 0;
    font-size: 0.9rem;
    line-height: 1.55;
    color: color-mix(in srgb, var(--textColor) 80%, transparent);
    overflow-wrap: anywhere;
  }

  .aurora__stats {
    margin-top: 0.8rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.58rem;
  }

  .aurora__stats article {
    box-sizing: border-box;
    border-radius: 10px;
    border: 1px solid color-mix(in srgb, var(--textColor) 13%, transparent);
    background: color-mix(in srgb, var(--bgColor) 95%, var(--accentColor) 5%);
    padding: 0.7rem;
    display: grid;
    gap: 0.22rem;
    min-width: 0;
  }

  .aurora__stats strong {
    font-size: 1.05rem;
    color: var(--accentColor);
  }

  .aurora__stats span {
    font-size: 0.81rem;
    color: color-mix(in srgb, var(--textColor) 78%, transparent);
    overflow-wrap: anywhere;
  }

  .aurora-reveal,
  .aurora-reveal-delay {
    opacity: 0;
    animation: aurora-fade-up 0.72s cubic-bezier(.22, 1, .36, 1) forwards;
  }

  .aurora-reveal-delay {
    animation-delay: 0.12s;
  }

  @keyframes aurora-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 980px) {
    .aurora__grid {
      grid-template-columns: 1.15fr 0.85fr;
    }
  }

  @media (max-width: 640px) {
    .aurora {
      padding-inline: 0.8rem;
    }

    .aurora__bg {
      inset: 0 -6% auto;
    }

    .aurora__copy,
    .aurora__visual {
      padding: 1rem;
      border-radius: 16px;
    }

    .aurora__actions {
      gap: 0.5rem;
    }

    .aurora__btn {
      width: 100%;
    }
  }

  @media (max-width: 430px) {
    .aurora__stats {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 767px) {
    .aurora__bg {
      inset: 0 0 auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-reveal,
    .aurora-reveal-delay {
      opacity: 1;
      animation: none;
    }

    .aurora__btn {
      transition: none;
    }
  }
</style>
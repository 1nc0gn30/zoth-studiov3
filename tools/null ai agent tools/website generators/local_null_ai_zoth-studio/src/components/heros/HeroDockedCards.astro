---
interface HeroDockedButton {
  label: string;
  url: string;
  variant: 'primary' | 'secondary';
}

interface HeroDockedHighlight {
  title: string;
  description: string;
}

interface HeroDockedStat {
  label: string;
  value: string;
}

interface HeroDockedMedia {
  desktopSrc: string;
  mobileSrc: string;
  fallbackSrc: string;
  alt: string;
}

interface HeroDockedCardsConfig {
  eyebrow: string;
  heading: string;
  headingAccent: string;
  subtext: string;
  buttons: HeroDockedButton[];
  highlights: HeroDockedHighlight[];
  stats: HeroDockedStat[];
  media: HeroDockedMedia;
}

interface Props {
  config: HeroDockedCardsConfig;
  data?: Partial<HeroDockedCardsConfig> & {
    image?: {
      src?: string;
      alt?: string;
    };
    media?: Partial<HeroDockedMedia> & {
      src?: string;
      alt?: string;
    };
  };
}

const { config, data = {} } = Astro.props;

const hero: HeroDockedCardsConfig = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  headingAccent: data.headingAccent ?? config.headingAccent,
  subtext: data.subtext ?? config.subtext,
  buttons: data.buttons ?? config.buttons,
  highlights: data.highlights ?? config.highlights,
  stats: data.stats ?? config.stats,
  media: {
    desktopSrc: data.media?.desktopSrc ?? data.media?.src ?? data.image?.src ?? config.media.desktopSrc ?? config.media.fallbackSrc,
    mobileSrc: data.media?.mobileSrc ?? data.media?.src ?? data.image?.src ?? config.media.mobileSrc ?? config.media.desktopSrc,
    fallbackSrc: data.media?.fallbackSrc ?? data.media?.src ?? data.image?.src ?? config.media.fallbackSrc ?? config.media.desktopSrc,
    alt: data.media?.alt ?? data.image?.alt ?? config.media.alt,
  },
};
---

<section class="h6" aria-labelledby="h6-title">
  <div class="h6__hero">
    <div class="h6__copy h6__reveal">
      <p>{hero.eyebrow}</p>
      <h1 id="h6-title">
        {hero.heading}
        <span>{hero.headingAccent}</span>
      </h1>
      <p class="h6__subtext">{hero.subtext}</p>

      <div class="h6__actions">
        {hero.buttons.map((button) => (
          <a href={button.url} class={`h6__btn ${button.variant}`}>
            {button.label}
          </a>
        ))}
      </div>
    </div>

    <div class="h6__dock h6__reveal-delay">
      <div class="h6__media">
        <picture>
          <source media="(max-width: 767px)" srcset={hero.media.mobileSrc} />
          <img
            src={hero.media.desktopSrc}
            alt={hero.media.alt}
            loading="lazy"
            decoding="async"
            onerror={`this.onerror=null;this.src='${hero.media.fallbackSrc}'`}
          />
        </picture>
      </div>
      {hero.highlights.slice(0, 3).map((item) => (
        <article>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
        </article>
      ))}
    </div>
  </div>

  <div class="h6__stats" aria-label="Performance stats">
    {hero.stats.slice(0, 4).map((stat) => (
      <article>
        <strong>{stat.value}</strong>
        <span>{stat.label}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .h6 {
    max-width: 1180px;
    margin: 0 auto;
    padding: clamp(2.6rem, 6vw, 5.1rem) 1rem;
  }

  .h6__hero {
    border-radius: 20px;
    padding: clamp(1.2rem, 2.8vw, 2rem);
    border: 1px solid color-mix(in srgb, var(--textColor) 14%, transparent);
    background: color-mix(in srgb, var(--bgColor) 95%, var(--accentColor) 5%);
    display: grid;
    gap: 0.8rem;
  }

  .h6__copy p {
    margin: 0;
    color: var(--accentColor);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    font-weight: 700;
  }

  h1 {
    margin: 0.65rem 0 0;
    font-size: clamp(2rem, 5vw, 3.6rem);
    line-height: 1.03;
    max-width: 14ch;
    letter-spacing: -0.03em;
  }

  h1 span {
    display: block;
    background: linear-gradient(90deg, var(--accentColor), #65ddff);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .h6__subtext {
    margin: 1rem 0 0;
    max-width: 56ch;
    line-height: 1.64;
    color: color-mix(in srgb, var(--textColor) 84%, transparent);
    text-transform: none;
    letter-spacing: 0;
  }

  .h6__actions {
    margin-top: 1.15rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .h6__btn {
    text-decoration: none;
    border-radius: 999px;
    padding: 0.72rem 1rem;
    font-weight: 700;
    transition: transform 0.2s ease;
  }

  .h6__btn.primary {
    background: linear-gradient(135deg, var(--accentColor), #65ddff);
    color: #fff;
    border: 1px solid color-mix(in srgb, var(--accentColor) 75%, #000 25%);
  }

  .h6__btn.secondary {
    background: transparent;
    color: var(--textColor);
    border: 1px solid color-mix(in srgb, var(--textColor) 22%, transparent);
  }

  .h6__btn:hover {
    transform: translateY(-2px);
  }

  .h6__dock {
    display: grid;
    gap: 0.6rem;
  }

  .h6__media {
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
  }

  .h6__media picture,
  .h6__media img {
    width: 100%;
    height: 100%;
    display: block;
  }

  .h6__media img {
    object-fit: cover;
  }

  .h6__dock article {
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    border-radius: 12px;
    padding: 0.75rem;
    background: color-mix(in srgb, var(--bgColor) 97%, transparent);
  }

  .h6__dock h2 {
    margin: 0;
    font-size: 0.98rem;
  }

  .h6__dock p {
    margin: 0.32rem 0 0;
    font-size: 0.9rem;
    line-height: 1.53;
  }

  .h6__stats {
    margin-top: 0.9rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }

  .h6__stats article {
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    border-radius: 12px;
    padding: 0.75rem;
  }

  .h6__stats strong {
    font-size: 1.05rem;
    color: var(--accentColor);
  }

  .h6__stats span {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.82rem;
  }

  .h6__reveal,
  .h6__reveal-delay {
    opacity: 0;
    animation: h6-fade 0.7s cubic-bezier(.22, 1, .36, 1) forwards;
  }

  .h6__reveal-delay {
    animation-delay: 0.11s;
  }

  @keyframes h6-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 980px) {
    .h6__hero {
      grid-template-columns: 1.05fr 0.95fr;
      align-items: start;
    }

    .h6__dock {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .h6__media {
      grid-column: 1 / -1;
    }

    .h6__stats {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

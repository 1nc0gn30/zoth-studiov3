---
import type { BlogData } from '../../configs/blog';

interface Props {
  data?: BlogData;
  config?: BlogData;
}

const { data = {}, config = {} } = Astro.props;
const section: BlogData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  posts: data.posts ?? config.posts,
};
const posts = Array.isArray(section.posts) ? section.posts : [];
---

<section class="blog-list" aria-labelledby="blog-list-heading">
  <header>
    {section.eyebrow && <p>{section.eyebrow}</p>}
    <h2 id="blog-list-heading">{section.heading}</h2>
    {section.subtext && <p class="blog-list__subtext">{section.subtext}</p>}
  </header>

  <div class="blog-list__list">
    {posts.map((post) => (
      <article class="blog-list__card">
        {post.image && (
          <a href={post.url || '#'} class="blog-list__thumb">
            <img src={post.image} alt={post.imageAlt || post.title} loading="lazy" decoding="async" />
          </a>
        )}
        <div class="blog-list__meta">
          {post.tags && post.tags.length > 0 && (
            <div class="blog-list__tags">
              {post.tags.slice(0, 3).map((t) => (
                <span class="blog-list__tag">{t}</span>
              ))}
            </div>
          )}
          <h3><a href={post.url || '#'}>{post.title}</a></h3>
          <p class="blog-list__excerpt">{post.excerpt}</p>
          <div class="blog-list__byline">
            <span>{post.author}</span>
            <span>{post.date}</span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .blog-list {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(2.2rem, 5vw, 4rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }
  .blog-list header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }
  .blog-list h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }
  .blog-list__subtext {
    margin: 0.65rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }
  .blog-list__list {
    margin-top: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .blog-list__card {
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--bgColor) 96%, white 4%), color-mix(in srgb, var(--bgColor) 92%, var(--accentColor) 8%));
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .blog-list__thumb {
    display: block;
    aspect-ratio: 21 / 9;
    overflow: hidden;
  }
  .blog-list__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .blog-list__meta {
    padding: 1rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-list__tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }
  .blog-list__tag {
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 99px;
    background: color-mix(in srgb, var(--accentColor) 18%, transparent);
    color: var(--accentColor);
    font-weight: 700;
  }
  .blog-list__meta h3 {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.3;
    font-family: var(--fontDisplay, var(--fontFamily));
  }
  .blog-list__meta h3 a {
    color: inherit;
    text-decoration: none;
  }
  .blog-list__meta h3 a:hover {
    color: var(--accentColor);
  }
  .blog-list__excerpt {
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--textColor) 78%, transparent);
    flex: 1;
  }
  .blog-list__byline {
    margin-top: 0.6rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--textColor) 62%, transparent);
  }
  @media (min-width: 720px) {
    .blog-list__card {
      flex-direction: row;
      align-items: stretch;
    }
    .blog-list__thumb {
      aspect-ratio: auto;
      width: 240px;
      flex-shrink: 0;
    }
  }
</style>

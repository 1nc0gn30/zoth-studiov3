---
import type { CTAData } from '../../configs/cta';

interface Props {
  data?: CTAData;
  config?: CTAData;
}

const { data = {}, config = {} } = Astro.props;
const section: CTAData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  buttons: data.buttons ?? config.buttons,
  backgroundImage: data.backgroundImage ?? config.backgroundImage,
  backgroundAlt: data.backgroundAlt ?? config.backgroundAlt,
};

const hasBg = Boolean(section.backgroundImage);
---

<section class="cta-banner" aria-labelledby="cta-banner-heading" data-has-bg={hasBg ? 'true' : undefined}>
  {hasBg && (
    <div class="cta-banner__bg" aria-hidden="true">
      <img src={section.backgroundImage} alt={section.backgroundAlt || ''} loading="lazy" decoding="async" />
      <div class="cta-banner__overlay"></div>
    </div>
  )}

  <div class="cta-banner__inner">
    {section.eyebrow && <p class="cta-banner__eyebrow">{section.eyebrow}</p>}
    <h2 id="cta-banner-heading">{section.heading}</h2>
    {section.subtext && <p class="cta-banner__subtext">{section.subtext}</p>}

    {section.buttons && section.buttons.length > 0 && (
      <div class="cta-banner__actions">
        {section.buttons.map((btn) => (
          <a href={btn.url} class={`cta-banner__btn ${btn.variant ?? 'primary'}`}>{btn.label}</a>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .cta-banner {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    padding: clamp(2.5rem, 6vw, 5rem) clamp(1rem, 4vw, 2.5rem);
    border-radius: 24px;
    overflow: hidden;
    text-align: center;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--bgColor) 94%, var(--accentColor) 6%),
      color-mix(in srgb, var(--bgColor) 90%, black 10%)
    );
    border: 1px solid color-mix(in srgb, var(--textColor) 10%, transparent);
  }

  .cta-banner__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .cta-banner__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .cta-banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--bgColor) 88%, transparent),
      color-mix(in srgb, var(--bgColor) 72%, transparent)
    );
  }

  .cta-banner__inner {
    position: relative;
    z-index: 1;
    max-width: 64ch;
    margin: 0 auto;
  }

  .cta-banner__eyebrow {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }

  .cta-banner h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.6rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .cta-banner__subtext {
    margin: 0.75rem 0 0;
    line-height: 1.65;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }

  .cta-banner__actions {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    justify-content: center;
  }

  .cta-banner__btn {
    text-decoration: none;
    border-radius: 12px;
    padding: 0.75rem 1.1rem;
    font-weight: 700;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-banner__btn.primary {
    background: linear-gradient(135deg, var(--accentColor), color-mix(in srgb, var(--accentColor) 65%, #7fe4ff 35%));
    color: #fff;
    border: 1px solid color-mix(in srgb, var(--accentColor) 75%, #000 25%);
    box-shadow: 0 16px 35px -22px color-mix(in srgb, var(--accentColor) 68%, #000 32%);
  }

  .cta-banner__btn.secondary {
    background: color-mix(in srgb, var(--bgColor) 88%, white 12%);
    border: 1px solid color-mix(in srgb, var(--textColor) 22%, transparent);
    color: var(--textColor);
  }

  .cta-banner__btn.ghost {
    background: transparent;
    border: 1px solid color-mix(in srgb, var(--textColor) 28%, transparent);
    color: var(--textColor);
  }

  .cta-banner__btn:hover {
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-banner__btn {
      transition: none;
    }
  }
</style>

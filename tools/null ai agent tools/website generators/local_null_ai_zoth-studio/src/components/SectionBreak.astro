---
interface Props {
  label?: string;
}

const { label = 'Transition' } = Astro.props;
---

<div class="section-break" aria-label={label}>
  <span>{label}</span>
</div>

<style>
  .section-break {
    margin: 1.5rem auto;
    max-width: 72rem;
    padding: 0 1rem;
    text-align: center;
    color: rgba(120, 120, 120, 0.9);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .section-break span {
    display: inline-block;
    border-top: 1px solid rgba(120, 120, 120, 0.35);
    border-bottom: 1px solid rgba(120, 120, 120, 0.35);
    padding: 0.4rem 0.8rem;
  }
</style>

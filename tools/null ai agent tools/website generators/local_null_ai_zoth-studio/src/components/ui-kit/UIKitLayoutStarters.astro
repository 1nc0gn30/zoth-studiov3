---
import type { UIKitData, UIKitItem } from '../../configs/ui-kit';

interface Props {
  data?: UIKitData;
  config?: UIKitData;
}

const { data, config } = Astro.props;
const resolved = {
  ...(config ?? {}),
  ...(data ?? {}),
} as UIKitData;
const items: UIKitItem[] = Array.isArray(resolved.items) ? resolved.items : [];
const notes = Array.isArray(resolved.notes) ? resolved.notes : [];
---

<section class="ui-kit ui-kit--layouts" aria-label="Layout starter showcase">
  <header>
    {resolved.eyebrow && <p>{resolved.eyebrow}</p>}
    {resolved.heading && <h2>{resolved.heading}</h2>}
    {resolved.subtext && <span>{resolved.subtext}</span>}
  </header>

  <div class="layout-grid">
    {items.map((item) => (
      <article class="layout-card">
        <div class="layout-card__head">
          <h3>{item.title}</h3>
          {item.badge && <small>{item.badge}</small>}
        </div>
        {item.description && <p>{item.description}</p>}
        {item.meta && <strong>{item.meta}</strong>}
      </article>
    ))}
  </div>

  {notes.length > 0 && (
    <div class="layout-notes">
      {notes.map((note) => (
        <p>{note}</p>
      ))}
    </div>
  )}
</section>

<style>
  .ui-kit {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(1.8rem, 4vw, 3rem) 1rem;
    display: grid;
    gap: 1rem;
  }

  .ui-kit header p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accentColor);
    font-weight: 700;
  }

  .ui-kit h2 {
    margin: 0.45rem 0 0;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .ui-kit span {
    display: block;
    margin-top: 0.65rem;
    color: color-mix(in srgb, var(--textColor) 80%, transparent);
  }

  .layout-grid {
    display: grid;
    gap: 0.8rem;
  }

  .layout-card {
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    border-radius: 18px;
    background: color-mix(in srgb, var(--surfaceColor) 89%, white 11%);
    padding: 1rem;
  }

  .layout-card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
  }

  .layout-card h3 {
    margin: 0;
    font-size: 1.08rem;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .layout-card small {
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accentColor);
    font-weight: 700;
  }

  .layout-card p {
    margin: 0.55rem 0 0;
    color: color-mix(in srgb, var(--textColor) 78%, transparent);
  }

  .layout-card strong {
    display: inline-block;
    margin-top: 0.65rem;
    font-size: 0.74rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--textColor) 68%, transparent);
  }

  .layout-notes {
    border-left: 3px solid color-mix(in srgb, var(--accentColor) 52%, transparent);
    padding-left: 0.8rem;
    display: grid;
    gap: 0.3rem;
  }

  .layout-notes p {
    margin: 0;
    color: color-mix(in srgb, var(--textColor) 76%, transparent);
  }

  @media (min-width: 900px) {
    .layout-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

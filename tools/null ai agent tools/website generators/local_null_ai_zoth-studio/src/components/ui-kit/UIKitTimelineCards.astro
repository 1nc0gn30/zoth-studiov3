---
import type { UIKitData, UIKitItem } from '../../configs/ui-kit';

interface Props {
  data?: UIKitData;
  config?: UIKitData;
}

const { data, config } = Astro.props;
const resolved = { ...(config ?? {}), ...(data ?? {}) } as UIKitData;
const items: UIKitItem[] = Array.isArray(resolved.items) ? resolved.items : [];
---

<section class="ui-kit" aria-label="Timeline cards showcase">
  <header>
    {resolved.eyebrow && <p>{resolved.eyebrow}</p>}
    {resolved.heading && <h2>{resolved.heading}</h2>}
    {resolved.subtext && <span>{resolved.subtext}</span>}
  </header>

  <ol class="timeline">
    {items.map((item, index) => (
      <li class="timeline-item">
        <article>
          <small>{item.badge ?? `Step ${index + 1}`}</small>
          <h3>{item.title}</h3>
          {item.description && <p>{item.description}</p>}
          {item.meta && <strong>{item.meta}</strong>}
        </article>
      </li>
    ))}
  </ol>
</section>

<style>
  .ui-kit {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(1.8rem, 4vw, 3rem) 1rem;
    display: grid;
    gap: 1rem;
  }

  header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accentColor);
    font-weight: 700;
  }

  h2 {
    margin: 0.45rem 0 0;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  span {
    display: block;
    margin-top: 0.65rem;
    color: color-mix(in srgb, var(--textColor) 80%, transparent);
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }

  .timeline-item {
    position: relative;
    padding-left: 1.25rem;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: 0.3rem;
    top: 0.2rem;
    bottom: -0.95rem;
    width: 1px;
    background: color-mix(in srgb, var(--accentColor) 45%, transparent);
  }

  .timeline-item:last-child::before {
    bottom: 0.2rem;
  }

  .timeline-item article {
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: color-mix(in srgb, var(--surfaceColor) 89%, white 11%);
    padding: 0.95rem;
  }

  .timeline-item small {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accentColor);
    font-weight: 700;
  }

  .timeline-item h3 {
    margin: 0.35rem 0 0;
    font-size: 1rem;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .timeline-item p {
    margin: 0.38rem 0 0;
    color: color-mix(in srgb, var(--textColor) 76%, transparent);
  }

  .timeline-item strong {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--textColor) 70%, transparent);
  }

  @media (min-width: 900px) {
    .timeline {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>

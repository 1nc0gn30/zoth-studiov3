---
import type { UIKitData, UIKitItem } from '../../configs/ui-kit';

interface Props { data?: UIKitData; config?: UIKitData; }

const { data, config } = Astro.props;
const resolved = { ...(config ?? {}), ...(data ?? {}) } as UIKitData;
const items: UIKitItem[] = Array.isArray(resolved.items) ? resolved.items : [];
---

<section class="ui-kit" aria-label="Comparison lanes">
  <header>
    {resolved.eyebrow && <p>{resolved.eyebrow}</p>}
    {resolved.heading && <h2>{resolved.heading}</h2>}
    {resolved.subtext && <span>{resolved.subtext}</span>}
  </header>

  <div class="lanes">
    {items.map((item, index) => (
      <article class={`lane ${index === 1 ? 'lane-featured' : ''}`}>
        <h3>{item.title}</h3>
        {item.badge && <small>{item.badge}</small>}
        {item.description && <p>{item.description}</p>}
        {item.meta && <strong>{item.meta}</strong>}
      </article>
    ))}
  </div>
</section>

<style>
  .ui-kit { max-width: 1160px; margin: 0 auto; padding: clamp(1.8rem, 4vw, 3rem) 1rem; display: grid; gap: 1rem; }
  header > p { margin: 0; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accentColor); font-weight: 700; }
  h2 { margin: 0.45rem 0 0; font-size: clamp(1.5rem, 3.5vw, 2.25rem); line-height: 1.1; font-family: var(--fontDisplay, var(--fontFamily)); }
  span { display: block; margin-top: 0.65rem; color: color-mix(in srgb, var(--textColor) 80%, transparent); }
  .lanes { display: grid; gap: 0.75rem; }
  .lane { border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent); border-radius: 16px; padding: 0.95rem; background: color-mix(in srgb, var(--surfaceColor) 90%, white 10%); }
  .lane-featured { border-color: color-mix(in srgb, var(--accentColor) 45%, transparent); box-shadow: 0 18px 30px -24px color-mix(in srgb, var(--accentColor) 65%, black 35%); }
  .lane h3 { margin: 0; font-size: 1rem; font-family: var(--fontDisplay, var(--fontFamily)); }
  .lane small { display: inline-block; margin-top: 0.45rem; padding: 0.3rem 0.5rem; border-radius: 999px; background: color-mix(in srgb, var(--accentColor) 84%, black 16%); color: var(--accentContrastColor, #fff); font-size: 0.7rem; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; }
  .lane p { margin: 0.45rem 0 0; color: color-mix(in srgb, var(--textColor) 76%, transparent); }
  .lane strong { display: block; margin-top: 0.6rem; font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--textColor) 70%, transparent); }
  @media (min-width: 940px) { .lanes { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

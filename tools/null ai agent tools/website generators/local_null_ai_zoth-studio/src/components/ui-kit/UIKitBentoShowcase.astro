---
import type { UIKitData, UIKitItem } from '../../configs/ui-kit';

interface Props {
  data?: UIKitData;
  config?: UIKitData;
}

const { data, config } = Astro.props;
const resolved = { ...(config ?? {}), ...(data ?? {}) } as UIKitData;
const items: UIKitItem[] = Array.isArray(resolved.items) ? resolved.items : [];
---

<section class="ui-kit" aria-label="Bento showcase">
  <header>
    {resolved.eyebrow && <p>{resolved.eyebrow}</p>}
    {resolved.heading && <h2>{resolved.heading}</h2>}
    {resolved.subtext && <span>{resolved.subtext}</span>}
  </header>

  <div class="bento-grid">
    {items.map((item, index) => (
      <article class={`tile tile-${(index % 4) + 1}`}>
        {item.badge && <small>{item.badge}</small>}
        <h3>{item.title}</h3>
        {item.description && <p>{item.description}</p>}
        {item.meta && <strong>{item.meta}</strong>}
      </article>
    ))}
  </div>
</section>

<style>
  .ui-kit { max-width: 1160px; margin: 0 auto; padding: clamp(1.8rem, 4vw, 3rem) 1rem; display: grid; gap: 1rem; }
  header > p { margin: 0; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accentColor); font-weight: 700; }
  h2 { margin: 0.45rem 0 0; font-size: clamp(1.5rem, 3.5vw, 2.25rem); line-height: 1.1; font-family: var(--fontDisplay, var(--fontFamily)); }
  span { display: block; margin-top: 0.65rem; color: color-mix(in srgb, var(--textColor) 80%, transparent); }
  .bento-grid { display: grid; gap: 0.75rem; }
  .tile { border-radius: 18px; padding: 1rem; border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent); background: color-mix(in srgb, var(--surfaceColor) 90%, white 10%); }
  .tile-1, .tile-4 { background: linear-gradient(145deg, color-mix(in srgb, var(--accentColor) 20%, var(--surfaceColor) 80%), color-mix(in srgb, var(--surfaceColor) 92%, white 8%)); }
  .tile small { font-size: 0.71rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accentColor); font-weight: 700; }
  .tile h3 { margin: 0.36rem 0 0; font-size: 1.05rem; font-family: var(--fontDisplay, var(--fontFamily)); }
  .tile p { margin: 0.45rem 0 0; color: color-mix(in srgb, var(--textColor) 77%, transparent); }
  .tile strong { display: inline-block; margin-top: 0.6rem; font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--textColor) 68%, transparent); }
  @media (min-width: 920px) {
    .bento-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .tile-1 { grid-column: span 3; }
    .tile-2 { grid-column: span 3; }
    .tile-3 { grid-column: span 2; }
    .tile-4 { grid-column: span 4; }
  }
</style>

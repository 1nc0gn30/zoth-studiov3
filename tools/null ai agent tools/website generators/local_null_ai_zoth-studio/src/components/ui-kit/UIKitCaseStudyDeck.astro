---
import type { UIKitData, UIKitItem } from '../../configs/ui-kit';

interface Props { data?: UIKitData; config?: UIKitData; }
const { data, config } = Astro.props;
const resolved = { ...(config ?? {}), ...(data ?? {}) } as UIKitData;
const items: UIKitItem[] = Array.isArray(resolved.items) ? resolved.items : [];
---

<section class="ui-kit" aria-label="Case study deck">
  <header>
    {resolved.eyebrow && <p>{resolved.eyebrow}</p>}
    {resolved.heading && <h2>{resolved.heading}</h2>}
    {resolved.subtext && <span>{resolved.subtext}</span>}
  </header>

  <div class="deck">
    {items.map((item) => (
      <article class="case-card">
        <div>
          <h3>{item.title}</h3>
          {item.description && <p>{item.description}</p>}
        </div>
        <footer>
          {item.badge && <small>{item.badge}</small>}
          {item.meta && <strong>{item.meta}</strong>}
        </footer>
      </article>
    ))}
  </div>
</section>

<style>
  .ui-kit { max-width: 1160px; margin: 0 auto; padding: clamp(1.8rem, 4vw, 3rem) 1rem; display: grid; gap: 1rem; }
  header > p { margin: 0; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accentColor); font-weight: 700; }
  h2 { margin: 0.45rem 0 0; font-size: clamp(1.5rem, 3.5vw, 2.25rem); line-height: 1.1; font-family: var(--fontDisplay, var(--fontFamily)); }
  span { display: block; margin-top: 0.65rem; color: color-mix(in srgb, var(--textColor) 80%, transparent); }
  .deck { display: grid; gap: 0.75rem; }
  .case-card { border-radius: 18px; border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent); background: color-mix(in srgb, var(--surfaceColor) 90%, white 10%); padding: 1rem; display: grid; gap: 0.6rem; }
  .case-card h3 { margin: 0; font-size: 1.05rem; font-family: var(--fontDisplay, var(--fontFamily)); }
  .case-card p { margin: 0.45rem 0 0; color: color-mix(in srgb, var(--textColor) 77%, transparent); }
  .case-card footer { display: flex; justify-content: space-between; gap: 0.45rem; align-items: center; }
  .case-card small { font-size: 0.71rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--accentColor); font-weight: 700; }
  .case-card strong { font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--textColor) 67%, transparent); }
  @media (min-width: 940px) { .deck { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>

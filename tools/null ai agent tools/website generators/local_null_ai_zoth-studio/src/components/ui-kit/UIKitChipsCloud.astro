---
import type { UIKitData, UIKitItem } from '../../configs/ui-kit';

interface Props {
  data?: UIKitData;
  config?: UIKitData;
}

const { data, config } = Astro.props;
const resolved = {
  ...(config ?? {}),
  ...(data ?? {}),
} as UIKitData;
const items: UIKitItem[] = Array.isArray(resolved.items) ? resolved.items : [];
---

<section class="ui-kit ui-kit--chips" aria-label="Chip styles showcase">
  <header>
    {resolved.eyebrow && <p>{resolved.eyebrow}</p>}
    {resolved.heading && <h2>{resolved.heading}</h2>}
    {resolved.subtext && <span>{resolved.subtext}</span>}
  </header>

  <div class="chip-cloud">
    {items.map((item) => (
      <div class={`chip chip--${item.badge ?? 'neutral'}`}>
        <strong>{item.title}</strong>
        {item.meta && <small>{item.meta}</small>}
      </div>
    ))}
  </div>
</section>

<style>
  .ui-kit {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(1.8rem, 4vw, 3rem) 1rem;
    display: grid;
    gap: 1rem;
  }

  .ui-kit header p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accentColor);
    font-weight: 700;
  }

  .ui-kit h2 {
    margin: 0.45rem 0 0;
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .ui-kit span {
    display: block;
    margin-top: 0.65rem;
    color: color-mix(in srgb, var(--textColor) 80%, transparent);
  }

  .chip-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .chip {
    border-radius: 999px;
    padding: 0.4rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
  }

  .chip strong {
    font-size: 0.82rem;
  }

  .chip small {
    color: color-mix(in srgb, var(--textColor) 72%, transparent);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
  }

  .chip--solid {
    background: color-mix(in srgb, var(--accentColor) 88%, black 12%);
    color: var(--accentContrastColor, #fff);
    border-color: transparent;
  }

  .chip--soft {
    background: color-mix(in srgb, var(--accentColor) 17%, transparent);
    color: var(--accentColor);
  }

  .chip--outline {
    color: var(--textColor);
    border-color: color-mix(in srgb, var(--accentColor) 45%, transparent);
  }

  .chip--danger {
    background: color-mix(in srgb, #c62828 16%, transparent);
    color: #b71c1c;
    border-color: color-mix(in srgb, #c62828 35%, transparent);
  }

  .chip--accent {
    background: linear-gradient(135deg, color-mix(in srgb, var(--accentColor) 22%, transparent), color-mix(in srgb, var(--accentColor) 8%, white 92%));
    color: var(--textColor);
  }
</style>

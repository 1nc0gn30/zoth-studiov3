---
import type { UIKitData, UIKitItem } from '../../configs/ui-kit';

interface Props { data?: UIKitData; config?: UIKitData; }
const { data, config } = Astro.props;
const resolved = { ...(config ?? {}), ...(data ?? {}) } as UIKitData;
const items: UIKitItem[] = Array.isArray(resolved.items) ? resolved.items : [];
---

<section class="ui-kit" aria-label="Command panel">
  <header>
    {resolved.eyebrow && <p>{resolved.eyebrow}</p>}
    {resolved.heading && <h2>{resolved.heading}</h2>}
    {resolved.subtext && <span>{resolved.subtext}</span>}
  </header>

  <div class="terminal-shell">
    {items.map((item) => (
      <div class="cmd-row">
        <code>{item.title}</code>
        <div>
          {item.badge && <small>{item.badge}</small>}
          {item.meta && <strong>{item.meta}</strong>}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .ui-kit { max-width: 1160px; margin: 0 auto; padding: clamp(1.8rem, 4vw, 3rem) 1rem; display: grid; gap: 1rem; }
  header > p { margin: 0; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accentColor); font-weight: 700; }
  h2 { margin: 0.45rem 0 0; font-size: clamp(1.5rem, 3.5vw, 2.25rem); line-height: 1.1; font-family: var(--fontDisplay, var(--fontFamily)); }
  span { display: block; margin-top: 0.65rem; color: color-mix(in srgb, var(--textColor) 80%, transparent); }
  .terminal-shell { border-radius: 16px; border: 1px solid color-mix(in srgb, var(--accentColor) 35%, transparent); background: color-mix(in srgb, var(--bgColor) 94%, black 6%); padding: 0.55rem; display: grid; gap: 0.45rem; }
  .cmd-row { display: flex; justify-content: space-between; gap: 0.6rem; align-items: center; border-radius: 10px; background: color-mix(in srgb, var(--surfaceColor) 86%, white 14%); padding: 0.55rem 0.65rem; }
  .cmd-row code { font-size: 0.82rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cmd-row div { display: flex; gap: 0.45rem; align-items: center; }
  .cmd-row small { padding: 0.26rem 0.45rem; border-radius: 999px; font-size: 0.68rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accentContrastColor, #fff); background: color-mix(in srgb, var(--accentColor) 86%, black 14%); font-weight: 700; }
  .cmd-row strong { font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase; color: color-mix(in srgb, var(--textColor) 68%, transparent); }
</style>

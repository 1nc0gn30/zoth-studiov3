---
interface FormCapsuleInlineField {
  type: 'text' | 'email' | 'tel';
  label: string;
  placeholder: string;
  required: boolean;
}

interface FormCapsuleInlineConfig {
  title: string;
  description: string;
  fields: FormCapsuleInlineField[];
  submitButtonText: string;
}

interface Props {
  config: FormCapsuleInlineConfig;
}

const { config } = Astro.props as Props;
---
<section class="f06" aria-labelledby="f06-title">
  <h2 id="f06-title">{config.title}</h2>
  <p>{config.description}</p>
  <form action="#" method="post">
    {config.fields.map((field) => (
      <label>
        <span>{field.label}</span>
        <input type={field.type} name={field.label.toLowerCase().replace(/\s+/g, '-')} required={field.required} placeholder={field.placeholder} />
      </label>
    ))}
    <button type="submit">{config.submitButtonText}</button>
  </form>
</section>
<style>
.f06 {
  max-width: 1000px;
  margin: 0 auto;
  padding: clamp(1.7rem, 2.4vw, 2.5rem) 1rem;
}
h2 {
  margin: 0;
  font-size: clamp(1.35rem, 3.2vw, 2rem);
}
p {
  margin: 0.55rem 0 0.9rem;
  line-height: 1.6;
  color: color-mix(in srgb, var(--textColor) 80%, transparent);
}
form {
  display: grid;
  gap: 0.62rem;
  grid-template-columns: 1fr;
  background: color-mix(in srgb, var(--bgColor) 95%, var(--accentColor) 5%);
  border: 1px solid color-mix(in srgb, var(--textColor) 14%, transparent);
  border-radius: 18px;
  padding: 0.65rem;
}
label {
  display: grid;
  gap: 0.22rem;
  padding: 0.45rem 0.55rem;
  border-radius: 12px;
  background: var(--bgColor);
}
span {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: color-mix(in srgb, var(--textColor) 70%, transparent);
}
input {
  border: 0;
  background: transparent;
  padding: 0.06rem 0.2rem 0.22rem;
  color: var(--textColor);
}
input:focus-visible {
  outline: none;
}
label:focus-within {
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 20%, transparent);
}
button {
  border: 0;
  border-radius: 12px;
  padding: 0.72rem 1rem;
  background: linear-gradient(125deg, var(--accentColor), color-mix(in srgb, var(--accentColor) 62%, black 38%));
  color: #fff;
  font-weight: 700;
  transition: transform 180ms ease, box-shadow 180ms ease;
}
button:hover {
  transform: translateY(-1px);
  box-shadow: 0 10px 18px -12px color-mix(in srgb, var(--accentColor) 72%, black 28%);
}
button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 28%, transparent);
}
@media (min-width: 860px) {
  form {
    grid-template-columns: repeat(3, minmax(0, 1fr)) auto;
    align-items: end;
  }
  button {
    height: 100%;
    white-space: nowrap;
  }
}
</style>

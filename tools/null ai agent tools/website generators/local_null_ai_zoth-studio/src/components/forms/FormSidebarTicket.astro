---
interface FormSidebarTicketField {
  type: 'text' | 'email' | 'tel' | 'textarea';
  label: string;
  placeholder: string;
  required: boolean;
}

interface FormSidebarTicketConfig {
  eyebrow: string;
  title: string;
  description: string;
  note: string;
  fields: FormSidebarTicketField[];
  submitButtonText: string;
}

interface Props {
  config: FormSidebarTicketConfig;
}

const { config } = Astro.props as Props;
---
<section class="f04" aria-labelledby="f04-title">
  <aside>
    <p>{config.eyebrow}</p>
    <h2 id="f04-title">{config.title}</h2>
    <p class="desc">{config.description}</p>
    <p class="note">{config.note}</p>
  </aside>
  <form action="#" method="post">
    {config.fields.map((field) => (
      <label>
        <span>{field.label}</span>
        {field.type === 'textarea' ? <textarea name={field.label.toLowerCase().replace(/\s+/g, '-')} required={field.required} placeholder={field.placeholder}></textarea> : <input type={field.type} name={field.label.toLowerCase().replace(/\s+/g, '-')} required={field.required} placeholder={field.placeholder} />}
      </label>
    ))}
    <button type="submit">{config.submitButtonText}</button>
  </form>
</section>
<style>
.f04 {
  max-width: 1080px;
  margin: 0 auto;
  padding: clamp(1.8rem, 2.8vw, 2.7rem) 1rem;
  display: grid;
  gap: 1rem;
}
aside,
form {
  border: 1px solid color-mix(in srgb, var(--textColor) 14%, transparent);
  border-radius: 18px;
  padding: 1rem;
}
aside {
  background: color-mix(in srgb, var(--bgColor) 93%, var(--accentColor) 7%);
}
aside > p:first-child {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.78rem;
  color: var(--accentColor);
  font-weight: 700;
}
h2 {
  margin: 0.45rem 0 0;
  font-size: clamp(1.4rem, 3.2vw, 2rem);
}
.desc {
  margin: 0.65rem 0 0;
  line-height: 1.65;
}
.note {
  margin: 0.75rem 0 0;
  padding: 0.6rem 0.65rem;
  border-radius: 10px;
  background: color-mix(in srgb, var(--accentColor) 14%, transparent);
  font-size: 0.9rem;
}
form {
  display: grid;
  gap: 0.68rem;
  background: var(--bgColor);
}
label {
  display: grid;
  gap: 0.3rem;
}
span {
  font-size: 0.88rem;
  font-weight: 600;
}
input,
textarea {
  width: 100%;
  padding: 0.68rem 0.74rem;
  border-radius: 10px;
  border: 1px solid color-mix(in srgb, var(--textColor) 20%, transparent);
  background: var(--bgColor);
  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
}
input:hover,
textarea:hover {
  border-color: color-mix(in srgb, var(--accentColor) 52%, transparent);
}
input:focus-visible,
textarea:focus-visible {
  outline: none;
  border-color: color-mix(in srgb, var(--accentColor) 75%, transparent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 26%, transparent);
  transform: translateY(-1px);
}
textarea {
  min-height: 125px;
  resize: vertical;
}
button {
  border: 0;
  border-radius: 10px;
  padding: 0.72rem 0.95rem;
  background: linear-gradient(120deg, var(--accentColor), color-mix(in srgb, var(--accentColor) 64%, black 36%));
  color: #fff;
  font-weight: 700;
  transition: transform 180ms ease, box-shadow 180ms ease;
}
button:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 22px -15px color-mix(in srgb, var(--accentColor) 78%, black 22%);
}
button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 28%, transparent);
}
@media (min-width: 940px) {
  .f04 {
    grid-template-columns: 0.85fr 1.15fr;
  }
}
</style>

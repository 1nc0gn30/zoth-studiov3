---
interface FormMonoStackField {
  type: 'text' | 'email' | 'tel' | 'textarea';
  label: string;
  placeholder: string;
  required: boolean;
}

interface FormMonoStackConfig {
  title: string;
  description: string;
  note: string;
  fields: FormMonoStackField[];
  submitButtonText: string;
}

interface Props {
  config: FormMonoStackConfig;
}

const { config } = Astro.props as Props;
---
<section class="f09" aria-labelledby="f09-title">
  <form action="#" method="post">
    <h2 id="f09-title">{config.title}</h2>
    <p>{config.description}</p>
    {config.fields.map((field) => (
      <label>
        <span>{field.label}</span>
        {field.type === 'textarea' ? <textarea name={field.label.toLowerCase().replace(/\s+/g, '-')} required={field.required} placeholder={field.placeholder}></textarea> : <input type={field.type} name={field.label.toLowerCase().replace(/\s+/g, '-')} required={field.required} placeholder={field.placeholder} />}
      </label>
    ))}
    <small>{config.note}</small>
    <button type="submit">{config.submitButtonText}</button>
  </form>
</section>
<style>
.f09 {
  max-width: 700px;
  margin: 0 auto;
  padding: clamp(1.8rem, 2.6vw, 2.5rem) 1rem;
}
form {
  display: grid;
  gap: 0.7rem;
  border: 2px solid var(--textColor);
  padding: 1rem;
  border-radius: 8px;
  background: var(--bgColor);
}
h2 {
  margin: 0;
  font-size: clamp(1.3rem, 3vw, 1.9rem);
}
p {
  margin: 0;
  line-height: 1.6;
}
label {
  display: grid;
  gap: 0.22rem;
}
span {
  font-family: monospace;
  font-size: 0.82rem;
}
input,
textarea {
  padding: 0.62rem 0.68rem;
  border: 1px solid var(--textColor);
  border-radius: 4px;
  background: transparent;
  color: var(--textColor);
  font-family: monospace;
  transition: box-shadow 180ms ease, transform 180ms ease, border-color 180ms ease;
}
input:focus-visible,
textarea:focus-visible {
  outline: none;
  border-color: var(--accentColor);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 24%, transparent);
  transform: translateY(-1px);
}
textarea {
  min-height: 110px;
  resize: vertical;
}
small {
  font-size: 0.8rem;
  opacity: 0.8;
}
button {
  border: 1px solid var(--textColor);
  border-radius: 4px;
  padding: 0.67rem 0.94rem;
  background: var(--textColor);
  color: var(--bgColor);
  font-family: monospace;
  font-weight: 700;
  transition: transform 180ms ease, filter 180ms ease;
}
button:hover {
  transform: translateY(-1px);
  filter: brightness(1.06);
}
button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 26%, transparent);
}
</style>

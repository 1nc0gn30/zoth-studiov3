---
interface FormGlassFloatField {
  type: 'text' | 'email' | 'tel' | 'textarea';
  label: string;
  placeholder: string;
  required: boolean;
}

interface FormGlassFloatConfig {
  eyebrow: string;
  title: string;
  description: string;
  fields: FormGlassFloatField[];
  submitButtonText: string;
}

interface Props {
  config: FormGlassFloatConfig;
}

const { config } = Astro.props as Props;
---
<section class="f05" aria-labelledby="f05-title">
  <div class="blob" aria-hidden="true"></div>
  <form action="#" method="post">
    <p>{config.eyebrow}</p>
    <h2 id="f05-title">{config.title}</h2>
    <small>{config.description}</small>
    {config.fields.map((field) => (
      <label>
        <span>{field.label}</span>
        {field.type === 'textarea' ? <textarea name={field.label.toLowerCase().replace(/\s+/g, '-')} required={field.required} placeholder={field.placeholder}></textarea> : <input type={field.type} name={field.label.toLowerCase().replace(/\s+/g, '-')} required={field.required} placeholder={field.placeholder} />}
      </label>
    ))}
    <button type="submit">{config.submitButtonText}</button>
  </form>
</section>
<style>
.f05 {
  position: relative;
  max-width: 780px;
  margin: 0 auto;
  padding: clamp(2rem, 2.9vw, 2.9rem) 1rem;
  overflow: clip;
}
.blob {
  position: absolute;
  right: -120px;
  top: -50px;
  width: 300px;
  height: 300px;
  border-radius: 50%;
  background: radial-gradient(circle, color-mix(in srgb, var(--accentColor) 24%, transparent), transparent 62%);
}
form {
  position: relative;
  border: 1px solid color-mix(in srgb, var(--textColor) 16%, transparent);
  border-radius: 18px;
  padding: 1rem;
  background: color-mix(in srgb, var(--bgColor) 78%, transparent);
  backdrop-filter: blur(14px);
  display: grid;
  gap: 0.65rem;
  box-shadow: 0 18px 36px -24px color-mix(in srgb, var(--accentColor) 64%, black 36%);
}
p {
  margin: 0;
  font-size: 0.78rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--accentColor);
  font-weight: 700;
}
h2 {
  margin: 0.4rem 0 0;
  font-size: clamp(1.35rem, 3.4vw, 2.1rem);
}
small {
  display: block;
  margin: 0.52rem 0 0;
  line-height: 1.6;
}
label {
  display: grid;
  gap: 0.3rem;
}
span {
  font-size: 0.88rem;
  font-weight: 600;
}
input,
textarea {
  width: 100%;
  padding: 0.66rem 0.74rem;
  border-radius: 10px;
  border: 1px solid color-mix(in srgb, var(--textColor) 22%, transparent);
  background: color-mix(in srgb, var(--bgColor) 96%, transparent);
  transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
}
input:hover,
textarea:hover {
  border-color: color-mix(in srgb, var(--accentColor) 50%, transparent);
}
input:focus-visible,
textarea:focus-visible {
  outline: none;
  border-color: color-mix(in srgb, var(--accentColor) 76%, transparent);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 26%, transparent);
  transform: translateY(-1px);
}
textarea {
  min-height: 118px;
  resize: vertical;
}
button {
  margin-top: 0.25rem;
  border: 0;
  border-radius: 10px;
  padding: 0.7rem 1rem;
  background: linear-gradient(120deg, var(--textColor), color-mix(in srgb, var(--textColor) 74%, var(--accentColor) 26%));
  color: var(--bgColor);
  font-weight: 700;
  transition: transform 180ms ease, box-shadow 180ms ease;
}
button:hover {
  transform: translateY(-1px);
  box-shadow: 0 12px 22px -14px color-mix(in srgb, var(--textColor) 74%, transparent);
}
button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 26%, transparent);
}
</style>

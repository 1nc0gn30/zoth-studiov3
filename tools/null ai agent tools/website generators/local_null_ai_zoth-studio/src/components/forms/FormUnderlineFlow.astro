---
interface FormUnderlineFlowField {
  type: 'text' | 'email' | 'tel' | 'textarea';
  label: string;
  placeholder: string;
  required: boolean;
}

interface FormUnderlineFlowConfig {
  title: string;
  description: string;
  fields: FormUnderlineFlowField[];
  submitButtonText: string;
}

interface Props {
  config: FormUnderlineFlowConfig;
}

const { config } = Astro.props as Props;
---
<section class="f03" aria-labelledby="f03-title">
  <h2 id="f03-title">{config.title}</h2>
  <p>{config.description}</p>
  <form action="#" method="post">
    {config.fields.map((field) => (
      <label>
        <span>{field.label}</span>
        {field.type === 'textarea' ? <textarea name={field.label.toLowerCase().replace(/\s+/g, '-')} placeholder={field.placeholder} required={field.required}></textarea> : <input type={field.type} name={field.label.toLowerCase().replace(/\s+/g, '-')} placeholder={field.placeholder} required={field.required} />}
      </label>
    ))}
    <button type="submit">{config.submitButtonText}</button>
  </form>
</section>
<style>
.f03 {
  max-width: 780px;
  margin: 0 auto;
  padding: clamp(1.8rem, 2.6vw, 2.6rem) 1rem;
}
h2 {
  margin: 0;
  font-size: clamp(1.45rem, 3.6vw, 2.2rem);
}
p {
  margin: 0.6rem 0 0;
  line-height: 1.65;
  color: color-mix(in srgb, var(--textColor) 80%, transparent);
}
form {
  margin-top: 1rem;
  display: grid;
  gap: 0.85rem;
}
label {
  display: grid;
  gap: 0.28rem;
}
span {
  font-size: 0.82rem;
  text-transform: uppercase;
  letter-spacing: 0.09em;
  color: color-mix(in srgb, var(--textColor) 72%, transparent);
}
input,
textarea {
  border: 0;
  border-bottom: 2px solid color-mix(in srgb, var(--textColor) 26%, transparent);
  padding: 0.72rem 0.2rem;
  background: transparent;
  color: var(--textColor);
  transition: border-color 180ms ease, box-shadow 180ms ease;
}
input:hover,
textarea:hover {
  border-color: color-mix(in srgb, var(--accentColor) 50%, transparent);
}
input:focus-visible,
textarea:focus-visible {
  outline: none;
  border-color: var(--accentColor);
  box-shadow: 0 10px 0 -8px color-mix(in srgb, var(--accentColor) 30%, transparent);
}
textarea {
  min-height: 120px;
  resize: vertical;
}
button {
  justify-self: start;
  border: 1px solid var(--accentColor);
  background: transparent;
  color: var(--accentColor);
  border-radius: 999px;
  padding: 0.6rem 1.1rem;
  font-weight: 700;
  transition: background-color 180ms ease, color 180ms ease, transform 180ms ease;
}
button:hover {
  background: var(--accentColor);
  color: #fff;
  transform: translateY(-1px);
}
button:focus-visible {
  outline: none;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--accentColor) 28%, transparent);
}
</style>

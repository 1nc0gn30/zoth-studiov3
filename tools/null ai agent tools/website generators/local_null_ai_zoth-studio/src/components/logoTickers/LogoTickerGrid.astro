---
import type { LogoTickerData } from '../../configs/logoTicker';

interface Props {
  data?: LogoTickerData;
  config?: LogoTickerData;
}

const { data = {}, config = {} } = Astro.props;
const section: LogoTickerData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  items: data.items ?? config.items,
};
const items = Array.isArray(section.items) ? section.items : [];
---

<section class="logo-ticker-grid" aria-labelledby="logo-ticker-grid-heading">
  <header>
    {section.eyebrow && <p>{section.eyebrow}</p>}
    <h2 id="logo-ticker-grid-heading">{section.heading}</h2>
    {section.subtext && <p class="logo-ticker-grid__subtext">{section.subtext}</p>}
  </header>

  <div class="logo-ticker-grid__list" role="list" aria-label="Partner logos">
    {items.map((logo) => (
      <article class="logo-ticker-grid__card" role="listitem">
        {logo.url ? (
          <a href={logo.url} target="_blank" rel="noopener noreferrer" aria-label={logo.alt || logo.name}>
            <img src={logo.src} alt={logo.alt || logo.name} loading="lazy" decoding="async" />
          </a>
        ) : (
          <img src={logo.src} alt={logo.alt || logo.name} loading="lazy" decoding="async" />
        )}
        <span class="logo-ticker-grid__name">{logo.name}</span>
      </article>
    ))}
  </div>
</section>

<style>
  .logo-ticker-grid {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(2.2rem, 5vw, 4rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }

  .logo-ticker-grid header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }

  .logo-ticker-grid h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .logo-ticker-grid__subtext {
    margin: 0.65rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }

  .logo-ticker-grid__list {
    margin-top: 1.6rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .logo-ticker-grid__card {
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bgColor) 96%, white 4%),
      color-mix(in srgb, var(--bgColor) 92%, var(--accentColor) 8%)
    );
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    text-align: center;
    min-height: 120px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .logo-ticker-grid__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 28px -18px color-mix(in srgb, var(--accentColor) 55%, black 45%);
  }

  .logo-ticker-grid__card img {
    height: clamp(28px, 4vw, 40px);
    width: auto;
    max-width: 120px;
    object-fit: contain;
    filter: grayscale(100%) brightness(1.1);
    opacity: 0.85;
    transition: filter 0.25s ease, opacity 0.25s ease;
  }

  .logo-ticker-grid__card a:hover img,
  .logo-ticker-grid__card:hover img {
    filter: grayscale(0%) brightness(1);
    opacity: 1;
  }

  .logo-ticker-grid__name {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--textColor) 72%, transparent);
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .logo-ticker-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .logo-ticker-grid__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-ticker-grid__card {
      transition: none;
    }
  }
</style>

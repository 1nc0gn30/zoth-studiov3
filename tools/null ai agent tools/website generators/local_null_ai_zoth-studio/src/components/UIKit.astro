---
import type { UIKitData } from '../configs/ui-kit';
import uiKitButtonsMatrixConfig from '../configs/ui-kit/ui-kit-buttons-matrix.json';
import uiKitButtonsStackConfig from '../configs/ui-kit/ui-kit-buttons-stack.json';
import uiKitChipsCloudConfig from '../configs/ui-kit/ui-kit-chips-cloud.json';
import uiKitChipsRailConfig from '../configs/ui-kit/ui-kit-chips-rail.json';
import uiKitHeroCanvasConfig from '../configs/ui-kit/ui-kit-hero-canvas.json';
import uiKitGalleryMasonryConfig from '../configs/ui-kit/ui-kit-gallery-masonry.json';
import uiKitLayoutStartersConfig from '../configs/ui-kit/ui-kit-layout-starters.json';
import uiKitLayoutOrchestraConfig from '../configs/ui-kit/ui-kit-layout-orchestra.json';
import uiKitTestimonialsWallConfig from '../configs/ui-kit/ui-kit-testimonials-wall.json';
import uiKitPricingDeckConfig from '../configs/ui-kit/ui-kit-pricing-deck.json';
import uiKitFaqAccordionConfig from '../configs/ui-kit/ui-kit-faq-accordion.json';
import uiKitStatsRibbonConfig from '../configs/ui-kit/ui-kit-stats-ribbon.json';
import uiKitFeatureMatrixConfig from '../configs/ui-kit/ui-kit-feature-matrix.json';
import uiKitTimelineCardsConfig from '../configs/ui-kit/ui-kit-timeline-cards.json';
import uiKitLogoTickerConfig from '../configs/ui-kit/ui-kit-logo-ticker.json';
import uiKitBentoShowcaseConfig from '../configs/ui-kit/ui-kit-bento-showcase.json';
import uiKitComparisonLanesConfig from '../configs/ui-kit/ui-kit-comparison-lanes.json';
import uiKitCaseStudyDeckConfig from '../configs/ui-kit/ui-kit-case-study-deck.json';
import uiKitCommandPanelConfig from '../configs/ui-kit/ui-kit-command-panel.json';
import UIKitButtonsMatrix from './ui-kit/UIKitButtonsMatrix.astro';
import UIKitButtonsStack from './ui-kit/UIKitButtonsStack.astro';
import UIKitChipsCloud from './ui-kit/UIKitChipsCloud.astro';
import UIKitChipsRail from './ui-kit/UIKitChipsRail.astro';
import UIKitHeroCanvas from './ui-kit/UIKitHeroCanvas.astro';
import UIKitGalleryMasonry from './ui-kit/UIKitGalleryMasonry.astro';
import UIKitLayoutStarters from './ui-kit/UIKitLayoutStarters.astro';
import UIKitLayoutOrchestra from './ui-kit/UIKitLayoutOrchestra.astro';
import UIKitTestimonialsWall from './ui-kit/UIKitTestimonialsWall.astro';
import UIKitPricingDeck from './ui-kit/UIKitPricingDeck.astro';
import UIKitFaqAccordion from './ui-kit/UIKitFaqAccordion.astro';
import UIKitStatsRibbon from './ui-kit/UIKitStatsRibbon.astro';
import UIKitFeatureMatrix from './ui-kit/UIKitFeatureMatrix.astro';
import UIKitTimelineCards from './ui-kit/UIKitTimelineCards.astro';
import UIKitLogoTicker from './ui-kit/UIKitLogoTicker.astro';
import UIKitBentoShowcase from './ui-kit/UIKitBentoShowcase.astro';
import UIKitComparisonLanes from './ui-kit/UIKitComparisonLanes.astro';
import UIKitCaseStudyDeck from './ui-kit/UIKitCaseStudyDeck.astro';
import UIKitCommandPanel from './ui-kit/UIKitCommandPanel.astro';

interface Props {
  data?: UIKitData;
  cvariant?: string;
}

const { data, cvariant } = Astro.props;

const variants = {
  buttons: UIKitButtonsMatrix,
  'buttons-stack': UIKitButtonsStack,
  chips: UIKitChipsCloud,
  'chips-rail': UIKitChipsRail,
  hero: UIKitHeroCanvas,
  gallery: UIKitGalleryMasonry,
  layouts: UIKitLayoutStarters,
  orchestra: UIKitLayoutOrchestra,
  testimonials: UIKitTestimonialsWall,
  pricing: UIKitPricingDeck,
  faq: UIKitFaqAccordion,
  'stats-ribbon': UIKitStatsRibbon,
  'feature-matrix': UIKitFeatureMatrix,
  'timeline-cards': UIKitTimelineCards,
  'logo-ticker': UIKitLogoTicker,
  'bento-showcase': UIKitBentoShowcase,
  'comparison-lanes': UIKitComparisonLanes,
  'case-study-deck': UIKitCaseStudyDeck,
  'command-panel': UIKitCommandPanel,
} as const;

type UIKitVariant = keyof typeof variants;

const variantConfigs = {
  buttons: uiKitButtonsMatrixConfig,
  'buttons-stack': uiKitButtonsStackConfig,
  chips: uiKitChipsCloudConfig,
  'chips-rail': uiKitChipsRailConfig,
  hero: uiKitHeroCanvasConfig,
  gallery: uiKitGalleryMasonryConfig,
  layouts: uiKitLayoutStartersConfig,
  orchestra: uiKitLayoutOrchestraConfig,
  testimonials: uiKitTestimonialsWallConfig,
  pricing: uiKitPricingDeckConfig,
  faq: uiKitFaqAccordionConfig,
  'stats-ribbon': uiKitStatsRibbonConfig,
  'feature-matrix': uiKitFeatureMatrixConfig,
  'timeline-cards': uiKitTimelineCardsConfig,
  'logo-ticker': uiKitLogoTickerConfig,
  'bento-showcase': uiKitBentoShowcaseConfig,
  'comparison-lanes': uiKitComparisonLanesConfig,
  'case-study-deck': uiKitCaseStudyDeckConfig,
  'command-panel': uiKitCommandPanelConfig,
} as const;

const requested = (cvariant ?? data?.cvariant ?? 'buttons') as UIKitVariant;
const resolvedVariant = (requested in variants ? requested : 'buttons') as UIKitVariant;
const VariantComponent = variants[resolvedVariant] as any;
const config = variantConfigs[resolvedVariant] ?? variantConfigs.buttons;
---

<VariantComponent data={data as any} config={config as any} />

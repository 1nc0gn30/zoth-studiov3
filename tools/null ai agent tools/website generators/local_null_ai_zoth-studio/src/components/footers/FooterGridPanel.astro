---
import footerGridPanelConfig from '../../configs/footers/footer-grid-panel.json';

interface FooterSocialItem {
  platform: string;
  url: string;
}

interface FooterGridPanelConfig {
  socialNavAria: string;
  copyright: string;
  showStatus: boolean;
  statusText: string;
  socials: FooterSocialItem[];
}

interface Props {
  data?: Partial<FooterGridPanelConfig>;
}

const { data } = Astro.props;
const baseConfig = footerGridPanelConfig as FooterGridPanelConfig;
const footerData: FooterGridPanelConfig = {
  ...baseConfig,
  ...data,
  socials: data?.socials ?? baseConfig.socials,
};
---
<footer class="f8" role="contentinfo">
  <div class="panel">
    <section class="copy">
      <p>{footerData.copyright}</p>
    </section>
    <section>
      <nav aria-label={footerData.socialNavAria}>
        <ul>
          {footerData.socials.map((s) => (
            <li><a href={s.url} target="_blank" rel="noreferrer noopener">{s.platform}</a></li>
          ))}
        </ul>
      </nav>
    </section>
    <section class="status-wrap">
      {footerData.showStatus && <p class="status">{footerData.statusText}</p>}
    </section>
  </div>
</footer>

<style>
  .f8 {
    background: var(--bg);
    color: var(--text);
    padding: 1rem 0;
  }
  .panel {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: 2fr 2fr 1fr;
    gap: 1rem;
    align-items: center;
  }
  p {
    margin: 0;
  }
  .copy p {
    color: color-mix(in srgb, var(--text) 74%, white 26%);
  }
  ul {
    display: flex;
    gap: 0.7rem;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }
  a {
    color: color-mix(in srgb, var(--text) 88%, white 12%);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 999px;
    padding: 0.34rem 0.7rem;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  a:hover,
  a:focus-visible {
    outline: none;
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 72%, transparent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .status-wrap {
    justify-self: end;
  }
  .status {
    color: var(--accent);
    font-weight: 600;
    border: 1px solid color-mix(in srgb, var(--accent) 36%, transparent);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
    background: color-mix(in srgb, var(--accent) 12%, transparent);
  }
  @media (max-width: 900px) {
    .panel {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .status-wrap {
      justify-self: center;
    }
    ul {
      justify-content: center;
    }
  }
</style>

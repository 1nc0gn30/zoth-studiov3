---
import footerGlassRowConfig from '../../configs/footers/footer-glass-row.json';

interface FooterSocialItem {
  platform: string;
  url: string;
}

interface FooterGlassRowConfig {
  socialNavAria: string;
  copyright: string;
  showStatus: boolean;
  statusText: string;
  socials: FooterSocialItem[];
}

interface Props {
  data?: Partial<FooterGlassRowConfig>;
}

const { data } = Astro.props;
const baseConfig = footerGlassRowConfig as FooterGlassRowConfig;
const footerData: FooterGlassRowConfig = {
  ...baseConfig,
  ...data,
  socials: data?.socials ?? baseConfig.socials,
};
---
<footer class="f6" role="contentinfo">
  <div class="glass">
    <p>{footerData.copyright}</p>
    <nav aria-label={footerData.socialNavAria}>
      <ul>
        {footerData.socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noreferrer noopener">{s.platform}</a></li>
        ))}
      </ul>
    </nav>
    {footerData.showStatus && <span>{footerData.statusText}</span>}
  </div>
</footer>

<style>
  .f6 {
    padding: 1rem;
    background: transparent;
  }
  .glass {
    max-width: 1180px;
    margin: 0 auto;
    background:
      linear-gradient(130deg, color-mix(in srgb, var(--bg) 72%, transparent), color-mix(in srgb, var(--bg) 55%, transparent));
    backdrop-filter: blur(10px);
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    border-radius: 14px;
    color: var(--text);
    padding: 0.95rem 1.1rem;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1rem;
  }
  p,
  span {
    margin: 0;
  }
  p {
    color: color-mix(in srgb, var(--text) 72%, white 28%);
  }
  span {
    color: var(--accent);
    font-weight: 600;
  }
  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    gap: 0.72rem;
    flex-wrap: wrap;
  }
  a {
    color: color-mix(in srgb, var(--text) 88%, white 12%);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 999px;
    padding: 0.33rem 0.68rem;
    transition: color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  a:hover,
  a:focus-visible {
    outline: none;
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 72%, transparent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  @media (max-width: 780px) {
    .glass {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    ul {
      justify-content: center;
    }
  }
</style>

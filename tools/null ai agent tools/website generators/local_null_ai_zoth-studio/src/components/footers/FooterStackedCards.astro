---
import footerStackedCardsConfig from '../../configs/footers/footer-stacked-cards.json';

interface FooterSocialItem {
  platform: string;
  url: string;
}

interface FooterStackedCardsConfig {
  socialNavAria: string;
  copyright: string;
  showStatus: boolean;
  statusText: string;
  socials: FooterSocialItem[];
}

interface Props {
  data?: Partial<FooterStackedCardsConfig>;
}

const { data } = Astro.props;
const baseConfig = footerStackedCardsConfig as FooterStackedCardsConfig;
const footerData: FooterStackedCardsConfig = {
  ...baseConfig,
  ...data,
  socials: data?.socials ?? baseConfig.socials,
};
---
<footer class="f10" role="contentinfo">
  <div class="wrap">
    <div class="box copy-box">
      <p>{footerData.copyright}</p>
    </div>
    {footerData.showStatus && (
      <div class="box status">
        <p>{footerData.statusText}</p>
      </div>
    )}
    <div class="box social-box">
      <nav aria-label={footerData.socialNavAria}>
        <ul>
          {footerData.socials.map((s) => (
            <li><a href={s.url} target="_blank" rel="noreferrer noopener">{s.platform}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</footer>

<style>
  .f10 {
    background: var(--bg);
    color: var(--text);
    padding: 1rem;
  }
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 2fr;
    gap: 0.8rem;
  }
  .box {
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    border-radius: 12px;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--bg) 92%, black 8%);
  }
  .copy-box p {
    color: color-mix(in srgb, var(--text) 74%, white 26%);
  }
  .status {
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .status p {
    color: var(--accent);
    font-weight: 600;
  }
  p {
    margin: 0;
    text-align: center;
  }
  ul {
    display: flex;
    gap: 0.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    justify-content: center;
  }
  a {
    color: color-mix(in srgb, var(--text) 88%, white 12%);
    text-decoration: none;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
    padding: 0.32rem 0.66rem;
    transition: color 140ms ease, border-color 140ms ease, background-color 140ms ease;
  }
  a:hover,
  a:focus-visible {
    outline: none;
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 72%, transparent);
    background: color-mix(in srgb, var(--accent) 13%, transparent);
  }
  @media (max-width: 900px) {
    .wrap {
      grid-template-columns: 1fr;
    }
  }
</style>

---
import footerCenteredStackConfig from '../../configs/footers/footer-centered-stack.json';

interface FooterSocialItem {
  platform: string;
  url: string;
}

interface FooterCenteredStackConfig {
  headline: string;
  socialNavAria: string;
  showStatus: boolean;
  statusText: string;
  copyright: string;
  socials: FooterSocialItem[];
}

interface Props {
  data?: Partial<FooterCenteredStackConfig>;
}

const { data } = Astro.props;
const baseConfig = footerCenteredStackConfig as FooterCenteredStackConfig;
const footerData: FooterCenteredStackConfig = {
  ...baseConfig,
  ...data,
  socials: data?.socials ?? baseConfig.socials,
};
---
<footer class="f2" role="contentinfo">
  <div class="wrap">
    <p class="headline">{footerData.headline}</p>
    <nav aria-label={footerData.socialNavAria}>
      <ul>
        {footerData.socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noreferrer noopener">{s.platform}</a></li>
        ))}
      </ul>
    </nav>
    {footerData.showStatus && <p class="status">{footerData.statusText}</p>}
    <p class="copy">{footerData.copyright}</p>
  </div>
</footer>

<style>
  .f2 {
    margin-top: 4rem;
    color: var(--text);
    background:
      linear-gradient(165deg, color-mix(in srgb, var(--bg) 92%, black 8%), var(--bg)),
      radial-gradient(circle at 50% 0, color-mix(in srgb, var(--accent) 14%, transparent), transparent 50%);
    border-top: 1px solid color-mix(in srgb, var(--accent) 30%, transparent);
  }
  .wrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 2.25rem 1rem 1.6rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    text-align: center;
  }
  .headline {
    margin: 0;
    font-size: 0.82rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--text) 70%, white 30%);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 0.85rem;
    flex-wrap: wrap;
    justify-content: center;
  }
  a {
    color: color-mix(in srgb, var(--text) 88%, white 12%);
    text-decoration: none;
    padding: 0.45rem 0.75rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 26%, transparent);
    transition: transform 150ms ease, color 150ms ease, border-color 150ms ease, background-color 150ms ease;
  }
  a:hover,
  a:focus-visible {
    outline: none;
    transform: translateY(-1px);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 68%, transparent);
  }
  p { margin: 0; }
  .status {
    color: var(--accent);
    font-weight: 600;
  }
  .copy {
    color: color-mix(in srgb, var(--text) 74%, white 26%);
    font-size: 0.9rem;
  }
  @media (max-width: 640px) {
    ul {
      flex-direction: column;
      width: 100%;
      max-width: 18rem;
    }
    li, a {
      width: 100%;
    }
    a {
      justify-content: center;
    }
  }
</style>

---
import footerFloatingCardConfig from '../../configs/footers/footer-floating-card.json';

interface FooterSocialItem {
  platform: string;
  url: string;
}

interface FooterFloatingCardConfig {
  socialNavAria: string;
  copyright: string;
  showStatus: boolean;
  statusText: string;
  socials: FooterSocialItem[];
}

interface Props {
  data?: Partial<FooterFloatingCardConfig>;
}

const { data } = Astro.props;
const baseConfig = footerFloatingCardConfig as FooterFloatingCardConfig;
const footerData: FooterFloatingCardConfig = {
  ...baseConfig,
  ...data,
  socials: data?.socials ?? baseConfig.socials,
};
---
<footer class="f4" role="contentinfo">
  <div class="card">
    <p>{footerData.copyright}</p>
    <nav aria-label={footerData.socialNavAria}>
      <ul>
        {footerData.socials.map((s) => (
          <li><a href={s.url} target="_blank" rel="noreferrer noopener">{s.platform}</a></li>
        ))}
      </ul>
    </nav>
    {footerData.showStatus && <span class="status">{footerData.statusText}</span>}
  </div>
</footer>

<style>
  .f4 {
    padding: 1.25rem;
    background: transparent;
  }
  .card {
    max-width: 1080px;
    margin: 0 auto;
    background:
      linear-gradient(150deg, color-mix(in srgb, var(--bg) 95%, white 5%), var(--bg));
    color: var(--text);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
    border-radius: 18px;
    padding: 1rem 1.25rem;
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: 1rem;
    align-items: center;
    box-shadow: 0 16px 40px color-mix(in srgb, black 18%, transparent);
  }
  p {
    margin: 0;
    color: color-mix(in srgb, var(--text) 74%, white 26%);
  }
  .status {
    padding: 0.34rem 0.72rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--accent) 22%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    font-size: 0.82rem;
    font-weight: 700;
  }
  ul {
    list-style: none;
    display: flex;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  a {
    color: color-mix(in srgb, var(--text) 88%, white 12%);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: 999px;
    padding: 0.35rem 0.68rem;
    transition: color 140ms ease, border-color 140ms ease, background-color 140ms ease, transform 140ms ease;
  }
  a:hover,
  a:focus-visible {
    outline: none;
    transform: translateY(-1px);
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 74%, transparent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }
  @media (max-width: 860px) {
    .card {
      grid-template-columns: 1fr;
      text-align: center;
    }
    ul {
      justify-content: center;
    }
    .status {
      justify-self: center;
    }
  }
</style>

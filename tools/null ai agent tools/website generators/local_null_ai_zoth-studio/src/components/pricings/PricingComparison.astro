---
import type { PricingData } from '../../configs/pricing';

interface Props {
  data?: PricingData;
  config?: PricingData;
}

const { data = {}, config = {} } = Astro.props;
const section: PricingData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  tiers: data.tiers ?? config.tiers,
};
const tiers = Array.isArray(section.tiers) ? section.tiers : [];
const allFeatures = [...new Set(tiers.flatMap((t) => t.features || []))];
---

<section class="pricing-comparison" aria-labelledby="pricing-comparison-heading">
  <header>
    {section.eyebrow && <p>{section.eyebrow}</p>}
    <h2 id="pricing-comparison-heading">{section.heading}</h2>
    {section.subtext && <p class="pricing-comparison__subtext">{section.subtext}</p>}
  </header>

  <div class="pricing-comparison__table-wrap">
    <table class="pricing-comparison__table">
      <thead>
        <tr>
          <th>Feature</th>
          {tiers.map((t) => (
            <th>
              <span class="pricing-comparison__tier-name">{t.name}</span>
              <span class="pricing-comparison__tier-price">{t.price}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {allFeatures.map((feature) => (
          <tr>
            <td>{feature}</td>
            {tiers.map((t) => (
              <td>
                {(t.features || []).includes(feature) ? <span class="pricing-comparison__yes">✓</span> : <span class="pricing-comparison__no">—</span>}
              </td>
            ))}
          </tr>
        ))}
        <tr class="pricing-comparison__cta-row">
          <td></td>
          {tiers.map((t) => (
            <td>
              <a href="#" class={`pricing-comparison__cta ${t.popular ? 'primary' : ''}`}>{t.cta}</a>
            </td>
          ))}
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .pricing-comparison {
    max-width: 960px;
    margin: 0 auto;
    padding: clamp(2.2rem, 5vw, 4rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }
  .pricing-comparison header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }
  .pricing-comparison h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }
  .pricing-comparison__subtext {
    margin: 0.65rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }
  .pricing-comparison__table-wrap {
    margin-top: 1.6rem;
    overflow-x: auto;
  }
  .pricing-comparison__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.88rem;
  }
  .pricing-comparison__table th,
  .pricing-comparison__table td {
    padding: 0.7rem 0.8rem;
    border-bottom: 1px solid color-mix(in srgb, var(--textColor) 10%, transparent);
    text-align: left;
  }
  .pricing-comparison__table th {
    font-family: var(--fontDisplay, var(--fontFamily));
    font-weight: 600;
    color: var(--textColor);
    vertical-align: bottom;
  }
  .pricing-comparison__table td {
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }
  .pricing-comparison__tier-name {
    display: block;
    font-size: 0.95rem;
  }
  .pricing-comparison__tier-price {
    display: block;
    font-size: 1.3rem;
    color: var(--accentColor);
    margin-top: 0.2rem;
  }
  .pricing-comparison__yes {
    color: var(--accentColor);
    font-weight: 700;
  }
  .pricing-comparison__no {
    color: color-mix(in srgb, var(--textColor) 30%, transparent);
  }
  .pricing-comparison__cta-row td {
    padding-top: 1rem;
    border-bottom: none;
  }
  .pricing-comparison__cta {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    border-radius: 10px;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.82rem;
    background: color-mix(in srgb, var(--bgColor) 88%, white 12%);
    border: 1px solid color-mix(in srgb, var(--textColor) 22%, transparent);
    color: var(--textColor);
  }
  .pricing-comparison__cta.primary {
    background: var(--accentColor);
    color: #fff;
    border-color: var(--accentColor);
  }
</style>

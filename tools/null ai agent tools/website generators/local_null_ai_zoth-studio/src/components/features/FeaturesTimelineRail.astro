---
interface TI { title: string; description: string; kicker?: string; metric?: string; }
interface TC { eyebrow: string; heading: string; subtext: string; items: TI[]; }
interface Props { config: TC; data?: Partial<TC>; }
const { config, data = {} } = Astro.props;
const s: TC = { eyebrow: data.eyebrow ?? config.eyebrow, heading: data.heading ?? config.heading, subtext: data.subtext ?? config.subtext, items: data.items ?? config.items, };
---

<section class="tl">
  <header>
    <p class="tl-eyebrow">{s.eyebrow}</p>
    <h2>{s.heading}</h2>
    <p class="tl-subtext">{s.subtext}</p>
  </header>
  <div class="tl-track">
    {s.items.map((item, i) => (
      <article class="tl-step">
        <div class="tl-marker"><span class="tl-dot"></span>{i < s.items.length - 1 && <span class="tl-line"></span>}</div>
        <div class="tl-body">
          {item.kicker && <small>{item.kicker}</small>}
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          {item.metric && <span class="tl-badge">{item.metric}</span>}
        </div>
      </article>
    ))}
  </div>
</section>
<style>
  .tl { max-width: 800px; margin: 0 auto; padding: clamp(2.2rem, 6vw, 4.2rem) 1rem; font-family: var(--fontBody, var(--fontFamily)); }
  .tl-eyebrow { margin: 0; color: var(--accentColor); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; }
  h2 { margin: 0.65rem 0 0; font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; font-family: var(--fontDisplay, var(--fontFamily)); }
  .tl-subtext { margin-top: 0.85rem; max-width: 62ch; line-height: 1.64; color: color-mix(in srgb, var(--textColor) 84%, transparent); }
  .tl-track { margin-top: 2rem; }
  .tl-step { display: flex; gap: 1rem; margin-bottom: 1.5rem; }
  .tl-marker { display: flex; flex-direction: column; align-items: center; min-width: 24px; }
  .tl-dot { width: 14px; height: 14px; border-radius: 50%; background: var(--accentColor); border: 3px solid color-mix(in srgb, var(--bgColor) 90%, var(--accentColor) 10%); box-shadow: 0 0 0 2px var(--accentColor); flex-shrink: 0; margin-top: 4px; }
  .tl-line { width: 2px; flex: 1; background: color-mix(in srgb, var(--textColor) 16%, transparent); margin: 4px 0; min-height: 20px; }
  .tl-body { flex: 1; padding-bottom: 0.5rem; }
  small { color: var(--accentColor); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.72rem; font-weight: 700; }
  h3 { margin: 0.2rem 0 0; font-family: var(--fontDisplay, var(--fontFamily)); font-size: 1.05rem; }
  .tl-body p { margin: 0.3rem 0 0; line-height: 1.55; color: color-mix(in srgb, var(--textColor) 82%, transparent); }
  .tl-badge { display: inline-block; margin-top: 0.5rem; padding: 0.15rem 0.6rem; border-radius: 12px; background: color-mix(in srgb, var(--accentColor) 12%, transparent); color: var(--accentColor); font-size: 0.78rem; font-weight: 700; }
</style>
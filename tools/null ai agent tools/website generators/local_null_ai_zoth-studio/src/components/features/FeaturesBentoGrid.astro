---
interface BentoItem {
  title: string;
  description: string;
  kicker?: string;
  metric?: string;
}

interface BentoConfig {
  eyebrow: string;
  heading: string;
  subtext: string;
  items: BentoItem[];
}

interface Props {
  config: BentoConfig;
  data?: Partial<BentoConfig>;
}

const { config, data = {} } = Astro.props;
const section: BentoConfig = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  items: data.items ?? config.items,
};
const spans = ["span-2", "span-row-2", "span-2 span-row-2", ""];
---

<section class="bento-grid" aria-labelledby="bento-title">
  <header>
    <p class="bento-eyebrow">{section.eyebrow}</p>
    <h2 id="bento-title">{section.heading}</h2>
    <p class="bento-subtext">{section.subtext}</p>
  </header>
  <div class="bento-grid-inner">
    {section.items.map((item, i) => (
      <article class={"bento-card " + spans[i % spans.length]}>
        {item.kicker && <small>{item.kicker}</small>}
        <h3>{item.title}</h3>
        <p>{item.description}</p>
        {item.metric && <strong>{item.metric}</strong>}
      </article>
    ))}
  </div>
</section>

<style>
  .bento-grid { max-width: 1160px; margin: 0 auto; padding: clamp(2.2rem, 6vw, 4.2rem) 1rem; font-family: var(--fontBody, var(--fontFamily)); }
  .bento-eyebrow { margin: 0; color: var(--accentColor); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; }
  h2 { margin: 0.65rem 0 0; font-size: clamp(1.9rem, 5vw, 3rem); line-height: 1.08; font-family: var(--fontDisplay, var(--fontFamily)); }
  .bento-subtext { margin-top: 0.85rem; max-width: 62ch; line-height: 1.64; color: color-mix(in srgb, var(--textColor) 84%, transparent); }
  .bento-grid-inner { margin-top: 1.5rem; display: grid; gap: 0.8rem; grid-template-columns: 1fr; }
  .bento-card { border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent); border-radius: 16px; padding: 1.2rem; background: color-mix(in srgb, var(--bgColor) 95%, var(--accentColor) 5%); transition: transform 0.2s ease, box-shadow 0.2s ease; }
  .bento-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px color-mix(in srgb, var(--accentColor) 12%, transparent); }
  small { color: var(--accentColor); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.72rem; font-weight: 700; }
  h3 { margin: 0.4rem 0 0; font-family: var(--fontDisplay, var(--fontFamily)); font-size: 1.05rem; }
  article p { margin: 0.35rem 0 0; line-height: 1.55; color: color-mix(in srgb, var(--textColor) 82%, transparent); }
  strong { display: block; margin-top: 0.55rem; color: var(--accentColor); font-size: 0.92rem; }
  @media (min-width: 640px) { .bento-grid-inner { grid-template-columns: repeat(2, 1fr); } .span-2 { grid-column: span 2; } .span-row-2 { grid-row: span 2; } }
  @media (min-width: 920px) { .bento-grid-inner { grid-template-columns: repeat(3, 1fr); } }
</style>
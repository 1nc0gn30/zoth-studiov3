---
import type { FAQData } from '../../configs/faq';

interface Props {
  data?: FAQData;
  config?: FAQData;
}

const { data = {}, config = {} } = Astro.props;
const section: FAQData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  items: data.items ?? config.items,
};
const items = Array.isArray(section.items) ? section.items : [];
---

<section class="faq-list" aria-labelledby="faq-list-heading">
  <header>
    {section.eyebrow && <p>{section.eyebrow}</p>}
    <h2 id="faq-list-heading">{section.heading}</h2>
    {section.subtext && <p class="faq-list__subtext">{section.subtext}</p>}
  </header>

  <ol class="faq-list__items" role="list">
    {items.map((item) => (
      <li class="faq-list__item">
        <h3>{item.question}</h3>
        <p>{item.answer}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .faq-list {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(2.2rem, 5vw, 4rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }

  .faq-list header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }

  .faq-list h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .faq-list__subtext {
    margin: 0.65rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }

  .faq-list__items {
    margin-top: 1.6rem;
    padding: 0;
    list-style: none;
    counter-reset: faq-counter;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .faq-list__item {
    position: relative;
    padding-left: 3rem;
    counter-increment: faq-counter;
  }

  .faq-list__item::before {
    content: counter(faq-counter, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.15rem;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--accentColor);
    font-family: var(--fontDisplay, var(--fontFamily));
    width: 2.2rem;
    height: 2.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accentColor) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accentColor) 30%, transparent);
  }

  .faq-list__item h3 {
    margin: 0;
    font-size: clamp(1rem, 2.2vw, 1.15rem);
    line-height: 1.3;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .faq-list__item p {
    margin: 0.4rem 0 0;
    line-height: 1.65;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }
</style>

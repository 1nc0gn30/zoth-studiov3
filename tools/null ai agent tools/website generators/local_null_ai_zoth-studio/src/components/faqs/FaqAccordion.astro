---
import type { FAQData } from '../../configs/faq';

interface Props {
  data?: FAQData;
  config?: FAQData;
}

const { data = {}, config = {} } = Astro.props;
const section: FAQData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  items: data.items ?? config.items,
};
const items = Array.isArray(section.items) ? section.items : [];
---

<section class="faq-accordion" aria-labelledby="faq-accordion-heading">
  <header>
    {section.eyebrow && <p>{section.eyebrow}</p>}
    <h2 id="faq-accordion-heading">{section.heading}</h2>
    {section.subtext && <p class="faq-accordion__subtext">{section.subtext}</p>}
  </header>

  <div class="faq-accordion__list" role="list">
    {items.map((item, index) => (
      <details
        class="faq-accordion__details"
        open={item.open ? true : undefined}
        role="listitem"
      >
        <summary class="faq-accordion__summary">
          <span class="faq-accordion__question">{item.question}</span>
          <span class="faq-accordion__marker" aria-hidden="true"></span>
        </summary>
        <div class="faq-accordion__answer">
          <p>{item.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-accordion {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(2.2rem, 5vw, 4rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }

  .faq-accordion header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }

  .faq-accordion h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .faq-accordion__subtext {
    margin: 0.65rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }

  .faq-accordion__list {
    margin-top: 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-accordion__details {
    border-radius: 16px;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--bgColor) 96%, white 4%),
      color-mix(in srgb, var(--bgColor) 92%, var(--accentColor) 8%)
    );
    overflow: hidden;
    transition: box-shadow 0.2s ease;
  }

  .faq-accordion__details[open] {
    box-shadow: 0 12px 30px -18px color-mix(in srgb, var(--accentColor) 40%, transparent);
  }

  .faq-accordion__summary {
    list-style: none;
    cursor: pointer;
    padding: 1rem 1.2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    font-weight: 700;
    font-size: clamp(0.95rem, 2vw, 1.05rem);
    font-family: var(--fontDisplay, var(--fontFamily));
    user-select: none;
  }

  .faq-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .faq-accordion__question {
    line-height: 1.35;
  }

  .faq-accordion__marker {
    width: 22px;
    height: 22px;
    flex-shrink: 0;
    position: relative;
    display: inline-block;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accentColor) 18%, transparent);
  }

  .faq-accordion__marker::before,
  .faq-accordion__marker::after {
    content: '';
    position: absolute;
    background: var(--accentColor);
    border-radius: 2px;
    transition: transform 0.25s ease;
  }

  .faq-accordion__marker::before {
    top: 50%;
    left: 50%;
    width: 10px;
    height: 2px;
    transform: translate(-50%, -50%);
  }

  .faq-accordion__marker::after {
    top: 50%;
    left: 50%;
    width: 2px;
    height: 10px;
    transform: translate(-50%, -50%);
  }

  .faq-accordion__details[open] .faq-accordion__marker::after {
    transform: translate(-50%, -50%) scaleY(0);
  }

  .faq-accordion__answer {
    padding: 0 1.2rem 1.2rem;
  }

  .faq-accordion__answer p {
    margin: 0;
    line-height: 1.65;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-accordion__details,
    .faq-accordion__marker::before,
    .faq-accordion__marker::after {
      transition: none;
    }
  }
</style>

---
import type { TeamData } from '../../configs/team';

interface Props {
  data?: TeamData;
  config?: TeamData;
}

const { data = {}, config = {} } = Astro.props;
const section: TeamData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  members: data.members ?? config.members,
};
const members = Array.isArray(section.members) ? section.members : [];
---

<section class="team-grid" aria-labelledby="team-grid-heading">
  <header>
    {section.eyebrow && <p>{section.eyebrow}</p>}
    <h2 id="team-grid-heading">{section.heading}</h2>
    {section.subtext && <p class="team-grid__subtext">{section.subtext}</p>}
  </header>

  <div class="team-grid__list">
    {members.map((member) => (
      <article class="team-grid__card">
        {member.avatar && (
          <img class="team-grid__avatar" src={member.avatar} alt={member.avatarAlt || member.name} loading="lazy" decoding="async" />
        )}
        <div class="team-grid__info">
          <h3>{member.name}</h3>
          <span class="team-grid__role">{member.role}</span>
          {member.bio && <p class="team-grid__bio">{member.bio}</p>}
          {member.socials && member.socials.length > 0 && (
            <div class="team-grid__socials">
              {member.socials.map((s) => (
                <a href={s.url} target="_blank" rel="noopener noreferrer">{s.platform}</a>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .team-grid {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(2.2rem, 5vw, 4rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }
  .team-grid header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }
  .team-grid h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }
  .team-grid__subtext {
    margin: 0.65rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }
  .team-grid__list {
    margin-top: 1.6rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }
  .team-grid__card {
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--bgColor) 96%, white 4%), color-mix(in srgb, var(--bgColor) 92%, var(--accentColor) 8%));
    padding: 1.2rem;
    display: flex;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .team-grid__avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid color-mix(in srgb, var(--accentColor) 40%, transparent);
  }
  .team-grid__info h3 {
    margin: 0;
    font-size: 1.05rem;
    font-family: var(--fontDisplay, var(--fontFamily));
  }
  .team-grid__role {
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--textColor) 72%, transparent);
  }
  .team-grid__bio {
    margin: 0.4rem 0 0;
    font-size: 0.88rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--textColor) 78%, transparent);
  }
  .team-grid__socials {
    margin-top: 0.5rem;
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }
  .team-grid__socials a {
    font-size: 0.78rem;
    color: var(--accentColor);
    text-decoration: none;
  }
  @media (min-width: 640px) {
    .team-grid__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 980px) {
    .team-grid__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>

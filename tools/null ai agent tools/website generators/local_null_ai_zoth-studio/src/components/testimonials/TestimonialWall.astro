---
import type { TestimonialData } from '../../configs/testimonial';

interface Props {
  data?: TestimonialData;
  config?: TestimonialData;
}

const { data = {}, config = {} } = Astro.props;
const section: TestimonialData = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  items: data.items ?? config.items,
};
const items = Array.isArray(section.items) ? section.items : [];
---

<section class="testimonial-wall" aria-labelledby="testimonial-wall-heading">
  <header>
    {section.eyebrow && <p>{section.eyebrow}</p>}
    <h2 id="testimonial-wall-heading">{section.heading}</h2>
    {section.subtext && <p class="testimonial-wall__subtext">{section.subtext}</p>}
  </header>

  <div class="testimonial-wall__masonry">
    {items.map((item) => (
      <blockquote class="testimonial-wall__card">
        <p>"{item.quote}"</p>
        <footer>
          <strong>{item.author}</strong>
          {item.role && <span>{item.role}</span>}
        </footer>
      </blockquote>
    ))}
  </div>
</section>

<style>
  .testimonial-wall {
    max-width: 1160px;
    margin: 0 auto;
    padding: clamp(2.2rem, 5vw, 4rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }
  .testimonial-wall header > p {
    margin: 0;
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accentColor);
  }
  .testimonial-wall h2 {
    margin: 0.55rem 0 0;
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    line-height: 1.1;
    font-family: var(--fontDisplay, var(--fontFamily));
  }
  .testimonial-wall__subtext {
    margin: 0.65rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 82%, transparent);
  }
  .testimonial-wall__masonry {
    margin-top: 1.6rem;
    columns: 1;
    column-gap: 1rem;
  }
  .testimonial-wall__card {
    margin: 0 0 1rem;
    break-inside: avoid;
    border-radius: 18px;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: linear-gradient(180deg, color-mix(in srgb, var(--bgColor) 96%, white 4%), color-mix(in srgb, var(--bgColor) 92%, var(--accentColor) 8%));
    padding: 1.2rem;
  }
  .testimonial-wall__card p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.55;
    font-style: italic;
    color: color-mix(in srgb, var(--textColor) 92%, transparent);
  }
  .testimonial-wall__card footer {
    margin-top: 0.8rem;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .testimonial-wall__card strong {
    font-size: 0.85rem;
    font-family: var(--fontDisplay, var(--fontFamily));
  }
  .testimonial-wall__card span {
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--textColor) 68%, transparent);
  }
  @media (min-width: 640px) {
    .testimonial-wall__masonry {
      columns: 2;
    }
  }
  @media (min-width: 980px) {
    .testimonial-wall__masonry {
      columns: 3;
    }
  }
</style>

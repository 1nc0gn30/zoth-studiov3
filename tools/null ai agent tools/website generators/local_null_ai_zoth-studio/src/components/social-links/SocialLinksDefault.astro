---
interface SocialItem {
  label: string;
  url: string;
  handle?: string;
  description?: string;
  platform?: string;
}

interface SocialLinksConfig {
  eyebrow: string;
  heading: string;
  subtext: string;
  links: SocialItem[];
}

interface Props {
  config: SocialLinksConfig;
  data?: Partial<SocialLinksConfig>;
}

const { config, data = {} } = Astro.props;
const section: SocialLinksConfig = {
  eyebrow: data.eyebrow ?? config.eyebrow,
  heading: data.heading ?? config.heading,
  subtext: data.subtext ?? config.subtext,
  links: data.links ?? config.links,
};
---

<section class="social-default" aria-labelledby="social-default-title">
  <header>
    <p>{section.eyebrow}</p>
    <h2 id="social-default-title">{section.heading}</h2>
    <p class="social-default__subtext">{section.subtext}</p>
  </header>

  <div class="social-default__grid">
    {section.links.map((link) => (
      <a href={link.url} target="_blank" rel="noreferrer" class="social-default__item">
        <strong>{link.label}</strong>
        {link.handle && <span>{link.handle}</span>}
        {link.description && <small>{link.description}</small>}
      </a>
    ))}
  </div>
</section>

<style>
  .social-default {
    max-width: 1080px;
    margin: 0 auto;
    padding: clamp(2rem, 6vw, 3.8rem) 1rem;
    font-family: var(--fontBody, var(--fontFamily));
  }

  header p {
    margin: 0;
    color: var(--accentColor);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
  }

  h2 {
    margin: 0.62rem 0 0;
    font-size: clamp(1.65rem, 4vw, 2.6rem);
    line-height: 1.08;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .social-default__subtext {
    margin: 0.8rem 0 0;
    line-height: 1.6;
    color: color-mix(in srgb, var(--textColor) 83%, transparent);
  }

  .social-default__grid {
    margin-top: 0.9rem;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: 1fr;
  }

  .social-default__item {
    text-decoration: none;
    border-radius: 12px;
    border: 1px solid color-mix(in srgb, var(--textColor) 12%, transparent);
    background: color-mix(in srgb, var(--bgColor) 95%, var(--accentColor) 5%);
    padding: 0.82rem;
    color: var(--textColor);
    transition: transform 0.2s ease;
  }

  .social-default__item:hover {
    transform: translateY(-2px);
  }

  .social-default__item strong {
    display: block;
    font-family: var(--fontDisplay, var(--fontFamily));
  }

  .social-default__item span {
    display: block;
    margin-top: 0.25rem;
    color: var(--accentColor);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .social-default__item small {
    display: block;
    margin-top: 0.3rem;
    color: color-mix(in srgb, var(--textColor) 74%, transparent);
    line-height: 1.45;
  }

  @media (min-width: 860px) {
    .social-default__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

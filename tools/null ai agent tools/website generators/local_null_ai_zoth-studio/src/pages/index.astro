---
// Z0TH Studio — Autonomous Multi-Agent Website & SaaS Foundry (v3.0 Ultra)
// Standalone full-screen dashboard with live interactive sandbox preview & 4-agent swarm harness
---

<style is:global>
  .zoth-dash {
    --zd-bg: #05070f;
    --zd-surface: #0a0e1c;
    --zd-surface-2: #10162a;
    --zd-surface-3: #18203a;
    --zd-border: #1a2342;
    --zd-border-active: #00f0ff;
    --zd-text: #f0f4fc;
    --zd-text-muted: #8493b8;
    --zd-text-dim: #4a567a;
    --zd-cyan: #00f0ff;
    --zd-gold: #e8c872;
    --zd-purple: #c084fc;
    --zd-green: #34d399;
    --zd-red: #f87171;
    --font-body: 'Figtree', system-ui, -apple-system, sans-serif;
    --font-display: 'Syne', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;
  }

  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  html, body {
    height: 100%;
    background: #05070f;
    color: #f0f4fc;
    font-family: 'Figtree', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }

  body {
    display: flex;
    flex-direction: column;
  }

  ::-webkit-scrollbar { width: 6px; height: 6px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: #1a2342; border-radius: 3px; }
  ::-webkit-scrollbar-thumb:hover { background: #8493b8; }
</style>

<!-- Google Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Syne:wght@700;800&family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet" />

<!-- ═══════════ TOP BAR ═══════════ -->
<header class="zd-topbar">
  <div class="zd-topbar-left">
    <span class="zd-logo-mark">◈</span>
    <span class="zd-logo-text">Z0TH Studio</span>
    <span class="zd-topbar-badge">Swarm Foundry v3.0</span>
  </div>
  <div class="zd-topbar-center">
    <span class="zd-swarm-status">
      <span class="zd-status-dot"></span>
      <span>4 Loopback Swarm Agents Active (Lycan 🐺, Kitsune 🦊, Draco 🐲, Workbot 🤖)</span>
    </span>
  </div>
  <div class="zd-topbar-right">
    <button class="zd-btn-sm" onclick="window.location.reload()">⟳ New Session</button>
  </div>
</header>

<!-- ═══════════ MAIN DASHBOARD ═══════════ -->
<main class="zd-main" id="zoth-dashboard">

  <!-- ─── STEP 1: WEBSITE ARCHITECTURE & SPECS ─── -->
  <section class="zd-step active" id="step-config">
    <div class="zd-step-head">
      <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:1rem;">
        <div>
          <h1 class="zd-step-title">Autonomous Website & SaaS Foundry</h1>
          <p class="zd-step-desc">Configure your website parameters. The live multi-agent swarm will collaborate to architect, code, and preview your site.</p>
        </div>
        <!-- Live Tool Engine Status Strip -->
        <div class="zd-engine-strip" id="engine-strip">
          <span class="zd-eng-badge"><span class="dot green"></span> 🐺 agy</span>
          <span class="zd-eng-badge"><span class="dot green"></span> 🐲 hermes</span>
          <span class="zd-eng-badge"><span class="dot green"></span> 🦊 grok</span>
          <span class="zd-eng-badge"><span class="dot green"></span> 🦙 ollama</span>
          <span class="zd-eng-badge"><span class="dot green"></span> ⚡ aider</span>
        </div>
      </div>
    </div>

    <div class="zd-form-grid">
      
      <!-- Left Column: Core Website Specs -->
      <div class="zd-col">
        
        <!-- Template Archetypes -->
        <div class="zd-card">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem; flex-wrap:wrap; gap:6px;">
            <h2 class="zd-card-title" style="margin:0;">0. Production Site Template Archetype</h2>
            <button type="button" class="zd-btn-browse-drive" onclick="openDriveModal()">
              📂 Browse Drive Vault (258+ Apps)
            </button>
          </div>
          <div class="zd-template-grid" id="template-archetype-grid">
            <div class="zd-template-card active" data-tmpl="saas-vault" onclick="selectTemplate('saas-vault')">
              <span class="zd-tmpl-icon">🔒</span>
              <div>
                <strong>Apex SaaS Vault</strong>
                <small>Dark glassmorphism, pricing, sandbox, FAQ</small>
              </div>
            </div>
            <div class="zd-template-card" data-tmpl="ai-platform" onclick="selectTemplate('ai-platform')">
              <span class="zd-tmpl-icon">🤖</span>
              <div>
                <strong>NullAI Agent Foundry</strong>
                <small>Multi-agent arena, live terminal, telemetry</small>
              </div>
            </div>
            <div class="zd-template-card" data-tmpl="cyberpunk-web3" onclick="selectTemplate('cyberpunk-web3')">
              <span class="zd-tmpl-icon">⚡</span>
              <div>
                <strong>Aetheris Cyberpunk</strong>
                <small>Matrix canvas, CRT scanlines, tokenomics</small>
              </div>
            </div>
            <div class="zd-template-card" data-tmpl="portfolio-dev" onclick="selectTemplate('portfolio-dev')">
              <span class="zd-tmpl-icon">💼</span>
              <div>
                <strong>Developer Showcase</strong>
                <small>Selected work, interactive lab, Netlify form</small>
              </div>
            </div>
          </div>
        </div>

        <!-- Project Identity -->
        <div class="zd-card">
          <h2 class="zd-card-title">1. Project Identity</h2>
          <div class="zd-field">
            <label class="zd-label">Project / Site Name</label>
            <input type="text" id="site-name" class="zd-input" placeholder="e.g. ApexVault" value="ApexVault" />
          </div>
          <div class="zd-field">
            <label class="zd-label">Tagline / Mission</label>
            <input type="text" id="site-tagline" class="zd-input" placeholder="e.g. Sovereign Multi-Agent Cryptographic Layer" value="Sovereign Multi-Agent Cryptographic Layer" />
          </div>
        </div>

        <!-- Niche / Archetype -->
        <div class="zd-card">
          <h2 class="zd-card-title">2. Website Archetype & Niche</h2>
          <div class="zd-pill-grid" id="niche-grid">
            <button class="zd-pill active" data-niche="saas">🚀 SaaS Platform</button>
            <button class="zd-pill" data-niche="ai-agent">🤖 AI Agent Studio</button>
            <button class="zd-pill" data-niche="cyberpunk">⚡ Web3 / Cyberpunk</button>
            <button class="zd-pill" data-niche="portfolio">💼 Developer Portfolio</button>
            <button class="zd-pill" data-niche="ecommerce">🛍️ Digital Goods</button>
            <button class="zd-pill" data-niche="docs">📚 Docs & Knowledge Hub</button>
            <button class="zd-pill" data-niche="agency">🎨 Creative Agency</button>
          </div>
        </div>

        <!-- Framework Target -->
        <div class="zd-card">
          <h2 class="zd-card-title">3. Framework Target</h2>
          <div class="zd-fw-selector" id="fw-grid">
            <div class="zd-fw-item active" data-fw="vite-react">
              <span class="zd-fw-icon">⚛️</span>
              <span class="zd-fw-name">Vite + React 19</span>
              <span class="zd-fw-badge">Tailwind + SPA</span>
            </div>
            <div class="zd-fw-item" data-fw="astro">
              <span class="zd-fw-icon">🚀</span>
              <span class="zd-fw-name">Astro Modern</span>
              <span class="zd-fw-badge">Components Ready</span>
            </div>
            <div class="zd-fw-item" data-fw="nextjs">
              <span class="zd-fw-icon">▲</span>
              <span class="zd-fw-name">Next.js Fullstack</span>
              <span class="zd-fw-badge">SSR + API</span>
            </div>
            <div class="zd-fw-item" data-fw="vanilla">
              <span class="zd-fw-icon">🌐</span>
              <span class="zd-fw-name">Web Standards</span>
              <span class="zd-fw-badge">Zero Deps</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Visual Design, Components & Master Prompt -->
      <div class="zd-col">
        
        <!-- Theme & Aesthetics -->
        <div class="zd-card">
          <h2 class="zd-card-title">4. Visual Aesthetic & Theme</h2>
          <div class="zd-theme-grid" id="theme-grid">
            <div class="zd-theme-card active" data-theme="obsidian-gold">
              <span class="zd-theme-dot" style="background:#e8c872; box-shadow:0 0 8px #e8c872;"></span>
              <div>
                <strong>Obsidian Gold</strong>
                <small>Hermetic black & gold luxury</small>
              </div>
            </div>
            <div class="zd-theme-card" data-theme="midnight-neon">
              <span class="zd-theme-dot" style="background:#00f0ff; box-shadow:0 0 8px #00f0ff;"></span>
              <div>
                <strong>Midnight Neon</strong>
                <small>Cyberpunk cyan & deep void</small>
              </div>
            </div>
            <div class="zd-theme-card" data-theme="acid-grid">
              <span class="zd-theme-dot" style="background:#34d399; box-shadow:0 0 8px #34d399;"></span>
              <div>
                <strong>Acid Grid</strong>
                <small>Matrix emerald & wireframes</small>
              </div>
            </div>
            <div class="zd-theme-card" data-theme="ultraviolet-glass">
              <span class="zd-theme-dot" style="background:#c084fc; box-shadow:0 0 8px #c084fc;"></span>
              <div>
                <strong>Ultraviolet Glass</strong>
                <small>Deep violet glassmorphism</small>
              </div>
            </div>
            <div class="zd-theme-card" data-theme="retro-terminal">
              <span class="zd-theme-dot" style="background:#4ade80; box-shadow:0 0 8px #4ade80;"></span>
              <div>
                <strong>Retro Terminal</strong>
                <small>CRT monochrome green phosphor</small>
              </div>
            </div>
            <div class="zd-theme-card" data-theme="minimalist-clean">
              <span class="zd-theme-dot" style="background:#ffffff; box-shadow:0 0 8px #ffffff;"></span>
              <div>
                <strong>Minimalist Clean</strong>
                <small>Crisp slate typography & lines</small>
              </div>
            </div>
          </div>
        </div>

        <!-- Components to Generate -->
        <div class="zd-card">
          <h2 class="zd-card-title">5. Components & Layout Rail</h2>
          <div class="zd-check-grid" id="components-grid">
            <label class="zd-checkbox"><input type="checkbox" value="navbar" checked disabled /> Sticky Glass Navbar</label>
            <label class="zd-checkbox"><input type="checkbox" value="hero" checked /> Interactive Particle Hero</label>
            <label class="zd-checkbox"><input type="checkbox" value="features" checked /> Bento Feature Cards</label>
            <label class="zd-checkbox"><input type="checkbox" value="sandbox" checked /> Live Interactive Demo Sandbox</label>
            <label class="zd-checkbox"><input type="checkbox" value="pricing" checked /> 3-Tier Pricing Matrix</label>
            <label class="zd-checkbox"><input type="checkbox" value="faq" checked /> FAQ Accordion</label>
            <label class="zd-checkbox"><input type="checkbox" value="contact" checked /> Netlify-Ready Contact Form</label>
            <label class="zd-checkbox"><input type="checkbox" value="audio_sfx" checked /> Procedural Web Audio SFX</label>
            <label class="zd-checkbox"><input type="checkbox" value="aeo_llms" checked /> AEO llms.txt + JSON-LD</label>
          </div>
        </div>

        <!-- Master Prompt Input -->
        <div class="zd-card">
          <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.4rem;">
            <h2 class="zd-card-title" style="margin:0;">6. Master Prompt & Custom Requirements</h2>
            <div class="zd-presets">
              <button class="zd-preset-chip" onclick="applyPreset('saas')">SaaS</button>
              <button class="zd-preset-chip" onclick="applyPreset('vault')">Vault</button>
              <button class="zd-preset-chip" onclick="applyPreset('portfolio')">Portfolio</button>
            </div>
          </div>
          <textarea id="master-prompt" rows="4" class="zd-textarea" placeholder="Describe the specific purpose, features, audience, and visual styling for your site...">Build a high-performance, dark glassmorphic SaaS landing page for ApexVault. Include an interactive cryptographic vault sandbox, 3 pricing tiers with monthly/annual toggle, audio chimes on click, and OWASP security headers.</textarea>
        </div>

      </div>
    </div>

    <div class="zd-action-bar" style="display:flex; justify-content:center; gap:1rem; flex-wrap:wrap;">
      <button class="zd-btn-fast" id="btn-fast-build" onclick="startFastTemplateBuild()">
        ⚡ Fast Template Build (&lt; 1s)
      </button>
      <button class="zd-btn-generate" id="btn-generate" onclick="startSwarmGeneration()">
        🤖 Swarm Multi-Agent Synthesis (4-Agent Team) →
      </button>
    </div>
  </section>


  <!-- ─── STEP 2: LIVE SWARM MULTI-AGENT EXECUTION ─── -->
  <section class="zd-step" id="step-swarm-exec">
    <div class="zd-step-head">
      <h1 class="zd-step-title">Swarm Multi-Agent Collaboration Active</h1>
      <p class="zd-step-desc">The 4 Core Spirit Agents are synthesizing, auditing, and compiling your web application on loopback.</p>
    </div>

    <!-- Agent HUD -->
    <div class="zd-agent-hud">
      <div class="zd-agent-pill" id="agent-lycan">
        <span class="zd-agent-emoji">🐺</span>
        <div>
          <strong>@antigravity (Lycan)</strong>
          <small class="zd-agent-status">Auditing OWASP CSP & WCAG AA...</small>
        </div>
      </div>
      <div class="zd-agent-pill" id="agent-kitsune">
        <span class="zd-agent-emoji">🦊</span>
        <div>
          <strong>@grok (Kitsune)</strong>
          <small class="zd-agent-status">Synthesizing Glassmorphism UI...</small>
        </div>
      </div>
      <div class="zd-agent-pill" id="agent-draco">
        <span class="zd-agent-emoji">🐲</span>
        <div>
          <strong>@hermes (Draco)</strong>
          <small class="zd-agent-status">Compiling JSON-LD & llms.txt...</small>
        </div>
      </div>
      <div class="zd-agent-pill" id="agent-workbot">
        <span class="zd-agent-emoji">🤖</span>
        <div>
          <strong>@ollama (Workbot)</strong>
          <small class="zd-agent-status">Generating Custom Logic...</small>
        </div>
      </div>
    </div>

    <!-- Live Execution Stream -->
    <div class="zd-terminal">
      <div class="zd-terminal-bar">
        <span class="zd-term-dot red"></span>
        <span class="zd-term-dot yellow"></span>
        <span class="zd-term-dot green"></span>
        <span class="zd-term-title">zoth-swarm-foundry :: loopback execution stream</span>
      </div>
      <div class="zd-terminal-body" id="swarm-logs">
        <div class="zd-log-line">🚀 [Swarm Master] Initializing multi-agent website synthesis pipeline...</div>
      </div>
    </div>
  </section>


  <!-- ─── STEP 3: MASTER ARTIFACTS & LIVE PREVIEW ─── -->
  <section class="zd-step" id="step-preview">
    
    <!-- Top Preview Controls -->
    <div class="zd-preview-topbar">
      <div class="zd-preview-tabs">
        <button class="zd-view-tab active" data-view="sandbox" onclick="switchView('sandbox')">🖥️ Live Interactive Preview</button>
        <button class="zd-view-tab" data-view="code" onclick="switchView('code')">💻 Source Code</button>
        <button class="zd-view-tab" data-view="prompt" onclick="switchView('prompt')">📋 Master Prompt</button>
        <button class="zd-view-tab" data-view="instructions" onclick="switchView('instructions')">📐 Instructions</button>
        <button class="zd-view-tab" data-view="blueprint" onclick="switchView('blueprint')">🏗️ Blueprint</button>
        <button class="zd-view-tab" data-view="llms" onclick="switchView('llms')">🤖 llms.txt AEO</button>
      </div>

      <div class="zd-preview-actions">
        <!-- Viewport Selectors -->
        <div class="zd-viewport-btns" id="viewport-controls">
          <button class="zd-vp-btn active" title="Desktop" onclick="setViewport('100%')">🖥️</button>
          <button class="zd-vp-btn" title="Tablet (768px)" onclick="setViewport('768px')">💻</button>
          <button class="zd-vp-btn" title="Mobile (375px)" onclick="setViewport('375px')">📱</button>
        </div>

        <a id="btn-open-newtab" href="#" target="_blank" class="zd-btn-action primary">
          🚀 Open in New Tab
        </a>
        <button class="zd-btn-action" onclick="downloadSiteBundle()">
          💾 Download Site (.html)
        </button>
        <button class="zd-btn-action" onclick="goToStep('config')">
          ⚡ Tweak & Re-prompt
        </button>
      </div>
    </div>

    <!-- Live Sandbox Frame Area -->
    <div class="zd-preview-stage" id="preview-stage">
      <div class="zd-frame-container" id="frame-container" style="width: 100%;">
        <iframe id="site-iframe" class="zd-site-frame" sandbox="allow-scripts allow-same-origin allow-forms"></iframe>
      </div>

      <!-- Code Inspector (Hidden by default) -->
      <div class="zd-code-panel" id="code-panel" style="display: none;">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:0.75rem;">
          <strong id="code-panel-title">Source Code (HTML5/CSS/JS)</strong>
          <button class="zd-copy-btn" onclick="copyCurrentCode()">Copy Content</button>
        </div>
        <pre class="zd-code-block" id="code-viewer"></pre>
      </div>
    </div>

  </section>

  <!-- ─── DRIVE PROJECTS VAULT MODAL (258+ SITES) ─── -->
  <div id="drive-modal" class="zd-modal-overlay" style="display:none;">
    <div class="zd-modal-dialog">
      <div class="zd-modal-header">
        <div>
          <h2 class="zd-modal-title">📂 Mounted Drive Projects & Templates Vault</h2>
          <p class="zd-modal-subtitle">Directly load any of the 258+ existing apps/sites on drive into the JSON Customizer.</p>
        </div>
        <button class="zd-modal-close" onclick="closeDriveModal()">✕</button>
      </div>

      <!-- Category Filter Tabs & Search -->
      <div class="zd-modal-toolbar">
        <input type="text" id="drive-search" class="zd-modal-search" placeholder="🔍 Search 258+ projects by name or keyword..." oninput="onDriveSearch(this.value)" />
        <div class="zd-modal-cats" id="drive-cat-pills">
          <button class="zd-cat-pill active" data-cat="all" onclick="filterDriveCat('all')">All (258)</button>
          <button class="zd-cat-pill" data-cat="01-clients-services" onclick="filterDriveCat('01-clients-services')">🏢 Clients (38)</button>
          <button class="zd-cat-pill" data-cat="04-web-apps-saas" onclick="filterDriveCat('04-web-apps-saas')">🚀 SaaS (66)</button>
          <button class="zd-cat-pill" data-cat="03-ai-agents-llm" onclick="filterDriveCat('03-ai-agents-llm')">🤖 AI Agents (26)</button>
          <button class="zd-cat-pill" data-cat="02-netlify-ax-creator" onclick="filterDriveCat('02-netlify-ax-creator')">⚡ Netlify AX (16)</button>
          <button class="zd-cat-pill" data-cat="05-portfolio-agency" onclick="filterDriveCat('05-portfolio-agency')">💼 Portfolios (12)</button>
          <button class="zd-cat-pill" data-cat="07-security-osint" onclick="filterDriveCat('07-security-osint')">🛡️ OSINT (9)</button>
          <button class="zd-cat-pill" data-cat="13-creative-media" onclick="filterDriveCat('13-creative-media')">🎨 Media (51)</button>
        </div>
      </div>

      <!-- Project Cards Grid -->
      <div class="zd-modal-body" id="drive-projects-grid">
        <div style="text-align:center; padding:3rem; color:#8493b8;">Loading drive projects catalog...</div>
      </div>

      <div class="zd-modal-footer">
        <span id="drive-count-status" style="font-size:0.8rem; color:#8493b8; font-family:'IBM Plex Mono',monospace;">258 Projects Ready on Hard Drive</span>
        <button class="zd-btn-sm" onclick="closeDriveModal()">Done</button>
      </div>
    </div>
  </div>

</main>

<script is:inline>
(function() {
  'use strict';

  // Global State
  const STATE = {
    niche: 'saas',
    fw: 'vite-react',
    theme: 'obsidian-gold',
    result: null,
    currentView: 'sandbox'
  };

  const $ = (id) => document.getElementById(id);

  // 1. Niche Selection
  document.querySelectorAll('#niche-grid .zd-pill').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('#niche-grid .zd-pill').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      STATE.niche = btn.dataset.niche;
    });
  });

  // 2. Framework Selection
  document.querySelectorAll('#fw-grid .zd-fw-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('#fw-grid .zd-fw-item').forEach(i => i.classList.remove('active'));
      item.classList.add('active');
      STATE.fw = item.dataset.fw;
    });
  });

  // 3. Theme Selection
  document.querySelectorAll('#theme-grid .zd-theme-card').forEach(card => {
    card.addEventListener('click', () => {
      document.querySelectorAll('#theme-grid .zd-theme-card').forEach(c => c.classList.remove('active'));
      card.classList.add('active');
      STATE.theme = card.dataset.theme;
    });
  });

  // 0. Template Archetype Selection
  window.selectTemplate = function(tmplId) {
    STATE.templateId = tmplId;
    document.querySelectorAll('#template-archetype-grid .zd-template-card').forEach(c => c.classList.remove('active'));
    document.querySelector(`.zd-template-card[data-tmpl="${tmplId}"]`)?.classList.add('active');

    if (tmplId === 'saas-vault') {
      $('site-name').value = 'ApexVault';
      $('site-tagline').value = 'Sovereign Multi-Agent Cryptographic Layer';
      $('master-prompt').value = 'Build a high-performance, dark glassmorphic SaaS landing page for ApexVault with Argon2id cryptographic sandbox, 3 pricing tiers, and audio chimes.';
      STATE.niche = 'saas';
      STATE.theme = 'obsidian-gold';
    } else if (tmplId === 'ai-platform') {
      $('site-name').value = 'NullAI Foundry';
      $('site-tagline').value = 'Autonomous Multi-Agent Intelligence Mesh';
      $('master-prompt').value = 'Create a next-gen autonomous agent cockpit featuring interactive terminal execution, DAG visualizer, and 16 spirit agents.';
      STATE.niche = 'ai-agent';
      STATE.theme = 'midnight-neon';
    } else if (tmplId === 'cyberpunk-web3') {
      $('site-name').value = 'Aetheris Protocol';
      $('site-tagline').value = 'Decentralized Autonomous Cyberspace Layer';
      $('master-prompt').value = 'Build a high-octane cyberpunk terminal portal with CRT phosphor scanlines, green glow tokens, and tokenomics matrix.';
      STATE.niche = 'cyberpunk';
      STATE.theme = 'acid-grid';
    } else if (tmplId === 'portfolio-dev') {
      $('site-name').value = 'Alex Vance';
      $('site-tagline').value = 'Senior Autonomous Systems & Multi-Agent Engineer';
      $('master-prompt').value = 'Build a sleek, minimalist developer portfolio showcasing 16 multi-agent frameworks, interactive terminal lab, and Netlify contact form.';
      STATE.niche = 'portfolio';
      STATE.theme = 'ultraviolet-glass';
    }
  };

  // Drive Projects Vault State & Logic
  let DRIVE_PROJECTS = [];
  let SELECTED_CAT = 'all';
  let DRIVE_SEARCH_QUERY = '';

  window.openDriveModal = async function() {
    $('drive-modal').style.display = 'flex';
    if (DRIVE_PROJECTS.length === 0) {
      try {
        const res = await fetch('/api/drive/projects');
        if (res.ok) {
          const data = await res.json();
          DRIVE_PROJECTS = data.projects || [];
          $('drive-count-status').textContent = `${DRIVE_PROJECTS.length} Projects Ready on Hard Drive`;
        }
      } catch (e) {
        console.error('Failed to load drive projects:', e);
      }
    }
    renderDriveProjects();
  };

  window.closeDriveModal = function() {
    $('drive-modal').style.display = 'none';
  };

  window.filterDriveCat = function(catId) {
    SELECTED_CAT = catId;
    document.querySelectorAll('#drive-cat-pills .zd-cat-pill').forEach(p => p.classList.remove('active'));
    document.querySelector(`.zd-cat-pill[data-cat="${catId}"]`)?.classList.add('active');
    renderDriveProjects();
  };

  window.onDriveSearch = function(val) {
    DRIVE_SEARCH_QUERY = (val || '').toLowerCase().trim();
    renderDriveProjects();
  };

  window.renderDriveProjects = function() {
    const grid = $('drive-projects-grid');
    if (!grid) return;

    let filtered = DRIVE_PROJECTS;
    if (SELECTED_CAT !== 'all') {
      filtered = filtered.filter(p => p.category_id === SELECTED_CAT);
    }
    if (DRIVE_SEARCH_QUERY) {
      filtered = filtered.filter(p => 
        (p.name && p.name.toLowerCase().includes(DRIVE_SEARCH_QUERY)) ||
        (p.description && p.description.toLowerCase().includes(DRIVE_SEARCH_QUERY)) ||
        (p.category_name && p.category_name.toLowerCase().includes(DRIVE_SEARCH_QUERY)) ||
        (p.id && p.id.toLowerCase().includes(DRIVE_SEARCH_QUERY))
      );
    }

    if (filtered.length === 0) {
      grid.innerHTML = '<div style="grid-column: 1 / -1; text-align:center; padding:3rem; color:#8493b8;">No matching projects found on drive.</div>';
      return;
    }

    grid.innerHTML = filtered.map(p => `
      <div class="zd-drive-card">
        <div class="zd-drive-card-header">
          <div>
            <span class="zd-drive-badge">${p.category_name.split('&')[0]}</span>
            <span class="zd-drive-fw">${p.framework}</span>
          </div>
        </div>
        <h3 class="zd-drive-name">${p.name}</h3>
        <p class="zd-drive-desc">${p.description || 'Autonomous project on drive.'}</p>
        <div class="zd-drive-card-footer">
          <span class="zd-drive-path">${p.relative_path}</span>
          <button class="zd-btn-import" onclick="loadDriveProject('${p.path}')">⚡ Load as Template</button>
        </div>
      </div>
    `).join('');
  };

  window.loadDriveProject = async function(projectPath) {
    try {
      const res = await fetch('/api/drive/import-as-template', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: projectPath })
      });
      if (res.ok) {
        const data = await res.json();
        const bp = data.blueprint;
        $('site-name').value = bp.brandName || 'Custom App';
        $('site-tagline').value = bp.tagline || 'Autonomous Web System';
        $('master-prompt').value = bp.heroSubheadline || `Build custom website inspired by ${bp.brandName}.`;
        closeDriveModal();
        alert(`✓ Loaded "${bp.brandName}" from drive into Website Builder! You can now customize keywords, copy, colors, fonts, routes and generate.`);
      }
    } catch (e) {
      console.error('Error importing project:', e);
    }
  };

  // Presets Helper
  window.applyPreset = function(type) {
    if (type === 'saas') window.selectTemplate('saas-vault');
    else if (type === 'vault') window.selectTemplate('saas-vault');
    else if (type === 'portfolio') window.selectTemplate('portfolio-dev');
  };

  // Fast Template Build (< 1s)
  window.startFastTemplateBuild = async function() {
    const tmplId = STATE.templateId || 'saas-vault';
    const payload = {
      templateId: tmplId,
      brandName: $('site-name').value.trim() || 'ApexVault',
      tagline: $('site-tagline').value.trim() || 'Sovereign Multi-Agent Cryptographic Layer',
      heroHeadline: $('site-tagline').value.trim() || 'Sovereign Key Enclaves for Autonomous AI Swarms',
      heroSubheadline: $('master-prompt').value.trim(),
      primaryColor: STATE.theme === 'acid-grid' ? '#34d399' : (STATE.theme === 'midnight-neon' ? '#00f0ff' : '#e8c872')
    };

    try {
      const res = await fetch('/api/templates/hydrate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      if (res.ok) {
        STATE.result = await res.json();
        renderLivePreview(STATE.result);
      } else {
        throw new Error('Hydrate server error');
      }
    } catch (e) {
      STATE.result = generateClientFallback({
        projectName: payload.brandName,
        tagline: payload.tagline,
        masterPrompt: payload.heroSubheadline,
        theme: STATE.theme,
        framework: STATE.fw
      });
      renderLivePreview(STATE.result);
    }
  };

  // Step Switcher
  window.goToStep = function(stepId) {
    document.querySelectorAll('.zd-step').forEach(s => s.classList.remove('active'));
    $('step-' + stepId).classList.add('active');
  };

  // 4. Start Swarm Generation
  window.startSwarmGeneration = async function() {
    goToStep('swarm-exec');
    const logs = $('swarm-logs');
    logs.innerHTML = '';

    function log(text) {
      const d = document.createElement('div');
      d.className = 'zd-log-line';
      d.textContent = text;
      logs.appendChild(d);
      logs.scrollTop = logs.scrollHeight;
    }

    log('🚀 [Swarm Conductor] Dispatching Master Prompt across 4 Core Spirit Agents...');
    
    const payload = {
      projectName: $('site-name').value.trim() || 'ApexApp',
      tagline: $('site-tagline').value.trim() || 'Autonomous Multi-Agent Application',
      niche: STATE.niche,
      theme: STATE.theme,
      framework: STATE.fw,
      components: Array.from(document.querySelectorAll('#components-grid input:checked')).map(i => i.value),
      masterPrompt: $('master-prompt').value.trim()
    };

    // Animate HUD
    setTimeout(() => {
      log('🐺 [Lycan @antigravity] Validating OWASP Top 10 CSP & WCAG AA tokens...');
      $('agent-lycan').classList.add('active');
    }, 400);

    setTimeout(() => {
      log('🦊 [Kitsune @grok] Synthesizing Glassmorphism UI tokens, particle canvas, & responsive layout...');
      $('agent-kitsune').classList.add('active');
    }, 900);

    setTimeout(() => {
      log('🐲 [Draco @hermes] Constructing Schema.org JSON-LD graph & llms.txt AEO manifest...');
      $('agent-draco').classList.add('active');
    }, 1400);

    setTimeout(() => {
      log('🤖 [Workbot @ollama] Compiling neural copy & interactive sandbox logic on loopback...');
      $('agent-workbot').classList.add('active');
    }, 1900);

    try {
      // Call local backend endpoint
      const res = await fetch('/api/studio/generate-site', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      if (res.ok) {
        STATE.result = await res.json();
      } else {
        throw new Error('Server returned ' + res.status);
      }
    } catch(err) {
      log('⚠️ [Notice] Local backend busy — rendering direct client-side synthesis package...');
      // Fallback direct synthesis
      STATE.result = generateClientFallback(payload);
    }

    setTimeout(() => {
      log('✅ [Swarm Complete] Website compiled and verified! Opening Live Sandbox Preview...');
      setTimeout(() => {
        renderLivePreview(STATE.result);
      }, 600);
    }, 2400);
  };

  // Render Preview
  function renderLivePreview(data) {
    goToStep('preview');
    
    // Set iframe content
    const iframe = $('site-iframe');
    iframe.srcdoc = data.code;

    // Set new tab link
    const newTabBtn = $('btn-open-newtab');
    if (data.previewUrl) {
      newTabBtn.href = data.previewUrl;
      newTabBtn.style.display = 'inline-flex';
    } else {
      newTabBtn.style.display = 'none';
    }

    switchView('sandbox');
  }

  // View Switcher
  window.switchView = function(view) {
    STATE.currentView = view;
    document.querySelectorAll('.zd-view-tab').forEach(t => t.classList.remove('active'));
    document.querySelector(`.zd-view-tab[data-view="${view}"]`)?.classList.add('active');

    const stage = $('preview-stage');
    const frameContainer = $('frame-container');
    const codePanel = $('code-panel');
    const vpControls = $('viewport-controls');

    if (view === 'sandbox') {
      frameContainer.style.display = 'block';
      codePanel.style.display = 'none';
      vpControls.style.display = 'flex';
    } else {
      frameContainer.style.display = 'none';
      codePanel.style.display = 'block';
      vpControls.style.display = 'none';

      const viewer = $('code-viewer');
      const title = $('code-panel-title');

      if (view === 'code') {
        title.textContent = 'Source Code (HTML5/CSS/JS)';
        viewer.textContent = STATE.result?.code || '';
      } else if (view === 'prompt') {
        title.textContent = 'Master Prompt';
        viewer.textContent = STATE.result?.masterPrompt || '';
      } else if (view === 'instructions') {
        title.textContent = 'Master Instructions';
        viewer.textContent = STATE.result?.masterInstructions || '';
      } else if (view === 'blueprint') {
        title.textContent = 'Master Blueprint';
        viewer.textContent = STATE.result?.masterBlueprint || '';
      } else if (view === 'llms') {
        title.textContent = 'AEO llms.txt Manifest';
        viewer.textContent = STATE.result?.llmsTxt || '';
      }
    }
  };

  // Viewport Switcher
  window.setViewport = function(width) {
    document.querySelectorAll('.zd-vp-btn').forEach(b => b.classList.remove('active'));
    const btn = Array.from(document.querySelectorAll('.zd-vp-btn')).find(b => b.getAttribute('onclick')?.includes(width));
    if (btn) btn.classList.add('active');
    $('frame-container').style.width = width;
  };

  // Copy Code
  window.copyCurrentCode = function() {
    const text = $('code-viewer').textContent;
    navigator.clipboard.writeText(text).then(() => {
      const b = document.querySelector('.zd-copy-btn');
      b.textContent = '✓ Copied';
      setTimeout(() => b.textContent = 'Copy Content', 2000);
    });
  };

  // Download Bundle
  window.downloadSiteBundle = function() {
    const blob = new Blob([STATE.result?.code || ''], { type: 'text/html' });
    const u = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = u;
    a.download = (STATE.result?.slug || 'zoth-site') + '.html';
    a.click();
    URL.revokeObjectURL(u);
  };

  // Client Fallback Synthesizer
  function generateClientFallback(p) {
    const safe = p.projectName.toLowerCase().replace(/[^a-z0-9]/g, '-');
    return {
      status: 'ok',
      siteName: p.projectName,
      slug: safe,
      previewUrl: `/previews/${safe}/index.html`,
      masterPrompt: p.masterPrompt,
      masterInstructions: `## Master Instructions for ${p.projectName}\n- Framework: ${p.framework}\n- Theme: ${p.theme}`,
      masterBlueprint: `=== MASTER BLUEPRINT — ${p.projectName.toUpperCase()} ===\nTheme: ${p.theme}\nFramework: ${p.framework}`,
      llmsTxt: `# ${p.projectName}\n> ${p.tagline}\n\n${p.masterPrompt}`,
      code: `<!doctype html><html><head><meta charset="utf-8"/><title>${p.projectName}</title><style>body{background:#05070f;color:#f0f4fc;font-family:sans-serif;text-align:center;padding:4rem;}.card{background:#0a0e1c;border:1px solid #1a2342;padding:2rem;border-radius:16px;max-width:600px;margin:2rem auto;}</style></head><body><h1>⚡ ${p.projectName}</h1><p>${p.tagline}</p><div class="card"><h3>Swarm Compiled Output</h3><p>${p.masterPrompt}</p></div></body></html>`
    };
  }

})();
</script>


---
import NetlifyForm from "../components/NetlifyForm.astro";
// src/layouts/MainLayout.astro
import { defaultThemeVariantName, themeVariants } from '../configs/themes';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import type { FooterData } from '../configs/footer';
import type { NavData } from '../configs/nav';

// 1. Define the SEO interface
interface SEOData {
  title: string;
  description: string;
  ogImage?: string;
  keywords?: string[];
  author?: string;
}

interface Props {
  title?: string;
  weight: number;
  seo: SEOData; // Required SEO prop for every page
  navVariant?: string;
  footerVariant?: string;
  themeVariant?: string;
  navData?: NavData;
  footerData?: FooterData;
}

const { weight, seo, navVariant, footerVariant, themeVariant, navData, footerData } = Astro.props;
const FALLBACK_FONT_STACK = "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif";
const FALLBACK_THEME = {
  bg: '#ffffff',
  text: '#1e293b',
  accent: '#2563eb',
  surface: '#f8fafc',
  surfaceElevated: '#eef2ff',
  border: '#cbd5e1',
  textMuted: '#475569',
  textInverse: '#ffffff',
  accentContrast: '#ffffff',
  font: FALLBACK_FONT_STACK,
  fontBody: FALLBACK_FONT_STACK,
  fontDisplay: FALLBACK_FONT_STACK,
} as const;

type ThemeConfig = {
  mode?: 'light' | 'dark' | 'system';
  activeTheme?: 'light' | 'dark';
  fontUrls?: string[];
  themes?: Record<'light' | 'dark', Record<string, unknown>>;
};
type ThemeMode = 'light' | 'dark' | 'system';

const selectedThemeConfig = (themeVariants[themeVariant as keyof typeof themeVariants] ??
  themeVariants[defaultThemeVariantName]) as unknown as ThemeConfig;

const configuredMode = (selectedThemeConfig.mode ?? selectedThemeConfig.activeTheme ?? 'light') as ThemeMode;
const themeMode: ThemeMode = ['light', 'dark', 'system'].includes(configuredMode) ? configuredMode : 'light';
const activeThemeKey = (selectedThemeConfig.activeTheme ?? 'light') as 'light' | 'dark';
const fontUrls = Array.isArray(selectedThemeConfig.fontUrls) ? selectedThemeConfig.fontUrls : [];

const getThemeToken = (value: unknown, fallback: string) =>
  typeof value === 'string' && value.trim().length > 0 ? value.trim() : fallback;

const normalizeTheme = (theme: Record<string, unknown> | undefined) => ({
  bg: getThemeToken(theme?.bg, FALLBACK_THEME.bg),
  text: getThemeToken(theme?.text, FALLBACK_THEME.text),
  accent: getThemeToken(theme?.accent, FALLBACK_THEME.accent),
  surface: getThemeToken(theme?.surface, FALLBACK_THEME.surface),
  surfaceElevated: getThemeToken(theme?.surfaceElevated, FALLBACK_THEME.surfaceElevated),
  border: getThemeToken(theme?.border, FALLBACK_THEME.border),
  textMuted: getThemeToken(theme?.textMuted, FALLBACK_THEME.textMuted),
  textInverse: getThemeToken(theme?.textInverse, FALLBACK_THEME.textInverse),
  accentContrast: getThemeToken(theme?.accentContrast, FALLBACK_THEME.accentContrast),
  font: getThemeToken(theme?.font, FALLBACK_THEME.font),
  fontBody: getThemeToken(theme?.fontBody, FALLBACK_THEME.fontBody),
  fontDisplay: getThemeToken(theme?.fontDisplay, FALLBACK_THEME.fontDisplay),
});

const lightTheme = normalizeTheme(selectedThemeConfig.themes?.light as Record<string, unknown> | undefined);
const darkTheme = normalizeTheme(selectedThemeConfig.themes?.dark as Record<string, unknown> | undefined);

const baseTheme =
  themeMode === 'dark'
    ? darkTheme
    : themeMode === 'light'
      ? lightTheme
      : activeThemeKey === 'dark'
        ? darkTheme
        : lightTheme;

const toThemeVars = (theme: typeof baseTheme) =>
  [
    `--bg:${theme.bg}`,
    `--text:${theme.text}`,
    `--accent:${theme.accent}`,
    `--surface:${theme.surface}`,
    `--surfaceElevated:${theme.surfaceElevated}`,
    `--border:${theme.border}`,
    `--textMuted:${theme.textMuted}`,
    `--textInverse:${theme.textInverse}`,
    `--accentContrast:${theme.accentContrast}`,
    `--surfaceColor:${theme.surface}`,
    `--surfaceElevatedColor:${theme.surfaceElevated}`,
    `--borderColor:${theme.border}`,
    `--textMutedColor:${theme.textMuted}`,
    `--textInverseColor:${theme.textInverse}`,
    `--accentContrastColor:${theme.accentContrast}`,
    `--bgColor:${theme.bg}`,
    `--textColor:${theme.text}`,
    `--accentColor:${theme.accent}`,
    `--fontFamily:${theme.font}`,
    `--fontBody:${theme.fontBody}`,
    `--fontDisplay:${theme.fontDisplay}`,
  ].join(';');

const baseThemeVars = toThemeVars(baseTheme);
const lightThemeVars = toThemeVars(lightTheme);
const darkThemeVars = toThemeVars(darkTheme);
const colorScheme = themeMode === 'dark' ? 'dark' : 'light';
const htmlThemeData = themeMode;
const themeModeStyles = `
html[data-theme='light'] { ${lightThemeVars}; color-scheme: light; }
html[data-theme='dark'] { ${darkThemeVars}; color-scheme: dark; }
html[data-theme='system'] { ${lightThemeVars}; color-scheme: light; }
@media (prefers-color-scheme: dark) {
  html[data-theme='system'] { ${darkThemeVars}; color-scheme: dark; }
}
`;
const prettyThemeName = (key: string) =>
  key
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');
const themeOptions = Object.keys(themeVariants)
  .sort((a, b) => a.localeCompare(b))
  .map((key) => ({ value: key, label: prettyThemeName(key) }));
const normalizedThemeCatalog = Object.fromEntries(
  Object.entries(themeVariants).map(([key, value]) => {
    const variant = value as unknown as ThemeConfig;
    return [
      key,
      {
        mode: variant.mode ?? 'system',
        activeTheme: variant.activeTheme ?? 'light',
        fontUrls: Array.isArray(variant.fontUrls) ? variant.fontUrls : [],
        light: (variant.themes?.light as Record<string, string> | undefined) ?? {},
        dark:
          (variant.themes?.dark as Record<string, string> | undefined) ??
          (variant.themes?.light as Record<string, string> | undefined) ??
          {},
      },
    ];
  })
);
const themeCatalogJson = JSON.stringify(normalizedThemeCatalog);
const themePickerDefaultVariant = (themeVariant as string) || defaultThemeVariantName;
---
<html lang="en" style={`${baseThemeVars};color-scheme:${colorScheme};`} data-theme={htmlThemeData}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeMode === 'dark' ? darkTheme.bg : lightTheme.bg} />
    <meta name="theme-color" content={lightTheme.bg} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={darkTheme.bg} media="(prefers-color-scheme: dark)" />
    
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    {seo.author && <meta name="author" content={seo.author} />}
    {seo.keywords && <meta name="keywords" content={seo.keywords.join(', ')} />}
    <meta property="og:title" content={seo.title} />
    <meta property="og:image" content={seo.ogImage || '/assets/logo.svg'} />
    {fontUrls.map((href) => (
      <link rel="stylesheet" href={href} />
    ))}

    <style is:global>
      :root {
        -webkit-text-size-adjust: 100%;
        text-size-adjust: 100%;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      html {
        background-color: var(--bg, var(--bgColor));
        background: var(--bg, var(--bgColor));
        color: var(--text, var(--textColor));
        overflow-x: clip;
      }

      body {
        min-height: 100vh;
        font-family: var(--fontFamily, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif);
        line-height: 1.5;
        background-color: var(--bg, var(--bgColor));
        background: var(--bg, var(--bgColor));
        color: var(--text, var(--textColor));
        overflow-x: clip;
        text-rendering: optimizeLegibility;
      }

      main {
        width: 100%;
      }

      img,
      picture,
      svg,
      canvas,
      video {
        display: block;
        max-width: 100%;
      }

      button,
      input,
      textarea,
      select {
        font: inherit;
      }

      a {
        color: inherit;
      }

      .global-theme-picker {
        position: fixed;
        right: 1rem;
        bottom: 1rem;
        z-index: 60;
        width: min(92vw, 320px);
        border-radius: 14px;
        border: 1px solid color-mix(in srgb, var(--textColor) 14%, transparent);
        background: color-mix(in srgb, var(--surfaceColor) 92%, var(--bgColor) 8%);
        box-shadow: 0 18px 34px -22px color-mix(in srgb, var(--textColor) 56%, transparent);
        overflow: hidden;
      }

      .global-theme-picker summary {
        list-style: none;
        cursor: pointer;
        user-select: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        padding: 0.68rem 0.84rem;
        font-size: 0.86rem;
        font-weight: 700;
      }

      .global-theme-picker summary::-webkit-details-marker {
        display: none;
      }

      .global-theme-picker summary span {
        color: color-mix(in srgb, var(--textColor) 74%, transparent);
        font-size: 0.72rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .global-theme-picker[open] summary {
        border-bottom: 1px solid color-mix(in srgb, var(--textColor) 10%, transparent);
      }

      .global-theme-picker__content {
        padding: 0.75rem 0.84rem 0.85rem;
        display: grid;
        gap: 0.58rem;
      }

      .global-theme-picker label {
        display: grid;
        gap: 0.26rem;
        font-size: 0.78rem;
        font-weight: 600;
      }

      .global-theme-picker select {
        border-radius: 9px;
        border: 1px solid color-mix(in srgb, var(--textColor) 16%, transparent);
        background: color-mix(in srgb, var(--bgColor) 94%, white 6%);
        color: var(--textColor);
        padding: 0.48rem 0.56rem;
      }

      .global-theme-picker p {
        margin: 0.15rem 0 0;
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: color-mix(in srgb, var(--textColor) 68%, transparent);
        font-weight: 700;
      }
    </style>
    <style is:inline set:html={themeModeStyles}></style>
      <link rel="stylesheet" href="/styles/animations.css" />
</head>
  <body>
    <Navbar data={navData} cvariant={navVariant} />
    <details class="global-theme-picker" id="global-theme-picker">
      <summary>
        <span>Theme</span>
        <strong id="global-theme-picker-label">{prettyThemeName(themePickerDefaultVariant)}</strong>
      </summary>
      <div class="global-theme-picker__content">
        <label>
          Palette
          <select id="global-theme-variant">
            {themeOptions.map((theme) => (
              <option value={theme.value} selected={theme.value === themePickerDefaultVariant}>{theme.label}</option>
            ))}
          </select>
        </label>
        <label>
          Mode
          <select id="global-theme-mode">
            <option value="light">Light</option>
            <option value="dark">Dark</option>
          </select>
        </label>
        <p id="global-theme-picker-status">Dashboard theme control</p>
      </div>
    </details>
    <main>
      <slot />
    </main>
    <Footer weight={weight} data={footerData} cvariant={footerVariant} />
    <script define:vars={{ themeCatalogJson, themePickerDefaultVariant }}>
      const themeCatalog = JSON.parse(themeCatalogJson);
      const defaultThemeVariant = themePickerDefaultVariant;
      const variantSelect = document.getElementById('global-theme-variant');
      const modeSelect = document.getElementById('global-theme-mode');
      const pickerLabel = document.getElementById('global-theme-picker-label');
      const pickerStatus = document.getElementById('global-theme-picker-status');

      function prettifyThemeName(rawName = '') {
        return String(rawName)
          .split('-')
          .filter(Boolean)
          .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
          .join(' ');
      }

      function ensureThemeFonts(fontUrls = []) {
        document.querySelectorAll('link[data-theme-font=\"runtime\"]').forEach((node) => node.remove());
        fontUrls.forEach((href) => {
          const link = document.createElement('link');
          link.rel = 'stylesheet';
          link.href = href;
          link.setAttribute('data-theme-font', 'runtime');
          document.head.appendChild(link);
        });
      }

      function applyDashboardTheme(themeVariant, mode) {
        const root = document.documentElement;
        const candidateTheme = themeCatalog[themeVariant] || themeCatalog[defaultThemeVariant];
        if (!candidateTheme) return;

        const resolvedMode = mode === 'dark' || mode === 'light' ? mode : candidateTheme.activeTheme || 'light';
        const tokenSource = resolvedMode === 'dark' ? candidateTheme.dark || {} : candidateTheme.light || {};
        const tokenMap = {
          bg: ['--bg', '--bgColor'],
          text: ['--text', '--textColor'],
          accent: ['--accent', '--accentColor'],
          surface: ['--surface', '--surfaceColor'],
          surfaceElevated: ['--surfaceElevated', '--surfaceElevatedColor'],
          border: ['--border', '--borderColor'],
          textMuted: ['--textMuted', '--textMutedColor'],
          textInverse: ['--textInverse', '--textInverseColor'],
          accentContrast: ['--accentContrast', '--accentContrastColor'],
        };

        Object.entries(tokenMap).forEach(([tokenName, vars]) => {
          const value = tokenSource[tokenName];
          if (typeof value !== 'string' || value.trim().length === 0) return;
          vars.forEach((variableName) => root.style.setProperty(variableName, value));
        });

        if (typeof tokenSource.font === 'string') root.style.setProperty('--fontFamily', tokenSource.font);
        if (typeof tokenSource.fontBody === 'string') root.style.setProperty('--fontBody', tokenSource.fontBody);
        if (typeof tokenSource.fontDisplay === 'string') root.style.setProperty('--fontDisplay', tokenSource.fontDisplay);

        root.setAttribute('data-theme', resolvedMode);
        root.style.setProperty('color-scheme', resolvedMode);
        ensureThemeFonts(Array.isArray(candidateTheme.fontUrls) ? candidateTheme.fontUrls : []);

        if (variantSelect) variantSelect.value = themeVariant;
        if (modeSelect) modeSelect.value = resolvedMode;
        if (pickerLabel) pickerLabel.textContent = prettifyThemeName(themeVariant);
        if (pickerStatus) pickerStatus.textContent = `Using ${prettifyThemeName(themeVariant)} (${resolvedMode})`;

        localStorage.setItem('astroplanet:themeVariant', themeVariant);
        localStorage.setItem('astroplanet:themeMode', resolvedMode);
      }

      variantSelect?.addEventListener('change', () => {
        applyDashboardTheme(variantSelect.value, modeSelect?.value || 'light');
      });

      modeSelect?.addEventListener('change', () => {
        applyDashboardTheme(variantSelect?.value || defaultThemeVariant, modeSelect.value);
      });

      const savedVariant = localStorage.getItem('astroplanet:themeVariant') || defaultThemeVariant;
      const savedMode = localStorage.getItem('astroplanet:themeMode') || 'light';
      applyDashboardTheme(savedVariant, savedMode);
    </script>
      <script is:inline>
      (function() {
        if (window.__apAnimationsReady) return;
        window.__apAnimationsReady = true;
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('ap-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.ap-reveal, .ap-reveal-left, .ap-reveal-right, .ap-reveal-scale').forEach((el) => {
          observer.observe(el);
        });
        const mo = new MutationObserver(() => {
          document.querySelectorAll('.ap-reveal:not(.ap-visible), .ap-reveal-left:not(.ap-visible), .ap-reveal-right:not(.ap-visible), .ap-reveal-scale:not(.ap-visible)').forEach((el) => observer.observe(el));
        });
        mo.observe(document.body, { childList: true, subtree: true });
      })();
    </script>
  <NetlifyForm />
</body>
</html>

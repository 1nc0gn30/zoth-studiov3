{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "role": {"type": "string", "minLength": 3, "maxLength": 80},
    "depth": {"type": "string", "enum": ["fast", "balanced", "deep"]},
    "autonomy": {"type": "string", "enum": ["ask-first", "bounded", "end-to-end"]},
    "style": {"type": "string", "enum": ["direct", "teacher", "operator", "reviewer"]},
    "capabilities": {
      "type": "array",
      "items": {"type": "string", "enum": ["read-files", "edit-files", "run-tests", "fetch-web", "deploy-preview"]},
      "uniqueItems": true
    },
    "deliverable": {"type": "string", "minLength": 3, "maxLength": 120}
  },
  "required": ["role", "depth", "autonomy", "deliverable"]
}

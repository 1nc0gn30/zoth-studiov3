{
  "schema": "design-token-schema/v1",
  "description": "Formal schema for AstroPlanet theme tokens. Each theme file is a JSON object with this structure.",
  "example_theme": "forest-mist",
  "structure": {
    "mode": {
      "type": "string",
      "values": ["system", "light-only", "dark-only"],
      "description": "Whether the theme supports light, dark, or both modes"
    },
    "activeTheme": {
      "type": "string",
      "values": ["light", "dark"],
      "description": "Default active theme mode"
    },
    "fontUrls": {
      "type": "array of strings",
      "description": "Google Fonts URLs to load for this theme"
    },
    "themes": {
      "type": "object",
      "description": "Color and font definitions per mode",
      "properties": {
        "light": { "$ref": "#/definitions/themeMode" },
        "dark": { "$ref": "#/definitions/themeMode" }
      }
    }
  },
  "definitions": {
    "themeMode": {
      "type": "object",
      "properties": {
        "bg": { "type": "hex-color", "description": "Page background" },
        "text": { "type": "hex-color", "description": "Body text" },
        "accent": { "type": "hex-color", "description": "Primary accent / CTA color" },
        "surface": { "type": "hex-color", "description": "Card / surface background" },
        "surfaceElevated": { "type": "hex-color", "description": "Elevated surface (modals, dropdowns)" },
        "border": { "type": "hex-color", "description": "Border and divider color" },
        "textMuted": { "type": "hex-color", "description": "Secondary / muted text" },
        "textInverse": { "type": "hex-color", "description": "Text on accent backgrounds" },
        "accentContrast": { "type": "hex-color", "description": "Text on accent (readability guarantee)" },
        "font": { "type": "string", "description": "Primary font family" },
        "fontBody": { "type": "string", "description": "Body text font" },
        "fontDisplay": { "type": "string", "description": "Display / heading font" }
      }
    }
  },
  "component_section_types": [
    {
      "type": "hero",
      "description": "Full-width hero section with heading, subtext, CTA buttons",
      "variants": ["default", "compact", "split", "centered", "background-image"]
    },
    {
      "type": "features",
      "description": "Feature grid or showcase",
      "variants": ["DefaultGrid", "SplitShowcase", "StepsRail"]
    },
    {
      "type": "content",
      "description": "Rich text content block"
    },
    {
      "type": "form",
      "description": "Contact / signup form",
      "variants": ["CapsuleInline", "GlassFloat", "MonoStack", "NeonCard", "PanelGrid", "PaperStack"]
    },
    {
      "type": "gallery",
      "description": "Image / media gallery"
    },
    {
      "type": "footer",
      "description": "Page footer with 12 variant styles",
      "variants": ["Default", "AccentBand", "CenteredStack", "DenseLine", "DockedPills", "FloatingCard", "GlassRow", "GridPanel", "InlineBar", "SplitColumns", "StackedCards"]
    },
    {
      "type": "social-links",
      "description": "Social media link section"
    },
    {
      "type": "ui-kit",
      "description": "Config-driven UI kit blocks (pricing decks, FAQ accordions, stats ribbons, testimonials walls, etc.) - 19+ variants"
    }
  ],
  "all_theme_names": [
    "acid-grid", "alpine-charcoal", "arctic-minimal", "aurora-dream",
    "brutalist-ink", "candy-pop", "celestial-violet", "citrus-punch",
    "cobalt-amber", "copper-slate", "editorial-serene", "ember-canyon",
    "emerald-ink", "forest-mist", "glacier-ink", "graffiti-3d-burst",
    "graphite-rose", "ivory-luxe", "lagoon-studio", "liquid-chrome",
    "midnight-neon", "minty-lab", "mono-zen", "neon-circuit",
    "noir-sakura", "nordic-frost", "obsidian-gold", "oceanic-noir",
    "pixel-playground", "retro-terminal", "royal-opera", "solar-flare",
    "sunset-editorial", "synth-candy", "terracotta-earth",
    "ultraviolet-glass", "velvet-noir"
  ]
}

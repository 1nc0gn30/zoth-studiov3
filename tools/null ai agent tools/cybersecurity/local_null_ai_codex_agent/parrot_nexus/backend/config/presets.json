[
  {
    "id": "nmap-quick",
    "name": "Nmap Quick Scan",
    "description": "Fast top-ports scan against one target.",
    "category": "Information Gathering",
    "executable": "nmap",
    "args": ["-F", "{{target}}"],
    "variables": [
      {"name": "target", "label": "Target", "default": "127.0.0.1"}
    ],
    "cwd": "",
    "env": {}
  },
  {
    "id": "gobuster-dir",
    "name": "Gobuster Directory Scan",
    "description": "Directory brute force with common wordlist.",
    "category": "Web Application Analysis",
    "executable": "gobuster",
    "args": ["dir", "-u", "{{url}}", "-w", "{{wordlist}}"],
    "variables": [
      {"name": "url", "label": "URL", "default": "http://127.0.0.1"},
      {"name": "wordlist", "label": "Wordlist", "default": "/usr/share/wordlists/dirb/common.txt"}
    ],
    "cwd": "",
    "env": {}
  },
  {
    "id": "codex-ollama-cloud-agent",
    "name": "Codex Ollama Agent",
    "description": "Launch codex with a selected cloud/local model via --model.",
    "category": "Intelligence",
    "executable": "codex",
    "args": ["--model", "{{model}}"],
    "variables": [
      {"name": "model", "label": "Model", "default": "gemma4:31b-cloud"}
    ],
    "cwd": "",
    "env": {}
  }
]

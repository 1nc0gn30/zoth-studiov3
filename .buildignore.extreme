# ==============================================================================
# ZOTH STUDIO — EXTREME BUILD EXCLUSION LIST (.buildignore.extreme)
# Used ONLY when VARIANT=extreme / --with-lab.
# Identical to .buildignore EXCEPT it intentionally KEEPS the Church of Malware
# lab (cybersecurity/churchofmalware) so the "Extreme" build bundles it as a
# local-only lab/. agent-comms/ stays excluded in BOTH variants (bus history
# is never shipped). No personal info about Zoth Studio Team may ship in either.
# ==============================================================================

# --- [ PERSONAL & CONVERSATION DATA ] ---
conversations.json
conversations/
data/conversations/
data/conversations.json
data/sessions/
data/history/
data/bundles/
bundles/
harness-settings.json
repos.json
*.chat
*.conv

# --- [ SECRETS, TOKENS & KEYS ] ---
byok.json
keys.json
secrets.json
.secret
.secrets
.vault
*.pem
*.key
*.pub
*.p12
*.pfx
*.token
token*
.env
.env.*
!.env.example
credentials.json
authorized_keys
id_rsa
id_ed25519
vault-daemon/keys/

# --- [ AGENT COMMS BUS HISTORY — NEVER SHIP (both variants) ] ---
agent-comms/

# --- [ DEV LOGS & SESSION TRACES ] ---
*.log
.collab*
.keepbusy*
.nvimlog
.codex
EOF
MDEOF
recordings/
traces/
agents_data/
reports/
*.report

# --- [ PYTHON & NODE ARTIFACTS ] ---
__pycache__/
*.py[cod]
*$py.class
*.bak
*.orig
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
node_modules/
.pnpm-store/
.npm/

# --- [ AI WEIGHTS & LOCAL DATASETS ] ---
zoth_training_dataset.jsonl
*.gguf
*.bin
*.pt
*.pth
*.onnx
weights/
models/

# --- [ BUILD ARTIFACTS & REPOS ] ---
dist-linux/
dist-windows/
dist/
.git/
.gitignore
.gitattributes
.buildignore
.buildignore.extreme
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

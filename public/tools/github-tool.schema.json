{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zoth GitHub Tool Contract",
  "description": "Strict request/response envelope for Zoth Studio's GitHub tool integration. Single source of truth: public/tools/github-tool.js validates inbound requests against this contract at runtime (mirrored logic, not a JSON-Schema library). This file is also valid 2020-12 JSON Schema for external tooling/codegen. The action-specific params are discriminated via root-level if/then (action is a sibling of params).",
  "type": "object",
  "required": ["action", "params", "meta"],
  "additionalProperties": false,
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "issues.list",
        "issues.create",
        "prs.list",
        "prs.create",
        "repos.list"
      ],
      "description": "Discriminator selecting the tool action."
    },
    "params": {
      "type": "object",
      "description": "Action-specific parameters. Exact shape is enforced per-action by the allOf/if-then below."
    },
    "meta": {
      "type": "object",
      "required": ["request_id", "ts"],
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "description": "Unique caller-generated ID for idempotency/correlation."
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "description": "ISO-8601 timestamp of when the request was formed."
        },
        "token_ref": {
          "type": "string",
          "minLength": 1,
          "description": "Reference to a stored GitHub token; actual secret is never sent in-band. The live client resolves this to a token from local memory only."
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "action": { "const": "issues.list" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["owner", "repo"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "repo": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["open", "closed", "all"], "default": "open" },
              "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
              "page": { "type": "integer", "minimum": 1, "default": 1 },
              "labels": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true
              },
              "since": {
                "type": "string",
                "format": "date-time",
                "description": "ISO-8601 timestamp; only issues updated after this are returned."
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "issues.create" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["owner", "repo", "title"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "repo": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1, "maxLength": 256 },
              "body": { "type": "string", "maxLength": 65536 },
              "labels": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true,
                "maxItems": 100
              },
              "assignees": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "uniqueItems": true,
                "maxItems": 50
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "prs.list" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["owner", "repo"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "repo": { "type": "string", "minLength": 1 },
              "state": { "type": "string", "enum": ["open", "closed", "all"], "default": "open" },
              "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
              "page": { "type": "integer", "minimum": 1, "default": 1 },
              "head": {
                "type": "string",
                "pattern": "^[^\\s]+$",
                "description": "Filter by head user/org and branch in the format user:ref-name or org:ref-name."
              },
              "base": { "type": "string", "minLength": 1, "description": "Filter by base branch name." },
              "sort": { "type": "string", "enum": ["created", "updated", "popularity", "long-running"], "default": "created" },
              "direction": { "type": "string", "enum": ["asc", "desc"], "default": "desc" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "prs.create" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["owner", "repo", "title", "head", "base"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "repo": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1, "maxLength": 256 },
              "body": { "type": "string", "maxLength": 65536 },
              "head": { "type": "string", "minLength": 1, "description": "The name of the branch where changes are implemented." },
              "base": { "type": "string", "minLength": 1, "description": "The name of the branch to merge changes into." },
              "draft": { "type": "boolean", "default": false },
              "maintainer_can_modify": { "type": "boolean", "default": false }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "action": { "const": "repos.list" } } },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "required": ["owner"],
            "additionalProperties": false,
            "properties": {
              "owner": { "type": "string", "minLength": 1 },
              "per_page": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 },
              "page": { "type": "integer", "minimum": 1, "default": 1 },
              "type": {
                "type": "string",
                "enum": ["all", "owner", "member"],
                "default": "owner",
                "description": "Filter by repository type."
              },
              "sort": {
                "type": "string",
                "enum": ["created", "updated", "pushed", "full_name"],
                "default": "full_name"
              },
              "direction": { "type": "string", "enum": ["asc", "desc"], "default": "asc" }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "ErrorEnvelope": {
      "type": "object",
      "required": ["ok", "error"],
      "additionalProperties": false,
      "properties": {
        "ok": { "type": "boolean", "const": false },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "validation_error",
                "action_not_found",
                "not_found",
                "conflict",
                "rate_limited",
                "auth_failed",
                "upstream_error",
                "internal_error"
              ]
            },
            "message": { "type": "string", "minLength": 1 },
            "request_id": { "type": "string", "minLength": 1 },
            "retryable": { "type": "boolean", "default": false },
            "details": {
              "type": "object",
              "description": "Optional machine-readable debug payload. Shape is not fixed by this contract."
            }
          }
        }
      }
    }
  }
}
